;;;
;;; AegisFilter Minifilter Driver Installation File
;;; Ultron Defender Security (AegisPC)
;;;

[Version]
Signature   = "$Windows NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d0f744-9971-4570-9a05-610f97f563ab}
Provider    = %ManufacturerName%
DriverVer   = 09/08/2026,3.5.0.0
CatalogFile = AegisFilter.cat

[DestinationDirs]
DefaultDestDir          = 12    ; %windir%\System32\drivers
AegisFilter.DriverFiles = 12

;;
;; Default install sections
;;

[DefaultInstall.NTamd64]
OptionDesc          = %ServiceDescription%
CopyFiles           = AegisFilter.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService          = %ServiceName%,,AegisFilter.Service

;;
;; Default uninstall sections
;;

[DefaultUninstall.NTamd64]
DelFiles            = AegisFilter.DriverFiles

[DefaultUninstall.NTamd64.Services]
DelService          = %ServiceName%,0x200      ; Ensure service is stopped before deleting

;;
;; Service installation section
;;

[AegisFilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys        ; %windir%\System32\drivers\AegisFilter.sys
Dependencies     = "FltMgr"
ServiceType      = 1                            ; SERVICE_KERNEL_DRIVER
StartType        = 3                            ; SERVICE_DEMAND_START (Servis tarafından dinamik başlatılır)
ErrorControl     = 1                            ; SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Anti-Virus"
AddReg           = AegisFilter.AddRegistry

;;
;; Registry Modifications
;;

[AegisFilter.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%DefaultInstance%,"Altitude",0x00000000,%Altitude%
HKR,"Instances\"%DefaultInstance%,"Flags",0x00010001,0x0

;;
;; Copy Files
;;

[AegisFilter.DriverFiles]
%DriverName%.sys

[SourceDisksFiles]
AegisFilter.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

;;
;; String Definitions
;;

[Strings]
ManufacturerName        = "Ultron Security Technologies"
ServiceDescription      = "Ultron Defender Real-Time Minifilter Driver"
ServiceName             = "AegisFilter"
DriverName              = "AegisFilter"
DiskId1                 = "Ultron Defender Installation Disk"
DefaultInstance         = "AegisFilter - Top Instance"
Altitude                = "320500"                  ; FSFilter Anti-Virus standard altitude range (320000 - 329999)
