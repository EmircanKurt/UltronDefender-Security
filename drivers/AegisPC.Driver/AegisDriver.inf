[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %Provider%
DriverVer   = 08/17/2026,1.0.0.0
CatalogFile = AegisDriver.cat

[DestinationDirs]
DefaultDestDir = 12
AegisDriver.DriverFiles = 12

[DefaultInstall]
OptionDesc = %ServiceDescription%
CopyFiles = AegisDriver.DriverFiles

[DefaultInstall.Services]
AddService = %ServiceName%,,AegisDriver.Service

[DefaultUninstall]
DelFiles = AegisDriver.DriverFiles

[DefaultUninstall.Services]
DelService = %ServiceName%,0x200

[AegisDriver.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %12%\AegisDriver.sys
Dependencies   = FltMgr
ServiceType    = 2    ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 3    ; SERVICE_DEMAND_START
ErrorControl   = 1    ; SERVICE_ERROR_NORMAL
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg         = AegisDriver.AddRegistry

[AegisDriver.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[AegisDriver.DriverFiles]
AegisDriver.sys

[Strings]
Provider          = "AegisPC Security"
ServiceName       = "AegisDriver"
ServiceDescription = "Aegis PC Security Kernel Driver"
DefaultInstance    = "AegisDriver Instance"
Instance1.Name     = "AegisDriver Instance"
Instance1.Altitude = "385100"
Instance1.Flags    = 0x0
