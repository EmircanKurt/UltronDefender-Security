<ui:FluentWindow x:Class="AegisPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AegisPC.App"
        xmlns:views="clr-namespace:AegisPC.App.Views"
        Title="Ultron Defender Total Security (Antivirüs Programı)" Height="880" Width="1300"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Background="{DynamicResource BrushAppBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
        
    <Grid Background="{DynamicResource BrushAppBg}" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top App Title Bar with Dynamic Theme Support -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Ultron Defender Total Security (Antivirüs Programı)" 
                     Foreground="{DynamicResource BrushTextPrimary}" 
                     Background="{DynamicResource BrushAppBg}"
                     FontSize="14.5"
                     FontWeight="Bold"
                     Height="40"
                     Padding="6,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/ultron_logo.png" Width="20" Height="20" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Body: 2 Columns with Dynamic Theme-Adaptive Left Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- THEME ADAPTIVE BACKGROUND FOR LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushSidebarBorder}" BorderThickness="0,0,1,0"/>

            <!-- Main Shell Navigation -->
            <ui:NavigationView Grid.ColumnSpan="2" x:Name="RootNavigation" 
                               PaneDisplayMode="Left" 
                               OpenPaneLength="260"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               HeaderVisibility="Collapsed"
                               IsPaneOpen="True"
                               Background="Transparent">

                <ui:NavigationView.Resources>
                    <!-- Force Left Pane Background to Transparent to inherit Sidebar Background -->
                    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                    
                    <Style TargetType="{x:Type ui:NavigationViewItem}">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Margin" Value="8,2,8,2"/>
                    </Style>

                    <Style TargetType="{x:Type ui:NavigationViewItemHeader}">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Margin" Value="16,14,0,4"/>
                    </Style>
                </ui:NavigationView.Resources>
                
                <!-- Sidebar Pane Header with Brand Logo & Badge -->
                <ui:NavigationView.PaneHeader>
                    <Border Padding="18,16,18,16" Margin="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushSidebarBorder}" Background="{DynamicResource BrushSidebarHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/Resources/Images/ultron_logo.png" 
                                   Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ULTRON" FontFamily="{StaticResource FontBrand}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                <Border Background="{DynamicResource BrushBrandPrimary}" CornerRadius="3" Padding="6,1.5" Margin="0,2,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="TOTAL SECURITY" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ui:NavigationView.PaneHeader>
                
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Kontrol Paneli" TargetPageType="{x:Type views:DashboardView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Virüs Taraması" TargetPageType="{x:Type views:ScanView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Shield24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Fidye Kalkanı" TargetPageType="{x:Type views:RansomwareShieldView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Ağ ve Web Koruması" TargetPageType="{x:Type views:NetworkProtectionView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Karantina Kasası" TargetPageType="{x:Type views:QuarantineView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Tehdit &amp; Olay Merkezi" TargetPageType="{x:Type views:IncidentCenterView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="AlertBadge24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="SİSTEM &amp; ANALİZ" />

                    <ui:NavigationViewItem Content="Performans &amp; Donanım" TargetPageType="{x:Type views:PerformanceView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Süreç Yöneticisi" TargetPageType="{x:Type views:ProcessListView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="TasklistSquareRtl24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Başlangıç Yöneticisi" TargetPageType="{x:Type views:StartupManagerView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Play24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Tarayıcı Güvenliği" TargetPageType="{x:Type views:BrowserSecurityView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="WindowShield24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Ebeveyn Denetimi" TargetPageType="{x:Type views:ParentalControlsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="PersonFeedback24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Çökme &amp; Olay Analizi" TargetPageType="{x:Type views:CrashAnalysisView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Güvenlik Geçmişi" TargetPageType="{x:Type views:HistoryView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <!-- License / Protection Tier Badge Card -->
                    <Border Margin="12,4,12,8" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{DynamicResource BrushStatusSafeBg}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PRO LİSANS" FontSize="10.5" FontWeight="Black" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <Border Background="{DynamicResource BrushStatusSafe}" CornerRadius="3" Padding="4,1" Margin="5,0,0,0">
                                        <TextBlock Text="AKTİF" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="365 Gün Kaldı (18.08.2027)" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ui:NavigationViewItem x:Name="NavThemeToggle" Content="Gece Modu" Click="OnThemeToggleClicked">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon x:Name="NavThemeIcon" Symbol="WeatherMoon24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Ayarlar" TargetPageType="{x:Type views:SettingsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Grid>
    </Grid>
</ui:FluentWindow>
