<ui:FluentWindow x:Class="AegisPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AegisPC.App"
        xmlns:views="clr-namespace:AegisPC.App.Views"
        Title="Ultron Defender Total Security (Antivirüs Programı)" Height="880" Width="1300"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Resources/Images/ultron_logo.png"
        Background="#EEF2F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
        
    <Grid Background="#EEF2F6" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top App Title Bar with Crystal Clear Dark Control Buttons & Enhanced Typography -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Ultron Defender Total Security (Antivirüs Programı)" 
                     Foreground="#0F172A" 
                     Background="#EEF2F6"
                     FontSize="14.5"
                     FontWeight="Bold"
                     Height="40"
                     Padding="6,0,0,0">
            <ui:TitleBar.Resources>
                <SolidColorBrush x:Key="TitleBarButtonForeground" Color="#0F172A"/>
                <SolidColorBrush x:Key="TitleBarButtonPointerOverForeground" Color="#0F172A"/>
                <SolidColorBrush x:Key="TitleBarButtonPointerOverBackground" Color="#E2E8F0"/>
                <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="#0F172A"/>
                <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="#CBD5E1"/>
                <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverBackground" Color="#DC2626"/>
                <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverForeground" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TitleBarCloseButtonPressedBackground" Color="#B91C1C"/>
                <SolidColorBrush x:Key="TitleBarCloseButtonPressedForeground" Color="#FFFFFF"/>
            </ui:TitleBar.Resources>
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/ultron_logo.png" Width="20" Height="20" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Body: 2 Columns with Executive Cyber Obsidian Sidebar & Soft Pearl Canvas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOLID OBSIDIAN #0A0F1D BACKGROUND FOR LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,1,0"/>

            <!-- Main Shell Navigation -->
            <ui:NavigationView Grid.ColumnSpan="2" x:Name="RootNavigation" 
                               PaneDisplayMode="Left" 
                               OpenPaneLength="260"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               HeaderVisibility="Collapsed"
                               IsPaneOpen="True"
                               Background="Transparent">

                <ui:NavigationView.Resources>
                    <!-- Force Left Pane Background to Transparent to inherit Obsidian #0A0F1D -->
                    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#EEF2F6"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="#EEF2F6"/>
                    
                    <!-- Left Pane Menu Items Typography & Colors -->
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#475569"/>
                    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#64748B"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#94A3B8"/>

                    <!-- Item Hover & Selection State Colors -->
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1E293B"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#334155"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2563EB"/>
                    <SolidColorBrush x:Key="NavigationViewItemSelectedBackground" Color="#2563EB"/>

                    <Style TargetType="{x:Type ui:NavigationViewItem}">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Margin" Value="8,2,8,2"/>
                    </Style>

                    <Style TargetType="{x:Type ui:NavigationViewItemHeader}">
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Margin" Value="16,14,0,4"/>
                    </Style>
                </ui:NavigationView.Resources>
                
                <!-- Sidebar Pane Header with Polished Brand Logo & Badge -->
                <ui:NavigationView.PaneHeader>
                    <Border Padding="18,16,18,16" Margin="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="#1E293B" Background="#0F172A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/Resources/Images/ultron_logo.png" 
                                   Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ULTRON" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                                <Border Background="#2563EB" CornerRadius="3" Padding="6,1.5" Margin="0,3,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="TOTAL SECURITY" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ui:NavigationView.PaneHeader>
                
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Kontrol Paneli" TargetPageType="{x:Type views:DashboardView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Virüs Taraması" TargetPageType="{x:Type views:ScanView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Shield24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Fidye Kalkanı" TargetPageType="{x:Type views:RansomwareShieldView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Ağ ve Web Koruması" TargetPageType="{x:Type views:NetworkProtectionView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Karantina Kasası" TargetPageType="{x:Type views:QuarantineView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Tehdit &amp; Olay Merkezi" TargetPageType="{x:Type views:IncidentCenterView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="AlertBadge24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemHeader Text="SİSTEM &amp; ANALİZ" />

                    <ui:NavigationViewItem Content="Performans &amp; Donanım" TargetPageType="{x:Type views:PerformanceView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Süreç Yöneticisi" TargetPageType="{x:Type views:ProcessListView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="TasklistSquareRtl24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Başlangıç Yöneticisi" TargetPageType="{x:Type views:StartupManagerView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Play24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Tarayıcı Güvenliği" TargetPageType="{x:Type views:BrowserSecurityView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="WindowShield24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Ebeveyn Denetimi" TargetPageType="{x:Type views:ParentalControlsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="PersonFeedback24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Çökme &amp; Olay Analizi" TargetPageType="{x:Type views:CrashAnalysisView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Güvenlik Geçmişi" TargetPageType="{x:Type views:HistoryView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Ayarlar" TargetPageType="{x:Type views:SettingsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Grid>
    </Grid>
</ui:FluentWindow>
