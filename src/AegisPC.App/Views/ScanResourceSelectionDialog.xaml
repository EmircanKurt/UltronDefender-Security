<Window x:Class="AegisPC.App.Views.ScanResourceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tarama Kaynak Kullanımı"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <Border Background="{DynamicResource BrushCardBg}"
            BorderBrush="{DynamicResource BrushCardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- 1. Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                        Background="{DynamicResource BrushBrandSubtle}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Tarama Kaynak Kullanımı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtSystemRamInfo" Text="Sisteminize en uygun performans profilini seçin:" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Width="28" Height="28" Padding="0" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnCancelClicked">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource BrushTextMuted}"/>
                </Button>
            </Grid>

            <!-- 2. Options -->
            <StackPanel Margin="0,4,0,14">
                <!-- Option 1: Sakin -->
                <Border x:Name="BorderLow" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="OnSelectLow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbLow" Grid.Column="0" GroupName="ResourceMode" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnRadioClicked"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🌱 Sakin" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtLowDesc" Text="~1 GB RAM, düşük CPU • Günlük işlerinizi kesintiye uğratmaz" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Option 2: Dengeli (Default) -->
                <Border x:Name="BorderBalanced" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushBrandPrimary}"
                        BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="OnSelectBalanced">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbBalanced" Grid.Column="0" GroupName="ResourceMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnRadioClicked"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="⚖️ Dengeli (Önerilen)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtBalancedDesc" Text="RAM'in yarısı • Hızlı ve sistem yanıtını koruyan dengeli tarama" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Option 3: Tam Güç -->
                <Border x:Name="BorderMaximum" Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="OnSelectMaximum">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbMaximum" Grid.Column="0" GroupName="ResourceMode" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnRadioClicked"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🚀 Tam Güç" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtMaximumDesc" Text="Tüm çekirdekler ve derin I/O paralelliği • En hızlı tarama performansı" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Remember Choice Checkbox -->
            <CheckBox x:Name="ChkRemember" Content="Tercihimi hatırla, bir daha sorma"
                      Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="4,0,0,20"/>

            <!-- 4. Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="İptal" Width="100" Height="34" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryActionButtonStyle}" Click="OnCancelClicked"/>
                <Button Grid.Column="2" Content="Taramayı Başlat" Width="135" Height="34"
                        Style="{StaticResource PrimaryActionButtonStyle}" Click="OnStartClicked"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
