<Page x:Class="AegisPC.App.Views.ParentalControlsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ebeveyn Denetimi"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Ebeveyn Denetimi" Margin="0,0,0,2"/>
                <TextBlock Text="Bu özellik geliştirme aşamasındadır." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- 2. Coming Soon Content -->
            <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldLock24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="64" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Yakında Gelecek" Style="{StaticResource PageHeadingStyle}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Çocuklarınız için güvenli bir dijital ortam sağlayan web erişimi filtreleme, zararlı uygulama kısıtlama ve ekran süresi yönetimi özellikleri çok yakında kullanımınıza sunulacaktır." 
                               Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
