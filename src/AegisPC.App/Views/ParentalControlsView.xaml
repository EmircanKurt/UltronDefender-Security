<Page x:Class="AegisPC.App.Views.ParentalControlsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ebeveyn Denetimi"
      Background="#EEF2F6"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Ebeveyn Denetimi" Margin="0,0,0,2"/>
            <TextBlock Text="Bu özellik geliştirme aşamasındadır." FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- Coming Soon Content -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0EBEA" BorderThickness="1" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ShieldLock24" Foreground="#2563EB" FontSize="64" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                <TextBlock Text="Yakında Gelecek" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Çocuklarınız için güvenli bir dijital ortam sağlayan web erişimi, uygulama kısıtlama ve ekran süresi yönetimi özellikleri çok yakında kullanımınıza sunulacaktır." 
                           Foreground="#475569" FontSize="14" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
