<Page x:Class="AegisPC.App.Views.RansomwareShieldView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AegisPC.App.Views"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:AegisPC.App.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1100"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel"
      Title="Fidye Yazılımı Kalkanı">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="28,20,28,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Fidye Yazılımı Savunma Sistemi (Ransomware Defense)" Style="{StaticResource PageHeadingStyle}"/>
                <TextBlock Text="Controlled Folder Access, Canary tuzak dosyaları, kitle modifikasyon ve anlık entropi analizi." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Status Banner Card -->
            <Border Grid.Row="1" Style="{StaticResource HeroCardStyle}" Margin="0,0,0,20" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="ShieldLock24" FontSize="36" Foreground="{DynamicResource BrushStatusWarning}"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShieldStatusText}" Style="{StaticResource SectionHeadingStyle}" FontSize="17" Margin="0,0,0,4"/>
                        <TextBlock Text="Kişisel dosyalarınız ve belgeleriniz izinsiz şifreleme girişimlerine karşı 7/24 korunmaktadır." Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding ToggleButtonText}" Command="{Binding ToggleShieldCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Padding="20,10"/>
                </Grid>
            </Border>

            <!-- 3. Stats Metric Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Korumalı Klasör Sayısı" Style="{StaticResource CaptionTextStyle}" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ProtectedFolderCount}" Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Aktif Canary Yem Tuzakları" Style="{StaticResource CaptionTextStyle}" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CanaryFileCount}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource BrushStatusWarning}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Engellenen Saldırılar" Style="{StaticResource CaptionTextStyle}" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalBlockedCount}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource BrushStatusDanger}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Main Sections Grid (Folders + Allowed Apps) -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Protected Folders Section -->
                <Border Grid.Column="0" Style="{StaticResource FeatureCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Korumalı Klasörler (Controlled Folders)" Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Bu klasörlerdeki dosyalara yalnızca güvenilir uygulamalar yazabilir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding ProtectedFolders}" BorderThickness="0" Background="Transparent" MinHeight="160" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushAppBg}" CornerRadius="8" Padding="10,8" Margin="0,3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="20" Grid.Column="0" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Kaldır" Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource BrushStatusDanger}" BorderThickness="0" Padding="6,2" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Content="+ Yeni Klasör Ekle" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="0,8"/>
                    </Grid>
                </Border>

                <!-- Allowed Applications Section -->
                <Border Grid.Column="2" Style="{StaticResource FeatureCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="İzinli Uygulamalar (Allowlist)" Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Korunan klasörlerde güvenle yazma işlemi yapabilen uygulamalar." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding AllowedApplications}" BorderThickness="0" Background="Transparent" MinHeight="160" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushAppBg}" CornerRadius="8" Padding="10,8" Margin="0,3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="AppGeneric24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="20" Grid.Column="0" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Kaldır" Command="{Binding DataContext.RemoveAllowedAppCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource BrushStatusDanger}" BorderThickness="0" Padding="6,2" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Content="+ Güvenilir Uygulama Ekle (.exe)" Command="{Binding AddAllowedAppCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="0,8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. Recent Security Events Section (Strict Crimson Red Theme) -->
            <Border Grid.Row="4" Style="{StaticResource MetricCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Son Fidye Saldırısı ve İhlal Kayıtları" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,12"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding RecentEvents}" BorderThickness="0" Background="Transparent" MinHeight="100">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushStatusDangerBg}" CornerRadius="8" Padding="12,10" Margin="0,3" BorderBrush="{DynamicResource BrushStatusDangerBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="ShieldDismiss24" Foreground="{DynamicResource BrushStatusDanger}" FontSize="24" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushStatusDangerText}"/>
                                            <TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushStatusDanger}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
