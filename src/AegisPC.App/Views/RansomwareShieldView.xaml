<Page x:Class="AegisPC.App.Views.RansomwareShieldView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AegisPC.App.Views"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:AegisPC.App.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1100"
      Background="#EEF2F6"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel"
      Title="Fidye Yazılımı Kalkanı">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Fidye Yazılımı Savunma Sistemi (Ransomware Defense)" Style="{StaticResource PageHeaderStyle}"/>
                <TextBlock Text="Controlled Folder Access, Canary tuzak dosyaları, kitle modifikasyon ve anlık entropi analizi." Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Banner Card -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="20" Margin="0,0,0,20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="ShieldLock24" FontSize="36" Foreground="#2563EB"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShieldStatusText}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Kişisel dosyalarınız ve belgeleriniz izinsiz şifreleme girişimlerine karşı 7/24 korunmaktadır." Foreground="#64748B" FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding ToggleButtonText}" Command="{Binding ToggleShieldCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Padding="20,10" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Stats Metric Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Korumalı Klasör Sayısı" FontSize="13" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ProtectedFolderCount}" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Aktif Canary Yem Tuzakları" FontSize="13" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CanaryFileCount}" FontSize="26" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Engellenen Saldırılar" FontSize="13" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalBlockedCount}" FontSize="26" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Sections Grid (Folders + Allowed Apps) -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Protected Folders Section -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Korumalı Klasörler (Controlled Folders)" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Bu klasörlerdeki dosyalara yalnızca güvenilir uygulamalar yazabilir." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding ProtectedFolders}" BorderThickness="0" Background="Transparent" MinHeight="160" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,3" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Folder24" Foreground="#2563EB" FontSize="20" Grid.Column="0" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Kaldır" Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Padding="6,2" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Content="+ Yeni Klasör Ekle" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="0,8" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Allowed Applications Section -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="İzinli Uygulamalar (Allowlist)" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Korunan klasörlerde güvenle yazma işlemi yapabilen uygulamalar." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding AllowedApplications}" BorderThickness="0" Background="Transparent" MinHeight="160" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,3" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="AppGeneric24" Foreground="#10B981" FontSize="20" Grid.Column="0" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Kaldır" Command="{Binding DataContext.RemoveAllowedAppCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Padding="6,2" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Content="+ Güvenilir Uygulama Ekle (.exe)" Command="{Binding AddAllowedAppCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="0,8" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Recent Security Events Section -->
            <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Son Fidye Saldırısı ve İhlal Kayıtları" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding RecentEvents}" BorderThickness="0" Background="Transparent" MinHeight="100">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FEF2F2" CornerRadius="6" Padding="12,10" Margin="0,3" BorderBrush="#FCA5A5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="ShieldError20" Foreground="#DC2626" FontSize="24" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="13" Foreground="#991B1B"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
