<Page x:Class="AegisPC.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SecurityStatusToColorConverter x:Key="StatusToColor"/>

        <!-- Modern Card Style -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.08" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Module Feature Card Style -->
        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Robust Action Button Styles -->
        <Style x:Key="DangerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,24,32,32">

            <!-- ══════════════════════════════════════════════════════
                 1. DYNAMIC HERO STATUS BANNER (Güvendesiniz / Tehdit Durumu)
            ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,22" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dynamic Status Shield -->
                    <Grid Grid.Column="0" Width="76" Height="76" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Ellipse Width="76" Height="76" 
                                 Fill="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Fill}" 
                                 Stroke="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}" 
                                 StrokeThickness="2.5"/>
                        <ui:SymbolIcon Symbol="{Binding ProtectionStatusSymbol, FallbackValue='ShieldCheckmark24'}" FontSize="36" 
                                       Foreground="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ULTRON DEFENDER TOTAL SECURITY" FontSize="11" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,10,0"/>
                            <Border Background="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Fill}" 
                                    BorderBrush="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}" 
                                    BorderThickness="1" CornerRadius="8" Padding="6,2">
                                <TextBlock Text="{Binding ProtectionBadgeText, FallbackValue='● KORUMA AKTİF'}" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ProtectionStatusText, FallbackValue='GÜVENDESİNİZ'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gerçek zamanlı koruma devrede. Dosya sisteminiz, indirmeleriniz ve bellek arka planda sürekli korunuyor." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>

                    <!-- Primary Action Buttons -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Direct Review Threats Action when threats exist -->
                        <Button Style="{StaticResource DangerActionButtonStyle}" Content="{Binding ThreatActionText, FallbackValue='🚨 Tehditleri İncele'}" 
                                Command="{Binding ReviewThreatsCommand}" Margin="0,0,0,6" MinWidth="160"
                                Visibility="{Binding HasThreatsDetected, Converter={StaticResource BoolToVis}}"/>

                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="⚡ Hızlı Tarama Başlat" 
                                Command="{Binding StartQuickScanCommand}" Margin="0,0,0,6" MinWidth="160"
                                Visibility="{Binding HasThreatsDetected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                        <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="{Binding ThemeButtonText, FallbackValue='🌙 Gece Modu'}" 
                                Command="{Binding ToggleThemeCommand}" Margin="0,0,0,6" MinWidth="160"/>
                        <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="🛡️ Korumayı Yönet" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="security" MinWidth="160"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 2. FOUR CORE MODULE TILES (Sade & Modern 4 Modül Kartı)
            ══════════════════════════════════════════════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,22">
                <!-- Tile 1: Virus Scanner -->
                <Border Style="{StaticResource ModuleCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Shield24" Foreground="#0284C7" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Virüs Taraması" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Animasyonlu tarayıcı penceresi ile hızlı, tam veya özel dosya analizi." Foreground="{DynamicResource BrushTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Grid.Row="2" Content="Taramayı Başlat" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding StartQuickScanCommand}" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11.5"/>
                    </Grid>
                </Border>

                <!-- Tile 2: Real-Time Shield -->
                <Border Style="{StaticResource ModuleCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="#10B981" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Gerçek Zamanlı Kalkan" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="İndirmeleri, USB ve geçici dizinleri anında denetler." Foreground="{DynamicResource BrushTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Grid.Row="2" Content="Durumu İncele" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="security" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11.5"/>
                    </Grid>
                </Border>

                <!-- Tile 3: Ransomware Protection -->
                <Border Style="{StaticResource ModuleCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="LockClosed24" Foreground="#D97706" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Fidye Kalkanı" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Belgelerim ve resimlerinizi şifreleme girişimlerine karşı korur." Foreground="{DynamicResource BrushTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Grid.Row="2" Content="Klasör Koruması" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="ransomware" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11.5"/>
                    </Grid>
                </Border>

                <!-- Tile 4: Quarantine Vault -->
                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Archive24" Foreground="#8B5CF6" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Karantina Kasası" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Yalıtılmış ve AES-256 ile şifrelenmiş şüpheli dosyalar." Foreground="{DynamicResource BrushTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Grid.Row="2" Content="Kasayı Aç" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="quarantine" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11.5"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════
                 3. COMPACT LIVE SECURITY TELEMETRY STREAM (Sade Canlı Akış)
            ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Canlı Güvenlik Akışı" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Arka planda taranan ve korunan son olaylar" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#166534" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:1.0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="CANLI İZLEME" FontSize="10" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Events Table -->
                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding LiveActivities}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  MaxHeight="200"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ZAMAN" Binding="{Binding TimestampFormatted}" Width="75"/>
                                <DataGridTextColumn Header="DOSYA / HEDEF" Binding="{Binding FileName}" Width="160"/>
                                <DataGridTextColumn Header="DİZİN &amp; AŞAMA" Binding="{Binding StageDetails}" Width="*"/>
                                <DataGridTextColumn Header="RİSK" Binding="{Binding ScoreBadge}" Width="70"/>
                                <DataGridTextColumn Header="MÜDAHALE" Binding="{Binding ActionTaken}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
