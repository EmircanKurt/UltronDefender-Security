<Page x:Class="AegisPC.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SecurityStatusToColorConverter x:Key="StatusToColor"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
            <StackPanel MaxWidth="880" HorizontalAlignment="Center" Margin="0,48,0,32">

                <!-- ═══════════════════════════════════════════════════════════
                     1. CENTERED HERO: MINIMALIST STATUS
                     ═══════════════════════════════════════════════════════════ -->
                <StackPanel HorizontalAlignment="Center">
                    <!-- ═══ INTERACTIVE CODEX BLUE CLOUD TERMINAL LOGO ═══ -->
                    <!-- Hover lift/float animation + Idle blinking cursor ("gözü o satır çizgisi gidip gelsin") -->
                    <Grid Width="64" Height="58" HorizontalAlignment="Center" Margin="0,0,0,16"
                          Cursor="Hand" RenderTransformOrigin="0.5,0.5" ToolTip="Ultron Terminal Koruma Çekirdeği">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="CloudLogoTranslate" Y="0"/>
                                <ScaleTransform x:Name="CloudLogoScale" ScaleX="1.0" ScaleY="1.0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Ambient Aura (Mavi ışıma sadece koyu temada, açık temada şeffaf) -->
                        <Ellipse Width="54" Height="46" Fill="{DynamicResource BrushCloudAura}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="16"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Cloud Base Silhouette & Prompt (Koyu temada Canlı Codex Mavisi, Açık temada Simsiyah) -->
                        <Image Source="{DynamicResource ImageCloudLogoBase}"
                               Width="58" Height="52" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="12" Color="{DynamicResource ColorCloudGlow}" ShadowDepth="0" Opacity="0.75"/>
                            </Image.Effect>
                        </Image>

                        <!-- Blinking Cursor Line _ (Koyu temada Mavi, Açık temada Simsiyah) -->
                        <Image x:Name="CodexCursorLine"
                               Source="{DynamicResource ImageCloudCursorLine}"
                               Width="58" Height="52" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="10" Color="{DynamicResource ColorCloudCursorGlow}" ShadowDepth="0" Opacity="0.9"/>
                            </Image.Effect>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.0"/>
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.0"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>

                        <!-- Hover Float/Lift Interaction ("üzerine gelince hareket etsin") -->
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoTranslate"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-6" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.08" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.08" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoTranslate"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CloudLogoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <TextBlock Text="{Binding ProtectionStatusText, FallbackValue='Sisteminiz güvende'}" Style="{StaticResource HeroTitleStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="Ultron Defender ile sisteminiz tam koruma altında. İndirmeler, süreçler ve bellek sürekli denetleniyor."
                               Style="{StaticResource HeroSubtitleStyle}"/>

                    <!-- Threat Alert Banner (Only visible if threats detected) -->
                    <Border Margin="0,14,0,0" HorizontalAlignment="Center"
                            Background="{DynamicResource BrushStatusDangerBg}"
                            BorderBrush="{DynamicResource BrushStatusDangerBorder}"
                            BorderThickness="1" CornerRadius="16" Padding="14,6"
                            Visibility="{Binding HasThreatsDetected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource BrushStatusDanger}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProtectionBadgeText}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushStatusDanger}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource DangerButtonStyle}" Content="{Binding ThreatActionText, FallbackValue='Tehditleri İncele'}"
                                    Command="{Binding ReviewThreatsCommand}" Padding="10,2" Margin="10,0,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     2. CODEX-INSPIRED 4 HORIZONTAL ACTION CARDS
                     ═══════════════════════════════════════════════════════════ -->
                <UniformGrid Columns="4" Margin="0,32,0,0">
                    <!-- Action Card 1: Quick Scan (Pastel Blue) -->
                    <Button Style="{StaticResource ActionCardButtonStyle}"
                            Command="{Binding StartQuickScanCommand}"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Top-Left Pastel Icon Badge -->
                            <Border Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushPastelBlueBg}"
                                    BorderBrush="{DynamicResource BrushPastelBlueBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Search24" FontSize="16"
                                               Foreground="{DynamicResource BrushPastelBlueIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Hızlı Tarama Başlat"
                                       Style="{StaticResource ActionCardTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Kritik sistem dizinlerini, belleği ve başlangıç dosyalarını tara"
                                       Style="{StaticResource ActionCardDescStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Action Card 2: Full System Scan (Pastel Purple) -->
                    <Button Style="{StaticResource ActionCardButtonStyle}"
                            Command="{Binding NavigateToTargetCommand}"
                            CommandParameter="scan"
                            Margin="4,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Top-Left Pastel Icon Badge -->
                            <Border Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushPastelPurpleBg}"
                                    BorderBrush="{DynamicResource BrushPastelPurpleBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="16"
                                               Foreground="{DynamicResource BrushPastelPurpleIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Tam Sistem Taraması"
                                       Style="{StaticResource ActionCardTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Tüm yerel diskleri, arşivleri ve derin sistem dosyalarını analiz et"
                                       Style="{StaticResource ActionCardDescStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Action Card 3: Real-Time Shields (Pastel Green) -->
                    <Button Style="{StaticResource ActionCardButtonStyle}"
                            Command="{Binding NavigateToTargetCommand}"
                            CommandParameter="settings"
                            Margin="4,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Top-Left Pastel Icon Badge -->
                            <Border Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushPastelGreenBg}"
                                    BorderBrush="{DynamicResource BrushPastelGreenBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16"
                                               Foreground="{DynamicResource BrushPastelGreenIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Gerçek Zamanlı Kalkanlar"
                                       Style="{StaticResource ActionCardTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="ETW, indirme kalkanı ve bellek koruma durumunu denetle"
                                       Style="{StaticResource ActionCardDescStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Action Card 4: Threats & EDR Incident Center (Pastel Orange) -->
                    <Button Style="{StaticResource ActionCardButtonStyle}"
                            Command="{Binding ReviewThreatsCommand}"
                            Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Top-Left Pastel Icon Badge -->
                            <Border Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushPastelOrangeBg}"
                                    BorderBrush="{DynamicResource BrushPastelOrangeBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="16"
                                               Foreground="{DynamicResource BrushPastelOrangeIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Tehdit &amp; Olay Geçmişi"
                                       Style="{StaticResource ActionCardTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Karantinaya alınan zararlıları ve EDR güvenlik kayıtlarını incele"
                                       Style="{StaticResource ActionCardDescStyle}"/>
                        </Grid>
                    </Button>
                </UniformGrid>

                <!-- ═══════════════════════════════════════════════════════════
                     3. CODEX-INSPIRED ROUNDED PILL STATUS DOCK
                     ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource PillDockContainerStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Scanned Today -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bugün taranan:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FilesScannedCount, StringFormat='{}{0:N0}'}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" dosya" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- Vertical Divider 1 -->
                        <Rectangle Grid.Column="1" Width="1" Height="20" Fill="{DynamicResource BrushCardBorder}" Margin="8,0"/>

                        <!-- Metric 2: Signature Update -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="İmza:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding LastDatabaseUpdateFormatted}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Vertical Divider 2 -->
                        <Rectangle Grid.Column="3" Width="1" Height="20" Fill="{DynamicResource BrushCardBorder}" Margin="8,0"/>

                        <!-- Metric 3: Protection Uptime -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Koruma:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ProtectionUptimeText}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Vertical Divider 3 -->
                        <Rectangle Grid.Column="5" Width="1" Height="20" Fill="{DynamicResource BrushCardBorder}" Margin="8,0"/>

                        <!-- Metric 4: Ransomware Shield Quick Controls -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fidye Kalkanı:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Ellipse Width="6" Height="6" Fill="{Binding RansomwareStatusColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding RansomwareStatusText}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Ayarlar" Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding OpenRansomwareSettingsCommand}" Padding="8,2" FontSize="11" Margin="0,0,6,0"/>
                            <ui:ToggleSwitch IsChecked="{Binding IsRansomwareEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     4. LIVE ACTIVITY TELEMETRY TABLE (Airy rows)
                     ═══════════════════════════════════════════════════════════ -->
                <StackPanel Margin="0,36,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Son Güvenlik Olayları" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="— arka planda korunan süreç ve dosya işlemleri" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStatusSafeDark}" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:1.0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="Canlı" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushStatusSafeText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="LiveActivitiesGrid"
                              ItemsSource="{Binding LiveActivities}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}"
                              HeadersVisibility="Column"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="OnDataGridPreviewMouseWheel"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Zaman" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimestampFormatted}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" VerticalAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Dosya / Hedef" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource DataTableStyle}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" VerticalAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Aşama" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StageDetails}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding StageDetails}" VerticalAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Risk" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ScoreBadge}" Style="{StaticResource DataTableStyle}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Müdahale" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionTaken}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionTaken}" VerticalAlignment="Center" Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
