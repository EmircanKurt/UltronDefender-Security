<Page x:Class="AegisPC.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:AegisPC.App.Helpers"
    xmlns:controls="clr-namespace:AegisPC.App.Controls"
    Title="Genel bakış" Background="{DynamicResource BrushAppBg}"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer x:Name="RootScrollViewer" helpers:WheelScrollHelper.EnableRootRedirect="True"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False" Focusable="False" Padding="28,28,28,24">
        <controls:PlainDashboardSurface MaxWidth="1050" HorizontalAlignment="Stretch"/>
    </ScrollViewer>
</Page>
