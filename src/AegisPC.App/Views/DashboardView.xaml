<Page x:Class="AegisPC.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SecurityStatusToColorConverter x:Key="StatusToColor"/>

        <!-- Module Feature Card Style -->
        <Style x:Key="ModuleCardStyle" TargetType="Border" BasedOn="{StaticResource MetricCardStyle}">
            <Setter Property="Padding" Value="20,18,20,18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,20,32,28">

            <!-- ══════════════════════════════════════════════════════
                 1. DYNAMIC HERO STATUS BANNER (Güvendesiniz / Tehdit Durumu)
            ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dynamic Status Shield -->
                    <Grid Grid.Column="0" Width="76" Height="76" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Ellipse Width="76" Height="76" 
                                 Fill="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Fill}" 
                                 Stroke="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}" 
                                 StrokeThickness="2.5"/>
                        <ui:SymbolIcon Symbol="{Binding ProtectionStatusSymbol, FallbackValue='ShieldCheckmark24'}" FontSize="36" 
                                       Foreground="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ULTRON DEFENDER TOTAL SECURITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}" Margin="0,0,10,0"/>
                            <Border Background="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Fill}" 
                                    BorderBrush="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}" 
                                    BorderThickness="1" CornerRadius="8" Padding="6,2">
                                <TextBlock Text="{Binding ProtectionBadgeText, FallbackValue='● KORUMA AKTİF'}" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding ProtectionStatusColor, Converter={StaticResource StatusToColor}, ConverterParameter=Stroke}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ProtectionStatusText, FallbackValue='GÜVENDESİNİZ'}" Style="{StaticResource StatusHeadlineStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gerçek zamanlı koruma devrede. Dosya sisteminiz, indirmeleriniz ve bellek arka planda sürekli korunuyor." Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>

                    <!-- Primary Action Buttons -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Direct Review Threats Action when threats exist (Crimson Red Danger Button) -->
                        <Button Style="{StaticResource DangerActionButtonStyle}" Content="{Binding ThreatActionText, FallbackValue='🚨 Tehditleri İncele'}" 
                                Command="{Binding ReviewThreatsCommand}" Margin="0,0,0,6" MinWidth="160"
                                Visibility="{Binding HasThreatsDetected, Converter={StaticResource BoolToVis}}"/>

                        <!-- Standard Quick Scan Action (Brand Orange Primary Button) -->
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="⚡ Hızlı Tarama Başlat" 
                                Command="{Binding StartQuickScanCommand}" Margin="0,0,0,6" MinWidth="160"
                                Visibility="{Binding HasThreatsDetected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                        <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="{Binding ThemeButtonText, FallbackValue='🌙 Gece Modu'}" 
                                Command="{Binding ToggleThemeCommand}" Margin="0,0,0,6" MinWidth="160"/>
                        <Button Style="{StaticResource SecondaryActionButtonStyle}" Content="🛡️ Korumayı Yönet" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="security" MinWidth="160"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 2. FOUR CORE ACTION MODULE TILES (Büyütülmüş & Öne Çıkarılmış Kartlar)
            ══════════════════════════════════════════════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Tile 1: Virus Scanner (Blue Accent) -->
                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Colored Icon Box -->
                        <Border Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="12"
                                Background="{DynamicResource BrushStatusInfoBg}" BorderBrush="{DynamicResource BrushStatusInfoBorder}" BorderThickness="1.5" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Virüs Taraması" Style="{StaticResource SectionHeadingStyle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Text="Hızlı, tam veya özel dosya analizi ile sisteminizi derinlemesine tarayın." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <!-- Action Button -->
                        <Button Grid.Row="3" Content="Taramayı Başlat" Style="{StaticResource PrimaryActionButtonStyle}" 
                                Command="{Binding StartQuickScanCommand}" HorizontalAlignment="Stretch" Padding="0,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Tile 2: Real-Time Shield (Green Accent) -->
                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Colored Icon Box -->
                        <Border Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="12"
                                Background="{DynamicResource BrushStatusSafeBg}" BorderBrush="{DynamicResource BrushStatusSafeBorder}" BorderThickness="1.5" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Gerçek Zamanlı Kalkan" Style="{StaticResource SectionHeadingStyle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Text="İndirmeleri, harici USB diskleri ve bellek süreçlerini anlık denetler." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <!-- Action Button -->
                        <Button Grid.Row="3" Content="Durumu İncele" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="security" HorizontalAlignment="Stretch" Padding="0,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Tile 3: Ransomware Protection (Orange Accent) -->
                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Colored Icon Box -->
                        <Border Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="12"
                                Background="{DynamicResource BrushBrandSubtle}" BorderBrush="{DynamicResource BrushBrandFocusRing}" BorderThickness="1.5" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Fidye Kalkanı" Style="{StaticResource SectionHeadingStyle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Text="Belgelerim ve resimlerinizi fidye yazılımlarının şifreleme girişimine karşı kilitler." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <!-- Action Button -->
                        <Button Grid.Row="3" Content="Klasör Koruması" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="ransomware" HorizontalAlignment="Stretch" Padding="0,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Tile 4: Quarantine Vault (Purple Accent) -->
                <Border Style="{StaticResource ModuleCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Colored Icon Box -->
                        <Border Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="12"
                                Background="{DynamicResource BrushStatusPurpleBg}" BorderBrush="{DynamicResource BrushStatusPurpleBorder}" BorderThickness="1.5" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Archive24" Foreground="{DynamicResource BrushStatusPurple}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="Karantina Kasası" Style="{StaticResource SectionHeadingStyle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Text="Yalıtılmış ve AES-256 ile şifrelenmiş şüpheli/zararlı dosyaları güvenle saklar." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <!-- Action Button -->
                        <Button Grid.Row="3" Content="Kasayı Aç" Style="{StaticResource SecondaryActionButtonStyle}" 
                                Command="{Binding NavigateToTargetCommand}" CommandParameter="quarantine" HorizontalAlignment="Stretch" Padding="0,8" FontSize="12"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════
                 3. COMPACT LIVE SECURITY TELEMETRY STREAM (Sade & Kompakt Canlı Akış)
            ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0" Padding="16,14,16,14">
                <StackPanel>
                    <!-- Stream Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Activity24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Canlı Güvenlik Akışı" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="— Arka planda taranan ve korunan son olaylar" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Pulsing Live Monitoring Badge -->
                        <Border Grid.Column="1" Style="{StaticResource BadgeSafeStyle}" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushStatusSafeDark}" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:1.0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="CANLI İZLEME" Style="{StaticResource BadgeTextStyle}" FontSize="9.5" Foreground="{DynamicResource BrushStatusSafeText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Stream Events Table -->
                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding LiveActivities}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}"
                                  MaxHeight="160"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ZAMAN" Binding="{Binding TimestampFormatted}" Width="75"/>
                                <DataGridTextColumn Header="DOSYA / HEDEF" Binding="{Binding FileName}" Width="160"/>
                                <DataGridTextColumn Header="DİZİN &amp; AŞAMA" Binding="{Binding StageDetails}" Width="*"/>
                                <DataGridTextColumn Header="RİSK" Binding="{Binding ScoreBadge}" Width="70"/>
                                <DataGridTextColumn Header="MÜDAHALE" Binding="{Binding ActionTaken}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
