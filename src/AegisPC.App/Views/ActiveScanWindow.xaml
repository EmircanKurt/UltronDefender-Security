<Window x:Class="AegisPC.App.Views.ActiveScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:AegisPC.App.Converters"
        Title="Tarayıcı - Ultron Defender Total Security"
        Width="880" Height="580"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Background="{DynamicResource BrushCardBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActiveTabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBrandPrimary}"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBrandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBrandPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP TAB NAVIGATION BAR -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Target24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tarayıcı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <!-- Tabs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Tarayıcı" Style="{StaticResource ActiveTabHeaderStyle}"/>
                            <Rectangle Height="2.5" Fill="{DynamicResource BrushBrandPrimary}" Margin="0,4,0,0" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                        <TextBlock Text="Zamanlayıcı" Style="{StaticResource TabHeaderStyle}"/>
                        <TextBlock Text="Raporlar" Style="{StaticResource TabHeaderStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ACTIVE SCANNING VIEW -->
        <Grid Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tehdit Taraması işleniyor..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,24"/>

            <!-- Main 3-Column Scan Container -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Animated Laptop / Scanning Device Illustration -->
                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Height="145" Background="{DynamicResource BrushAppBg}" CornerRadius="10" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="14">
                    <Grid>
                        <!-- Laptop Display Frame -->
                        <Border Background="{DynamicResource BrushAppBg}" CornerRadius="6" Margin="4,4,4,22" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                            <Canvas x:Name="LaserCanvas" ClipToBounds="True">
                                <!-- Animated Laser Scan Line -->
                                <Rectangle x:Name="LaserLine" Width="3" Height="90" Fill="{DynamicResource BrushBrandPrimary}" Canvas.Top="0" Canvas.Left="15">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="{DynamicResource ColorBrandPrimary}" ShadowDepth="0"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Canvas>
                        </Border>
                        <!-- Laptop Base Plate -->
                        <Border Height="10" VerticalAlignment="Bottom" Background="{DynamicResource BrushCardBorder}" CornerRadius="0,0,6,6" Margin="0,0,0,8"/>
                    </Grid>
                </Border>

                <!-- Middle: 5-Step Animated Checklist -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,20,0">
                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Güncellemeleri denetle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Bellek nesnelerini tara" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Başlangıç öğelerini tara" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Step 4 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Kayıt Defterini tara" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Step 5 (Active scanning indicator) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Canvas Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseIndicator" Width="14" Height="14" Fill="{DynamicResource BrushBrandPrimary}" Canvas.Left="1" Canvas.Top="1"/>
                        </Canvas>
                        <TextBlock Text="Dosya sistemini tara" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                    </StackPanel>

                    <!-- Control Buttons (Duraklat & İptal) -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding PauseButtonText}" Width="100" Height="32" Margin="0,0,12,0" Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding TogglePauseResumeCommand}"/>
                        <Button Content="İptal" Width="100" Height="32" Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding CancelScanCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Live Statistics Panel -->
                <Border Grid.Column="2" Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,16" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tarama Süresi" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding ScanDurationFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>

                        <TextBlock Text="Taranan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding ScannedItemsFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>

                        <TextBlock Text="Tespitler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding DetectionsCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Progress Bar & Current File Path -->
            <StackPanel Grid.Row="2">
                <ProgressBar Value="{Binding ProgressPercentage}" Height="6" Background="{DynamicResource BrushCardBorder}" Foreground="{DynamicResource BrushBrandPrimary}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentFile, StringFormat='İncelenen: \{0\}'}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- 3. SCAN COMPLETED / THREAT RESULTS VIEW -->
        <Grid Grid.Row="1" Visibility="{Binding IsScanFinishedView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Real-Time Counters -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Tehdit Taraması Sonuçları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>

                <!-- Metrics Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Algılanan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DetectionsCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Tarama Süresi" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanDurationFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Taranan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScannedItemsFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Body: Table or Safe Message -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <!-- Clean State -->
                <Border Background="{DynamicResource BrushStatusSafeBg}" BorderBrush="{DynamicResource BrushStatusSafeBorder}" BorderThickness="1" CornerRadius="8" Padding="20"
                        Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sisteminiz Tamamen Güvende!" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushStatusSafeText}"/>
                            <TextBlock Text="Taranan dosyalarda herhangi bir zararlı kod veya tehdit bulunamadı." FontSize="12" Foreground="{DynamicResource BrushStatusSafeText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Threats Table -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsAllSelected}" Command="{Binding ToggleSelectAllCommand}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Adı" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="Tür" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="3" Text="Nesne Türü" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="4" Text="Konum" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ItemsControl ItemsSource="{Binding ThreatResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushBrandPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ThreatType}" FontSize="11.5" Foreground="{DynamicResource BrushStatusDanger}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ObjectType}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Location}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Raporla ⌄" Width="100" Height="34" Style="{StaticResource SecondaryActionButtonStyle}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Kapat" Width="100" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding CloseResultsCommand}" Click="OnCloseClicked"/>
                    <Button Content="Karantinaya Al" Width="130" Height="34" Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding QuarantineSelectedCommand}"
                            Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
