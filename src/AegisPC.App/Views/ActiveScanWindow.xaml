<Window x:Class="AegisPC.App.Views.ActiveScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:AegisPC.App.Converters"
        Title="Tarayıcı - Ultron Defender Total Security"
        Width="880" Height="580"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/UltronDefender;component/Resources/Images/app.ico"
        Background="{DynamicResource BrushCardBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActiveTabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushCardBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBrandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBrandPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ActiveScanScale" ScaleX="0.98" ScaleY="0.98"/>
                <TranslateTransform x:Name="ActiveScanTranslate" Y="8"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ActiveScanScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ActiveScanScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ActiveScanTranslate" Storyboard.TargetProperty="Y" To="0.0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP TAB NAVIGATION BAR -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Target24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tarayıcı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <!-- Tabs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanTabButton" Content="Tarayıcı" Click="OnScanTabClicked" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="SchedulerTabButton" Content="Zamanlayıcı" Click="OnSchedulerTabClicked" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="ReportsTabButton" Content="Raporlar" Click="OnReportsTabClicked" Style="{StaticResource SecondaryActionButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="ScannerPanel">
        <!-- 0. IDLE / READY TO SCAN VIEW -->
        <Grid Visibility="{Binding IsIdleView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tarayıcı Hazır" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Bilgisayarınızı virüslere, fidye yazılımlarına ve kötücül tehditlere karşı taramak için bir tarama türü seçin." FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20" VerticalAlignment="Center">
                <!-- Card 1: Quick Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Hızlı Tarama" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Bellek, başlangıç nesneleri, Temp ve kritik sistem dizinlerini hızlıca analiz eder." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Hızlı Taramayı Başlat" Style="{StaticResource PrimaryActionButtonStyle}"
                                Command="{Binding StartQuickScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Card 2: Full Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Tam Sistem Taraması" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Tüm sabit disklerdeki tüm dosyaları ve derin kayıt defteri enjeksiyonlarını kapsar." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Tam Taramayı Başlat" Style="{StaticResource PrimaryActionButtonStyle}"
                                Command="{Binding StartFullScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Card 3: Custom Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Özel Dizin Taraması" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Belirli bir klasörü, harici USB sürücüsünü veya indirme dizinini seçip analiz edin." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Klasör Seç ve Tara" Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding StartCustomScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Button Content="Kapat" Width="100" Height="34" HorizontalAlignment="Right" Click="OnCloseClicked" Style="{StaticResource SecondaryActionButtonStyle}"/>
            </Grid>
        </Grid>

        <!-- 2. ACTIVE SCANNING VIEW -->
        <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tehdit Taraması işleniyor..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,24"/>

            <!-- Main 3-Column Scan Container -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Animated Laptop / Scanning Device Illustration -->
                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Height="145" Background="{DynamicResource BrushAppBg}" CornerRadius="6" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="14">
                    <Grid>
                        <!-- Laptop Display Frame -->
                        <Border Background="{DynamicResource BrushAppBg}" CornerRadius="4" Margin="4,4,4,22" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                            <Canvas x:Name="LaserCanvas" ClipToBounds="True">
                                <!-- Animated Laser Scan Line (Always Green BrushStatusSafe) -->
                                <Rectangle x:Name="LaserLine" Width="3" Height="90"
                                           Fill="{DynamicResource BrushStatusSafe}"
                                           Canvas.Top="0" Canvas.Left="15">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          Color="{DynamicResource ColorStatusSafe}"
                                                          ShadowDepth="0"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Canvas>
                        </Border>
                        <!-- Laptop Base Plate -->
                        <Border Height="10" VerticalAlignment="Bottom" Background="{DynamicResource BrushCardBorder}" CornerRadius="0,0,4,4" Margin="0,0,0,8"/>
                    </Grid>
                </Border>

                <!-- Only observed engine status is displayed; progress percentages are not subsystem completion evidence. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,20,0">
                    <TextBlock Text="{Binding ScanStatusText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Dosya içeriği, imza ve etkin tespit kuralları inceleniyor. Yüzdelik ilerleme ayrı bir koruma aşamasının tamamlandığını kanıtlamaz." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ActiveResourceProfileText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FailedCount, StringFormat='İncelenemeyen: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding TimedOutCount, StringFormat='Zaman aşımı: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding PauseButtonText}" Width="100" Height="32" Margin="0,0,12,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding TogglePauseResumeCommand}"/>
                        <Button Content="İptal" Width="100" Height="32" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CancelScanCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Live Statistics Panel -->
                <Border Grid.Column="2" Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="18,16" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tarama Süresi" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding ScanDurationFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>

                        <TextBlock Text="Taranan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding ScannedItemsFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ScannedBreakdownFormatted}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <!-- Tespitler: Yalnızca tespit sayısı > 0 iken kırmızı (BrushStatusDanger) -->
                        <TextBlock Text="İnceleme bulguları (virüs sayısı değil)" TextWrapping="Wrap" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushStatusDanger}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DetectionsCount}" FontSize="16" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushStatusDanger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,10,0,10"/>
                        <TextBlock Text="{Binding FindingBreakdownText}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Tarama süreci CPU / RAM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CpuAndRamFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Progress Bar & Current File Path (Always Green BrushStatusSafe) -->
            <StackPanel Grid.Row="2">
                <ProgressBar Value="{Binding ProgressPercentage}" Height="6" Background="{DynamicResource BrushCardBorder}"
                             Foreground="{DynamicResource BrushStatusSafe}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding CurrentFile, StringFormat='İncelenen: \{0\}'}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" MaxWidth="550"/>
                    <TextBlock Text="{Binding RemainingEtaFormatted}" FontSize="11.5"
                               Foreground="{DynamicResource BrushStatusSafe}"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 3. SCAN COMPLETED / THREAT RESULTS VIEW -->
        <Grid Visibility="{Binding IsScanFinishedView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Real-Time Counters -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ScanResultTitle, FallbackValue='Tehdit Taraması Sonuçları'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>

                <!-- Metrics Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Algılanan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DetectionsCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushStatusDanger}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Tarama Süresi" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanDurationFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Taranan Öğeler" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScannedItemsFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScannedBreakdownFormatted}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Body: Table or Safe Message -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <!-- Clean State (0 tespit → yeşil "Sisteminiz temiz" özeti) -->
                <Border Background="{DynamicResource BrushStatusSafeBg}" BorderBrush="{DynamicResource BrushStatusSafeBorder}" BorderThickness="1" CornerRadius="6" Padding="20"
                        Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CleanStateTitle, FallbackValue='Sonuç durumu alınamadı'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushStatusSafeText}"/>
                            <TextBlock Text="{Binding CleanStateSubtitle, FallbackValue='Tarama kapsamını ve hataları rapordan inceleyin.'}" FontSize="12" TextWrapping="Wrap" MaxWidth="610" Foreground="{DynamicResource BrushStatusSafeText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Threats State (tespit var → kırmızı özet + "Karantinaya Al" birincil butonu) -->
                <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource BrushStatusDangerBg}" BorderBrush="{DynamicResource BrushStatusDangerBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" Foreground="{DynamicResource BrushStatusDanger}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FindingsCount, StringFormat='İncelenen öğelerde \{0\} güvenlik bulgusu var.'}"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushStatusDangerText}"/>
                                <TextBlock Text="Şüpheli bulgu kesin zararlı demek değildir; gerekçe ve kaynakları inceleyin."
                                           FontSize="11" Foreground="{DynamicResource BrushStatusDangerText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Threats Table -->
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" MaxHeight="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header (Sticky) -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsAllSelected}" Command="{Binding ToggleSelectAllCommand}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Adı" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="Tür" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="3" Text="Müdahale" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="4" Text="Konum" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="5" Text="İşlem" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Virtualized Items -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding ThreatResults}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,7" Background="Transparent">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="🛡️ Bu dosyayı istisna yap"
                                                                  Command="{Binding DataContext.ExcludeFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="95"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ThreatType}" FontSize="11.5" Foreground="{DynamicResource BrushStatusDanger}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ActionTaken}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushStatusSafeDark}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Location}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5"
                                                            Command="{Binding DataContext.ExcludeFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Bu dosyayı istisna yap"
                                                            Padding="6,3" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryActionButtonStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ShieldDismiss20" FontSize="12" Margin="0,0,3,0" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                                            <TextBlock Text="İstisna" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Raporla" Width="100" Height="34" Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding ExportScanReportCommand}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Kapat" Width="100" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding CloseResultsCommand}" Click="OnCloseClicked"/>
                    <Button Content="Olayı Kapat" ToolTip="Olay kaydını kapatır; dosyayı güvenilir ilan etmez ve tarama istisnası oluşturmaz." Width="140" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding ResolveSelectedCommand}"
                            Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Karantinaya Al" Width="130" Height="34" Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding QuarantineSelectedCommand}"
                            Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>

        <Grid Grid.Row="1" x:Name="ReportsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Gerçek Tarama Raporları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="{Binding ReportHistoryStatus}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding ReportHistory}" SelectedItem="{Binding SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,0,0,14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="165"/>
                    <DataGridTextColumn Header="Tarama ve Kapsam" Binding="{Binding Summary}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yenile" Command="{Binding RefreshReportsCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Seçili Raporu Dışa Aktar" Command="{Binding ExportSelectedReportCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="SchedulerPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Tarama Zamanlayıcısı" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                <TextBlock Text="Ayarlar ana uygulamayla ortaktır. Zamanlanmış ve AFK taramaları koruma servisi çalışırken yürütülür. Açık ve kilitlenmemiş masaüstünde güvenli AFK doğrulaması henüz yoktur; tarama ertelenebilir." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,18"/>
                <CheckBox Content="Zamanlanmış rutin taramayı etkinleştir" IsChecked="{Binding ScanScheduleEnabled}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>
                <TextBlock Text="Günlük başlangıç saati" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding ScanHours}" SelectedItem="{Binding SelectedScanHourString}" IsEnabled="{Binding ScanScheduleEnabled}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <TextBlock Text="Tekrar aralığı" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding ScanPeriods}" SelectedItem="{Binding SelectedScanPeriod}" IsEnabled="{Binding ScanScheduleEnabled}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                <CheckBox Content="Güvenle doğrulanmış boşta / kilitli oturumda bakım taraması" IsChecked="{Binding IdleScanEnabled}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>
                <CheckBox Content="Pil kullanılırken boşta taramayı ertele" IsChecked="{Binding SkipIdleScanOnBattery}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="Ayarları Kaydet" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
