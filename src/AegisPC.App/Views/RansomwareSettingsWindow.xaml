<Window x:Class="AegisPC.App.Views.RansomwareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Fidye Kalkanı Yönetimi - Ultron Defender Total Security"
        Width="1080" Height="750"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Background="{DynamicResource BrushAppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar with Close Button -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{DynamicResource BrushStatusWarningBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Fidye Kalkanı Yönetimi ve Gelişmiş Ayarlar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Korumalı klasörler, izin verilen uygulamalar ve canary tuzak durumunu buradan yönetin." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Kapat" Click="OnCloseClicked" Style="{DynamicResource SecondaryActionButtonStyle}" Padding="18,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Frame hosting RansomwareShieldView -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
