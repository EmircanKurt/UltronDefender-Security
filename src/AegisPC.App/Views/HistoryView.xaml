<Page x:Class="AegisPC.App.Views.HistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Uygulama ve Güvenlik Denetim Günlüğü" Margin="0,0,0,4"/>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="Eylem, hedef veya detay ile filtrele..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" Height="36"/>

            <Button Grid.Column="1" Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding LoadLogsCommand}" Padding="14,6"/>
        </Grid>

        <!-- 3. Logs DataGrid (Strict DataTableStyle: Pure Sans-Serif, Tabular Numerals) -->
        <Grid Grid.Row="2">
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                <ui:DataGrid ItemsSource="{Binding Logs}" 
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             RowHeaderWidth="0"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Header="Zaman" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='\{0:yyyy-MM-dd HH:mm:ss\}'}" Style="{StaticResource DataMonospaceStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Eylem" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Action}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Hedef Türü" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetType}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushTextSecondary}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Hedef Adı" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetName}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetName}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sonuç" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{DynamicResource BrushStatusSafeDark}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Detaylar" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Empty State Overlay -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" 
                    Visibility="{Binding HasNoLogs, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="📋" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Henüz kaydedilmiş aktivite bulunmuyor" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Taramalar, karantina işlemleri ve güvenlik olayları burada listelenir." 
                               Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
