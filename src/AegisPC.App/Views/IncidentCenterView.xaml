<Page x:Class="AegisPC.App.Views.IncidentCenterView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Olay ve Tehdit Bildirim Merkezi (EDR)" Margin="0,0,0,4"/>
                <TextBlock Text="Davranışsal tehdit tespitleri, saldırı zincirleri ve otomatik müdahale raporları." FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FEE2E2" CornerRadius="6" Padding="12,6" Margin="0,0,12,0"
                        Visibility="{Binding HasNoIncidents, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <TextBlock Text="{Binding ActiveIncidentCount, StringFormat='🚨 {0} Aktif Olay'}" FontWeight="Bold" FontSize="12" Foreground="#DC2626"/>
                </Border>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Yenile" Command="{Binding LoadIncidentsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Main Body: Master / Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Incident List -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,16,0" Padding="14">
                <Grid>
                    <!-- Incidents ListBox -->
                    <ListBox ItemsSource="{Binding Incidents}" 
                             SelectedItem="{Binding SelectedIncident}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding ThreatName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                                            <Border HorizontalAlignment="Right" Background="#FEF2F2" CornerRadius="4" Padding="6,1.5">
                                                <TextBlock Text="{Binding RiskScore, StringFormat='Risk: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding RootProcessName, StringFormat='Süreç: {0}'}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                        
                                        <Grid Grid.Row="2" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='\{0:HH:mm:ss\}'}" FontSize="11" Foreground="#94A3B8"/>
                                            <Border HorizontalAlignment="Right" Background="#EFF6FF" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <Border Background="{DynamicResource BrushCardBg}" Visibility="{Binding HasNoIncidents, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="🛡️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Aktif Tehdit Olayı Yok" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sisteminiz arka planda gerçek zamanlı korunuyor." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Incident Details & Timeline -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Padding="20">
                <Grid>
                    <!-- Detail Content -->
                    <ScrollViewer Margin="0,0,0,0">
                        <Grid>
                            <StackPanel Visibility="{Binding SelectedIncident, Converter={StaticResource BoolToVis}}" DataContext="{Binding SelectedIncident}">
                                <!-- Incident Header -->
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding IncidentId, StringFormat='Olay Kimliği: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#DC2626" CornerRadius="6" Padding="12,4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RiskScore, StringFormat='Risk Skoru: {0}/100'}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>

                                <!-- Key Metadata Grid -->
                                <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Kök Süreç:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding RootProcessName, StringFormat='\{0\}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Müdahale:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding ActionTaken}" FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PID / Süreç No:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding RootPid}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Durum:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- File Path -->
                                <TextBlock Text="Zararlı Kaynak Dosya Yolu:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="10,6" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding RootExecutablePath}" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Timeline -->
                                <TextBlock Text="Kronolojik Saldırı Zaman Çizelgesi:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Timeline}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Plain Turkish Explanation -->
                                <TextBlock Text="Güvenlik Analizi ve Açıklama:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding HumanExplanation}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" LineHeight="18"/>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="🔒 Kaynak Dosyayı Karantinaya Al" 
                                            Command="{Binding DataContext.QuarantineSourceFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="16,8"/>
                                    <Button Content="✓ Çözüldü Olarak İşaretle" 
                                            Command="{Binding DataContext.RemediateIncidentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Empty Placeholder when no incident is selected -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,100,20,0"
                                        Visibility="{Binding SelectedIncident, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="İncelemek için soldaki listeden bir güvenlik olayı seçin." 
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</Page>

