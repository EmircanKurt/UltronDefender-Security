<Page x:Class="AegisPC.App.Views.PerformanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="#EEF2F6"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:PercentToColorConverter x:Key="PercentColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="32,24,32,32" 
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  CanContentScroll="False"
                  Focusable="True"
                  PreviewMouseWheel="OnPagePreviewMouseWheel">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Donanım ve Performans Teşhis Merkezi" Margin="0,0,0,2"/>
                    <TextBlock Text="Gerçek zamanlı WMI donanım telemetrisi, CPU, RAM ve GPU süreç tüketimleri." FontSize="13" Foreground="#64748B"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                        Content="Yenile" Command="{Binding RefreshDataCommand}" VerticalAlignment="Center"/>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 1. REAL HARDWARE PROFILE SUMMARY (MOTHERBOARD, GPU, CPU, RAM)
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="SİSTEM DONANIM PROFİLİ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Processor Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="130" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="#DC2626" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="İŞLEMCİ (CPU)" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Cpu.Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CpuSummary}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Cpu.MaxClockSpeedMhz, StringFormat='Taban Hız: \{0\} MHz'}" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="130" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Tv24" Foreground="#2563EB" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="EKRAN KARTI (GPU)" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PrimaryGpu.Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GpuSummary}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PrimaryGpu.DriverVersion, StringFormat='Sürücü: \{0\}'}" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Motherboard Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="130" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="#10B981" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="ANAKART (BASEBOARD)" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MotherboardSummary}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Motherboard.SerialNumber, StringFormat='Seri No: \{0\}'}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Motherboard.Version, StringFormat='Sürüm: \{0\}'}" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="130">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="AppsListDetail24" Foreground="#D97706" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="SİSTEM BELLEĞİ (RAM)" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRamGb, StringFormat='\{0\} GB Toplam Kapasite'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding RamSummary}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Çift Kanal (Dual Channel) Aktif" FontSize="11" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══════════════════════════════════════════════════════════
                 2. ULTRON DEFENDER ÖZ KAYNAK TÜKETİMİ & CANLI TELEMETRİ
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="ULTRON DEFENDER CANLI SİSTEM KAYNAK TÜKETİMİ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,24" Padding="20" Background="#FFFFFF" BorderBrush="#CBD5E1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#10B981" FontSize="22" Margin="0,0,10,0"/>
                            <TextBlock Text="Ultron Defender Süreç ve Güvenlik Metrikleri" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0">
                                <TextBlock Text="{Binding UltronStatus}" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UltronPid, StringFormat='PID: \{0\}'}" FontSize="12" FontFamily="Consolas" Foreground="#64748B" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding UltronUptime, StringFormat='Çalışma Süresi: \{0\}'}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 Live Stats -->
                    <UniformGrid Grid.Row="1" Columns="4">
                        <!-- CPU -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="İşlemci (CPU) Kullanımı" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronCpuUsage}" FontSize="20" FontWeight="Black" Foreground="#2563EB"/>
                                <TextBlock Text="Sıfır etki / Arka plan optimizasyonu" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM Working Set -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Fiziksel Bellek (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronRamUsage}" FontSize="20" FontWeight="Black" Foreground="#0F172A"/>
                                <TextBlock Text="Çalışma Kümesi (WorkingSet)" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Private Memory -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Özel Bellek (Private Commit)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronPrivateMemory}" FontSize="20" FontWeight="Black" Foreground="#0F172A"/>
                                <TextBlock Text="Ayrılmış bellek havuzu" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Threads & Handles -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="İş Parçacıkları ve Tanıtıcılar" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronThreadCount, StringFormat='\{0\} Thread'}" FontSize="20" FontWeight="Black" Foreground="#D97706"/>
                                <TextBlock Text="{Binding UltronHandleCount, StringFormat='\{0\} Handle aktif'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 3. STORAGE PARTITIONS & HARD DRIVES
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="SÜRÜCÜ VE DEPOLAMA DURUMU" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Width="280" Height="135" Margin="0,0,16,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="HardDrive24" Foreground="#0284C7" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding VolumeLabel, StringFormat=' ({0})'}" Foreground="#64748B" FontSize="13"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="7" Margin="0,4" 
                                             Foreground="{Binding UsagePercent, Converter={StaticResource PercentColorConverter}}" Background="#E2E8F0"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding FreeBytes, Converter={StaticResource BytesConverter}, StringFormat='\{0\} boş'}" Foreground="#059669" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}, StringFormat='\{0\} toplam'}" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════════════════════════════════════════════════════
                 3. TOP RESOURCE CONSUMERS (CPU, MEMORY, AND GPU)
            ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top CPU Column -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK CPU KULLANANLAR" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF2F6" BorderBrush="#E0EBEA" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#FEE2E2" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="#DC2626" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" FontSize="10" Foreground="#475569"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CpuPercent, StringFormat='\{0:0.0\} %'}" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top Memory Column -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="8,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK BELLEK KULLANANLAR" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopMemoryProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF2F6" BorderBrush="#E0EBEA" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#DBEAFE" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="AppsListDetail24" Foreground="#2563EB" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" FontSize="10" Foreground="#475569"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemoryBytes, Converter={StaticResource BytesConverter}}" FontWeight="Bold" FontSize="11" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top GPU Column -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK EKRAN KARTI (GPU) KULLANANLAR" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopGpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEF2F6" BorderBrush="#E0EBEA" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#ECFDF5" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Tv24" Foreground="#059669" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" FontSize="10" Foreground="#475569"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuPercent, StringFormat='\{0:0.0\} %'}" FontWeight="Bold" FontSize="11" Foreground="#059669"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
