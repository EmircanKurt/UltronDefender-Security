<Page x:Class="AegisPC.App.Views.PerformanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:PercentToColorConverter x:Key="PercentColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="28,20,28,28" 
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  CanContentScroll="False"
                  Focusable="True"
                  PreviewMouseWheel="OnPagePreviewMouseWheel">
        <StackPanel>
            <!-- 1. Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Donanım ve Performans Teşhis Merkezi" Margin="0,0,0,2"/>
                    <TextBlock Text="Gerçek zamanlı donanım telemetrisi, CPU, RAM ve GPU süreç tüketimleri." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" 
                        Content="Yenile" Command="{Binding RefreshDataCommand}" VerticalAlignment="Center" Padding="12,4"/>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 2. REAL HARDWARE PROFILE SUMMARY (MOTHERBOARD, GPU, CPU, RAM)
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="SİSTEM DONANIM PROFİLİ" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,10"/>
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Processor Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="135" Margin="0,0,12,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="İŞLEMCİ (CPU)" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Cpu.Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CpuSummary}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Cpu.MaxClockSpeedMhz, StringFormat='Taban Hız: \{0\} MHz'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushBrandPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="135" Margin="0,0,12,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Tv24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="EKRAN KARTI (GPU)" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PrimaryGpu.Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GpuSummary}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PrimaryGpu.DriverVersion, StringFormat='Sürücü: \{0\}'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushBrandPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Motherboard Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="135" Margin="0,0,12,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="ANAKART (BASEBOARD)" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MotherboardSummary}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Motherboard.SerialNumber, StringFormat='Seri No: \{0\}'}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Motherboard.Version, StringFormat='Sürüm: \{0\}'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushBrandPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Style="{StaticResource MetricCardStyle}" Height="135" Margin="0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="AppsListDetail24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="SİSTEM BELLEĞİ (RAM)" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRamGb, StringFormat='\{0\} GB Toplam Kapasite'}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding RamSummary}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Çift Kanal (Dual Channel) Aktif" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushStatusSafeDark}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══════════════════════════════════════════════════════════
                 3. ULTRON DEFENDER ÖZ KAYNAK TÜKETİMİ & CANLI TELEMETRİ
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="ULTRON DEFENDER CANLI SİSTEM KAYNAK TÜKETİMİ" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,10"/>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="22" Margin="0,0,10,0"/>
                            <TextBlock Text="Ultron Defender Süreç ve Güvenlik Metrikleri" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource BadgeSafeStyle}" Margin="12,0,0,0">
                                <TextBlock Text="{Binding UltronStatus}" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusSafeText}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UltronPid, StringFormat='PID: \{0\}'}" Style="{StaticResource DataMonospaceStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding UltronUptime, StringFormat='Çalışma Süresi: \{0\}'}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 Live Stats -->
                    <UniformGrid Grid.Row="1" Columns="4">
                        <!-- CPU -->
                        <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="İşlemci (CPU) Kullanımı" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronCpuUsage}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                <TextBlock Text="Sıfır etki / Arka plan optimizasyonu" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusSafeDark}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM Working Set -->
                        <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Fiziksel Bellek (RAM)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronRamUsage}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Çalışma Kümesi (WorkingSet)" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Private Memory -->
                        <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Özel Bellek (Private Commit)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronPrivateMemory}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Ayrılmış bellek havuzu" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Threads & Handles -->
                        <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0">
                            <StackPanel>
                                <TextBlock Text="İş Parçacıkları ve Tanıtıcılar" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UltronThreadCount, StringFormat='\{0\} Thread'}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource BrushStatusWarning}"/>
                                <TextBlock Text="{Binding UltronHandleCount, StringFormat='\{0\} Handle aktif'}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 4. STORAGE PARTITIONS & HARD DRIVES
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock Text="SÜRÜCÜ VE DEPOLAMA DURUMU" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Width="280" Height="135" Margin="0,0,16,16" Padding="16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="HardDrive24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding VolumeLabel, StringFormat=' ({0})'}" Style="{StaticResource CaptionTextStyle}" FontSize="13"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="7" Margin="0,4" 
                                             Foreground="{Binding UsagePercent, Converter={StaticResource PercentColorConverter}}" Background="{DynamicResource BrushCardBorder}"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding FreeBytes, Converter={StaticResource BytesConverter}, StringFormat='\{0\} boş'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushStatusSafeDark}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}, StringFormat='\{0\} toplam'}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════════════════════════════════════════════════════
                 5. TOP RESOURCE CONSUMERS (CPU, MEMORY, AND GPU) - STRICT TABULAR
            ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top CPU Column -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK CPU KULLANANLAR" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="{DynamicResource BrushStatusDangerBg}" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{DynamicResource BrushStatusDanger}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" Style="{StaticResource DataMonospaceStyle}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource BadgeDangerStyle}" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CpuPercent, StringFormat='\{0:0.0\} %'}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushStatusDangerText}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top Memory Column -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="8,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK BELLEK KULLANANLAR" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopMemoryProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="{DynamicResource BrushBrandMinimal}" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="AppsListDetail24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" Style="{StaticResource DataMonospaceStyle}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource BadgeProgressStyle}" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemoryBytes, Converter={StaticResource BytesConverter}}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top GPU Column -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK EKRAN KARTI (GPU) KULLANANLAR" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopGpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="{DynamicResource BrushStatusSafeBg}" CornerRadius="5" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Tv24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PID, StringFormat='PID: \{0\}'}" Style="{StaticResource DataMonospaceStyle}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource BadgeSafeStyle}" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuPercent, StringFormat='\{0:0.0\} %'}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushStatusSafeText}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
