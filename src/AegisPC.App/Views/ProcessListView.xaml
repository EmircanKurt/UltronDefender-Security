<Page x:Class="AegisPC.App.Views.ProcessListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
    </Page.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Süreç Yöneticisi" Margin="0,0,0,4"/>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="Süreç adı veya PID ile filtrele..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" Height="36"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding LoadProcessesCommand}" Margin="0,0,8,0" Padding="14,6"/>
                <Button Content="Görevi Sonlandır" Style="{StaticResource DangerButtonStyle}" 
                        Command="{Binding TerminateProcessCommand}"
                        IsEnabled="{Binding SelectedProcess, Converter={StaticResource NullToBool}}" Padding="16,6"/>
            </StackPanel>
        </Grid>

        <!-- 3. Main Content (Table + Detail) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Process DataGrid (Strict DataTableStyle: Pure Sans-Serif, Tabular Numerals) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0">
                <ui:DataGrid ItemsSource="{Binding Processes}" 
                             SelectedItem="{Binding SelectedProcess}"
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             RowHeaderWidth="0"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Header="PID" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PID}" Style="{StaticResource DataMonospaceStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Süreç Adı" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CPU %" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat='\{0:F1\} %'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Bellek" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MemoryBytes, Converter={StaticResource BytesConverter}}" Style="{StaticResource DataTableStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Yol" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Process Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">
                        <TextBlock Text="Süreç Detayı" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedProcess, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedProcess.Name}" Style="{StaticResource SectionHeadingStyle}" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedProcess.PID, StringFormat='PID: \{0\}'}" Style="{StaticResource DataMonospaceStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                            <TextBlock Text="Kaynak Kullanımı" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProcess.CpuPercent, StringFormat='CPU: \{0:F1\} %'}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding SelectedProcess.MemoryBytes, Converter={StaticResource BytesConverter}, StringFormat='Bellek: \{0\}'}" Style="{StaticResource DataTableStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Dosya Konumu" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <TextBox Text="{Binding SelectedProcess.ExecutablePath}" TextWrapping="Wrap" Style="{StaticResource DataMonospaceStyle}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </Border>

                            <TextBlock Text="Başlangıç Zamanı" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedProcess.StartTime, StringFormat='\{0:yyyy-MM-dd HH:mm:ss\}'}" Style="{StaticResource DataTableStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Üst Süreç PID" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedProcess.ParentPid}" Style="{StaticResource DataMonospaceStyle}" Margin="0,0,0,16"/>

                            <StackPanel Margin="0,16,0,0">
                                <Button Content="Süreci Sonlandır" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding TerminateProcessCommand}" Margin="0,0,0,8"/>
                                <Button Content="Ağacı Sonlandır" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding TerminateTreeCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="İncelemek için listeden bir süreç seçin." 
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
