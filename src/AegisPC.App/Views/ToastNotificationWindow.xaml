<Window x:Class="AegisPC.App.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Width="380" Height="205" WindowStartupLocation="Manual">
    <Border x:Name="CardBorder" Background="{DynamicResource BrushCardBg}"
            CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BrushCardBorder}"
            MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentStripe" Background="#7297AD" CornerRadius="10,0,0,10"/>
            <Grid Grid.Column="1" Margin="15,10,15,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Ultron Defender" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <Button Content="×" Width="26" Height="24" HorizontalAlignment="Right"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource BrushTextSecondary}" Cursor="Hand"
                        ToolTip="Bildirimi kapat" AutomationProperties.Name="Bildirimi kapat" Click="OnCloseClicked"/>
                <TextBlock x:Name="ToastTitle" Grid.Row="1" Text="Bildirim" FontSize="14"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,4,0,7"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,8" PanningMode="VerticalOnly">
                    <TextBlock x:Name="ToastMessage" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button Grid.Row="3" Content="Ayrıntılar" HorizontalAlignment="Right" Padding="12,4"
                        MinWidth="85" Background="Transparent" BorderBrush="{DynamicResource BrushCardBorder}"
                        Foreground="{DynamicResource BrushTextPrimary}" Cursor="Hand"
                        AutomationProperties.Name="Bildirim ayrıntılarını aç" Click="OnFooterActionClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
