<Window x:Class="AegisPC.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AegisPC.App.Controls"
        Title="Ultron Defender"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BrushAppBg}"
            BorderBrush="{DynamicResource BrushCardBorder}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <!-- The same vector robot is decorative during startup; it never tracks input here. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                <controls:UltronRobot IsInteractive="False" IsMotionEnabled="False" HorizontalAlignment="Center"/>

                <TextBlock Text="ULTRON DEFENDER"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,2"/>

                <TextBlock Text="Gelişmiş Uç Nokta Güvenlik Sistemi"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Başlatılıyor…" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"/>
        </Grid>
    </Border>
</Window>
