<Window x:Class="AegisPC.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultron Defender"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#0D0D0D"
            BorderBrush="#222222"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <!-- Background Glow behind Logo -->
            <Ellipse Width="160" Height="140"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,0,0,30">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#253B82F6" Offset="0.0"/>
                        <GradientStop Color="#003B82F6" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="24"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Center Content: Cloud Logo + Cursor + Title -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                <Grid Width="70" Height="62" HorizontalAlignment="Center">
                    <!-- Cloud Base Silhouette -->
                    <Image Source="{DynamicResource ImageCloudLogoBase}"
                           Width="70" Height="62" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="14" Color="#3B82F6" ShadowDepth="0" Opacity="0.8"/>
                        </Image.Effect>
                    </Image>

                    <!-- Blinking Cursor Line Storyboard -->
                    <Image x:Name="SplashCursorLine"
                           Source="{DynamicResource ImageCloudCursorLine}"
                           Width="70" Height="62" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#60A5FA" ShadowDepth="0" Opacity="0.9"/>
                        </Image.Effect>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>

                <TextBlock Text="ULTRON DEFENDER"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#ECECEC"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,2"/>

                <TextBlock Text="Gelişmiş Uç Nokta Güvenlik Sistemi"
                           FontSize="11"
                           Foreground="#737373"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bottom: Thin Loading Bar (Indeterminate progress, 1.2s loop) -->
            <Grid Width="200" Height="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32" Background="#1C1C1C" ClipToBounds="True">
                <Rectangle Width="60" Height="2" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#003B82F6" Offset="0.0"/>
                            <GradientStop Color="#FF3B82F6" Offset="0.5"/>
                            <GradientStop Color="#FF60A5FA" Offset="0.8"/>
                            <GradientStop Color="#0060A5FA" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTransform" X="-60"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="IndicatorTransform"
                                                     Storyboard.TargetProperty="X"
                                                     From="-60" To="200"
                                                     Duration="0:0:1.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </Grid>
        </Grid>
    </Border>
</Window>
