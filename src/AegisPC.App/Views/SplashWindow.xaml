<Window x:Class="AegisPC.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultron Defender"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BrushCardBg}"
            BorderBrush="{DynamicResource BrushCardBorder}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid Margin="32" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <!-- Reuse the product shield without animation, input tracking or a protection-state claim. -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="StartupLogo" Source="pack://application:,,,/UltronDefender;component/Resources/Images/ultron_logo.png"
                           Width="88" Height="88" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Ultron Defender kalkan logosu"/>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="ULTRON" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Defender" FontFamily="Segoe UI" FontSize="17"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Uygulama hazırlanıyor."
                           FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Başlatılıyor…" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>
