<Page x:Class="AegisPC.App.Views.StartupManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:RiskLevelToColorConverter x:Key="RiskColorConverter"/>
        <conv:BoolToStatusTextConverter x:Key="BoolToStatus"/>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Başlangıç ve Kalıcılık Yönetimi" Margin="0,0,0,4"/>

        <!-- 2. Toolbar & Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="Uygulama adı, yol veya kaynak ile filtrele..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" Height="36"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding LoadItemsCommand}" Margin="0,0,8,0" Padding="14,6"/>
                <Button Content="Durumu Değiştir" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding ToggleItemStateCommand}"
                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}" Padding="16,6"/>
            </StackPanel>
        </Grid>

        <!-- 3. Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Table (Strict DataTableStyle: Pure Sans-Serif) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,16,0">
                <ui:DataGrid ItemsSource="{Binding StartupItems}" 
                             SelectedItem="{Binding SelectedItem}"
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             RowHeaderWidth="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Header="Uygulama Adı" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Kaynak" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushTextSecondary}" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Durum" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToStatus}}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Etki" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ImpactLevel}" Style="{StaticResource DataTableStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Risk" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{Binding RiskLevel, Converter={StaticResource RiskColorConverter}}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Dosya Yolu / Komut" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel Margin="4">
                        <TextBlock Text="Başlangıç Girdisi Detayı" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource SectionHeadingStyle}" FontSize="18" Margin="0,0,0,4"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Border Background="{Binding SelectedItem.RiskLevel, Converter={StaticResource RiskColorConverter}}" 
                                        CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedItem.RiskLevel}" Style="{StaticResource BadgeTextStyle}" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Kayıt Yeri / Kaynak:" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedItem.Source}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Çalıştırılabilir Dosya / Komut:" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,2"/>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <TextBox Text="{Binding SelectedItem.FilePath}" Style="{StaticResource DataMonospaceTextBoxStyle}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </Border>

                            <TextBlock Text="Açılış Etki Seviyesi:" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedItem.ImpactLevel}" Style="{StaticResource DataTableStyle}" Margin="0,0,0,16"/>

                            <Button Content="Başlangıç Durumunu Değiştir" Margin="0,12,0,0" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToggleItemStateCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="Detayları görüntülemek için listeden bir başlangıç girdisi seçin."
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Footer -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
