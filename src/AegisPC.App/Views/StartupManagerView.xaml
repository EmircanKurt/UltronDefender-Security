<Page x:Class="AegisPC.App.Views.StartupManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:RiskLevelToColorConverter x:Key="RiskColorConverter"/>
        <conv:BoolToStatusTextConverter x:Key="BoolToStatus"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Text="Başlangıç ve Kalıcılık Yönetimi" />

        <!-- Toolbar & Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="Uygulama adı, yol veya kaynak ile filtrele..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" 
                           Command="{Binding LoadItemsCommand}" Margin="0,0,8,0"/>
                <ui:Button Content="Durumu Değiştir (Aç/Kapat)" Icon="{ui:SymbolIcon Power24}" 
                           Appearance="Primary"
                           Command="{Binding ToggleItemStateCommand}"
                           IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <ui:DataGrid Grid.Column="0" ItemsSource="{Binding StartupItems}" 
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False" IsReadOnly="True"
                         SelectionMode="Single" Margin="0,0,16,0">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="180"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding IsEnabled, Converter={StaticResource BoolToStatus}}" Width="90"/>
                    <DataGridTextColumn Header="Etki" Binding="{Binding ImpactLevel}" Width="90"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="90"/>
                    <DataGridTextColumn Header="Dosya Yolu / Komut" Binding="{Binding FilePath}" Width="*"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Başlangıç Girdisi Detayı" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Border Background="{Binding SelectedItem.RiskLevel, Converter={StaticResource RiskColorConverter}}" 
                                        CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedItem.RiskLevel}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Kayıt Yeri / Kaynak:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedItem.Source}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Çalıştırılabilir Dosya / Komut:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedItem.FilePath}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" FontFamily="Consolas"/>

                            <TextBlock Text="Açılış Etki Seviyesi:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedItem.ImpactLevel}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>

                            <ui:Button Content="Başlangıç Durumunu Değiştir" Margin="0,16,0,0" 
                                       Appearance="Primary"
                                       Command="{Binding ToggleItemStateCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <TextBlock Text="Detayları görüntülemek için soldaki listeden bir başlangıç girdisi seçin."
                                   Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"/>
    </Grid>
</Page>

