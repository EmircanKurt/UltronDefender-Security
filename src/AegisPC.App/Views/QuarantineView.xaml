<Page x:Class="AegisPC.App.Views.QuarantineView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Karantina Kasası" Margin="0,0,0,4"/>

        <!-- 2. Info & Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Karantinaya alınan dosyalar AES-256 ile şifrelenerek etkisizleştirilir ve zararlı çalışması engellenir." 
                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding LoadItemsCommand}" Padding="12,4"/>
        </Grid>

        <!-- 3. Main Content: Table + Side Action Card -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Quarantine Grid (STRICT DataTableStyle: Sans-Serif, Tabular Numerals) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                    <ui:DataGrid ItemsSource="{Binding QuarantinedItems}" 
                                 SelectedItem="{Binding SelectedItem}"
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True"
                                 SelectionMode="Single"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowHeaderWidth="0"
                                 GridLinesVisibility="Horizontal"
                                 HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                        <ui:DataGrid.Columns>
                            <!-- Dosya Adı: Pure Sans-Serif Tabular Column -->
                            <DataGridTemplateColumn Header="Dosya Adı" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding OriginalPath}" 
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Boyut: Tabular Numbers -->
                            <DataGridTemplateColumn Header="Boyut" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource BytesConverter}}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Karantina Zamanı -->
                            <DataGridTemplateColumn Header="Karantina Zamanı" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QuarantinedAt, StringFormat='\{0:yyyy-MM-dd HH:mm\}'}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Sebep: Kırpma + ToolTip -->
                            <DataGridTemplateColumn Header="Sebep" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushStatusDangerText}"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding Reason}" 
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Border>

                <!-- Empty State Overlay -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding HasNoQuarantinedItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="44" Foreground="{DynamicResource BrushStatusSafe}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Karantinada dosya bulunmuyor" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sisteminiz temiz — tespit edilen tehditler güvenli şekilde burada depolanır." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions Side Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">
                        <TextBlock Text="Karantina Yönetimi" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedItem.FileName}" Style="{StaticResource SectionHeadingStyle}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.FileSize, Converter={StaticResource BytesConverter}, StringFormat='Boyut: \{0\}'}" 
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

                            <!-- Original Path -->
                            <Grid Margin="0,8,0,4">
                                <TextBlock Text="Orijinal Konum" Style="{StaticResource SectionHeadingStyle}" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Kopyala" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"
                                        Command="{Binding CopyOriginalPathCommand}"/>
                            </Grid>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                <TextBox Text="{Binding SelectedItem.OriginalPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         TextWrapping="Wrap" Style="{StaticResource DataMonospaceTextBoxStyle}"/>
                            </Border>

                            <!-- SHA-256 Hash -->
                            <Grid Margin="0,10,0,4">
                                <TextBlock Text="SHA-256 Karması" Style="{StaticResource SectionHeadingStyle}" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Kopyala" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"
                                        Command="{Binding CopySha256Command}"/>
                            </Grid>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                <TextBox Text="{Binding SelectedItem.SHA256, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         TextWrapping="Wrap" Style="{StaticResource DataMonospaceTextBoxStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </Border>

                            <!-- Reason Box -->
                            <TextBlock Text="Karantinaya Alınma Sebebi" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,12,0,4"/>
                            <Border Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,2">
                                <TextBlock Text="{Binding SelectedItem.Reason}" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushStatusWarningText}"/>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,20,0,0">
                                <Button Content="Dosyayı Geri Yükle" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding RestoreItemCommand}" Margin="0,0,0,8"/>
                                <Button Content="Kalıcı Olarak Sil" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding DeleteItemCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="İncelemek veya geri yüklemek için listeden bir dosya seçin." 
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
