<Page x:Class="AegisPC.App.Views.QuarantineView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Karantina &amp; Olaylar" Margin="0,0,0,4"/>
                <TextBlock Text="Karantinaya alınan şüpheli/zararlı dosyaları yönetin ve EDR güvenlik olay geçmişini inceleyin." 
                           Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <Button Grid.Column="1" HorizontalAlignment="Right" Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding RefreshAllDataCommand}" VerticalAlignment="Center" Padding="14,6"/>
        </Grid>

        <!-- 2. Segmented Tab Selector -->
        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SelectQuarantineTabCommand}" Cursor="Hand" Padding="16,8" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuarantineTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Karantina Kasası" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuarantinedItems.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectIncidentsTabCommand}" Cursor="Hand" Padding="16,8" BorderThickness="0" Margin="6,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIncidentsTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tehdit ve Olay Geçmişi (EDR)" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushStatusDangerBg}" BorderBrush="{DynamicResource BrushStatusDangerBorder}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Incidents.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushStatusDangerText}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. TAB CONTENT AREA -->
        <!-- TAB 1: Karantina Kasası -->
        <Grid Grid.Row="2" Visibility="{Binding IsQuarantineTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Quarantine Grid -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                    <ui:DataGrid ItemsSource="{Binding QuarantinedItems}" 
                                 SelectedItem="{Binding SelectedItem}"
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True"
                                 SelectionMode="Single"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowHeaderWidth="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 GridLinesVisibility="Horizontal"
                                 HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                        <ui:DataGrid.Columns>
                            <!-- Dosya Adı -->
                            <DataGridTemplateColumn Header="Dosya Adı" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding OriginalPath}" 
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Boyut -->
                            <DataGridTemplateColumn Header="Boyut" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource BytesConverter}}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Karantina Zamanı -->
                            <DataGridTemplateColumn Header="Karantina Zamanı" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QuarantinedAt, StringFormat='\{0:yyyy-MM-dd HH:mm\}'}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Sebep -->
                            <DataGridTemplateColumn Header="Sebep" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" 
                                                   Style="{StaticResource DataTableStyle}"
                                                   Foreground="{DynamicResource BrushStatusDangerText}"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding Reason}" 
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Border>

                <!-- Empty State Overlay -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding HasNoQuarantinedItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="44" Foreground="{DynamicResource BrushStatusSafe}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Karantinada dosya bulunmuyor" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sisteminiz temiz — tespit edilen tehditler güvenli şekilde burada depolanır." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions Side Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel Margin="4">
                        <TextBlock Text="Karantina Yönetimi" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedItem.FileName}" Style="{StaticResource SectionHeadingStyle}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.FileSize, Converter={StaticResource BytesConverter}, StringFormat='Boyut: \{0\}'}" 
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

                            <!-- Original Path -->
                            <Grid Margin="0,8,0,4">
                                <TextBlock Text="Orijinal Konum" Style="{StaticResource SectionHeadingStyle}" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Kopyala" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"
                                        Command="{Binding CopyOriginalPathCommand}"/>
                            </Grid>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                <TextBox Text="{Binding SelectedItem.OriginalPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         TextWrapping="Wrap" Style="{StaticResource DataMonospaceTextBoxStyle}"/>
                            </Border>

                            <!-- SHA-256 Hash -->
                            <Grid Margin="0,10,0,4">
                                <TextBlock Text="SHA-256 Karması" Style="{StaticResource SectionHeadingStyle}" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Kopyala" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"
                                        Command="{Binding CopySha256Command}"/>
                            </Grid>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                <TextBox Text="{Binding SelectedItem.SHA256, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         TextWrapping="Wrap" Style="{StaticResource DataMonospaceTextBoxStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </Border>

                            <!-- Reason Box -->
                            <TextBlock Text="Karantinaya Alınma Sebebi" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,12,0,4"/>
                            <Border Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,2">
                                <TextBlock Text="{Binding SelectedItem.Reason}" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushStatusWarningText}"/>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,20,0,0">
                                <Button Content="Dosyayı Geri Yükle" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding RestoreItemCommand}" Margin="0,0,0,8"/>
                                <Button Content="Kalıcı Olarak Sil" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding DeleteItemCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="İncelemek veya geri yüklemek için listeden bir dosya seçin." 
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- TAB 2: Tehdit ve Olay Geçmişi (EDR) -->
        <Grid Grid.Row="2" Visibility="{Binding IsIncidentsTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Incident List -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,16,0" Padding="14">
                <Grid>
                    <ListBox ItemsSource="{Binding Incidents}" 
                             SelectedItem="{Binding SelectedIncident}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding ThreatName}" Style="{StaticResource SectionHeadingStyle}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgeDangerStyle}" Padding="6,2">
                                                <TextBlock Text="{Binding RiskScore, StringFormat='Risk: {0}'}" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusDangerText}"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding RootProcessName, StringFormat='Süreç: {0}'}" Style="{StaticResource DataTableStyle}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                        
                                        <Grid Grid.Row="2" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='\{0:HH:mm:ss\}'}" Style="{StaticResource CaptionTextStyle}"/>
                                            <Border HorizontalAlignment="Right" Style="{StaticResource BadgeProgressStyle}" Padding="6,1">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <Border Background="{DynamicResource BrushCardBg}" Visibility="{Binding HasNoIncidents, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="40" Foreground="{DynamicResource BrushStatusSafe}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Aktif Tehdit Olayı Yok" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sisteminiz arka planda gerçek zamanlı korunuyor." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Incident Details & Timeline -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0" Padding="20">
                <Grid>
                    <!-- Detail Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Visibility="{Binding SelectedIncident, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedIncident}">
                            <!-- Incident Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageHeadingStyle}" FontSize="18"/>
                                    <TextBlock Text="{Binding IncidentId, StringFormat='Olay Kimliği: {0}'}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{DynamicResource BrushStatusDanger}" CornerRadius="4" Padding="12,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding RiskScore, StringFormat='Risk Skoru: {0}/100'}" Style="{StaticResource ButtonTextStyle}" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>

                            <!-- Key Metadata Grid -->
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Kök Süreç:" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="{Binding RootProcessName}" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                        <TextBlock Text="Müdahale:" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding ActionTaken}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushStatusSafeDark}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PID / Süreç No:" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="{Binding RootPid}" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                        <TextBlock Text="Durum:" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- File Path -->
                            <TextBlock Text="Zararlı Kaynak Dosya Yolu:" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,16">
                                <TextBlock Text="{Binding RootExecutablePath}" Style="{StaticResource DataMonospaceStyle}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Timeline -->
                            <TextBlock Text="Kronolojik Saldırı Zaman Çizelgesi:" Style="{StaticResource SectionHeadingStyle}" FontSize="13" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Timeline}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" Style="{StaticResource DataTableStyle}" FontSize="11.5"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Plain Turkish Explanation -->
                            <TextBlock Text="Güvenlik Analizi ve Açıklama:" Style="{StaticResource SectionHeadingStyle}" FontSize="13" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource BrushStatusDangerBg}" BorderBrush="{DynamicResource BrushStatusDangerBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <TextBlock Text="{Binding HumanExplanation}" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushStatusDangerText}" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Kaynak Dosyayı Karantinaya Al" 
                                        Command="{Binding DataContext.QuarantineSourceFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Style="{StaticResource DangerActionButtonStyle}" Margin="0,0,10,0" Padding="16,8"/>
                                <Button Content="Çözüldü Olarak İşaretle" 
                                        Command="{Binding DataContext.RemediateIncidentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty Placeholder when no incident is selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding SelectedIncident, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="36" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="İncelemek için soldaki listeden bir güvenlik olayı seçin." 
                                   Style="{StaticResource SectionHeadingStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
