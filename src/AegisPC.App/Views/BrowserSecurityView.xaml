<Page x:Class="AegisPC.App.Views.BrowserSecurityView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:RiskLevelToColorConverter x:Key="RiskColorConverter"/>
        <conv:BoolToStatusTextConverter x:Key="BoolToStatus"/>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Tarayıcı Güvenliği ve Eklenti Analizi" Margin="0,0,0,4"/>

        <!-- 2. Profile Selector / Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="36" Style="{DynamicResource DefaultComboBoxStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BrowserType}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ProfileName}" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="2" Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding LoadBrowserDataCommand}" Padding="14,6"/>
        </Grid>

        <!-- 3. Main Content (Extensions Table + Details) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Table (Strict DataTableStyle: Pure Sans-Serif) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,16,0">
                <ui:DataGrid ItemsSource="{Binding Extensions}" 
                             SelectedItem="{Binding SelectedExtension}"
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             RowHeaderWidth="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Header="Risk Seviyesi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{Binding RiskLevel, Converter={StaticResource RiskColorConverter}}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Eklenti Adı" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sürüm" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource DataTableStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Harici (Sideload)" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsSideloaded, Converter={StaticResource BoolToStatus}, ConverterParameter=yesno}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Eklenti ID" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource DataMonospaceStyle}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" Padding="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel Margin="4">
                        <TextBlock Text="Eklenti Güvenlik İncelemesi" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedExtension, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedExtension.Name}" Style="{StaticResource SectionHeadingStyle}" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedExtension.Version, StringFormat='Sürüm: \{0\}'}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <TextBlock Text="Risk Durumu: " Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Text="{Binding SelectedExtension.RiskLevel}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{Binding SelectedExtension.RiskLevel, Converter={StaticResource RiskColorConverter}}"/>
                            </StackPanel>

                            <TextBlock Text="Açıklama" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedExtension.Description}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,2"/>

                            <TextBlock Text="İstenen İzinler" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding SelectedExtension.Permissions}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• \{0\}'}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Risk Reasons -->
                            <TextBlock Text="Güvenlik Bulguları" Style="{StaticResource SectionHeadingStyle}" FontSize="12" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding SelectedExtension.RiskReasons}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="• " Foreground="{DynamicResource BrushStatusWarning}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="Detayları görmek için listeden bir eklenti seçin." 
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedExtension}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
