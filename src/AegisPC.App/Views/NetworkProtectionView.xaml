<Page x:Class="AegisPC.App.Views.NetworkProtectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1050"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="32,24,32,32">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Ağ, DNS ve Web Güvenlik Kalkanı" Margin="0,0,0,4"/>
                <TextBlock Text="DNS sızıntılarını önleyin, zararlı web sitelerini engelleyin ve ağ güvenliğinizi pekiştirin." FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- CARD 1: DNS HARDENING & ADAPTERS -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="GlobeShield24" Foreground="#2563EB" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ağ Bağdaştırıcıları ve Güvenli DNS Yapılandırması" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Yenile" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,4"/>
                    </Grid>

                    <!-- Adapters List -->
                    <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Router24" Foreground="#0284C7" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProviderName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DnsServers[0], FallbackValue='Otomatik DNS'}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick DNS Change Buttons -->
                    <TextBlock Text="Tek Tıkla Güvenli DNS Sunucusuna Geçiş Yapın:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="🛡️ Quad9 Zararlı Engelleyici (9.9.9.9)" Command="{Binding SetDnsQuad9Command}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                        <Button Content="⚡ Cloudflare Hızlı DNS (1.1.1.1)" Command="{Binding SetDnsCloudflareCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                        <Button Content="🔄 Varsayılana Sıfırla (DHCP)" Command="{Binding SetDnsDhcpCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- CARD 2: HOSTS SINKHOLE & INTEGRITY -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldLock24" Foreground="#10B981" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Hosts Bütünlüğü &amp; Zararlı Domain Sinkhole" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding HostsStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="🛡️ Zararlı Domain Kalkanını Uygula (Sinkhole)" Command="{Binding ApplySinkholeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="16,8"/>
                        <Button Content="Kaldır" Command="{Binding RemoveSinkholeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CARD 3: INTERACTIVE URL / PHISHING ANALYZER -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Search24" Foreground="#DC2626" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Gerçek Zamanlı Web &amp; Phishing URL Analizcisi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding TestUrlInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Analiz edilecek bağlantıyı girin (ör: https://example.com)" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Güvenlik Analizi Yap" Command="{Binding AnalyzeUrlCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"/>
                    </Grid>

                    <!-- Result Panel -->
                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,4,0,0"
                            Visibility="{Binding HasAnalysisResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Alan Adı: " FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding AnalysisVerdict.Host}" FontSize="13" Foreground="#2563EB"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#FEE2E2" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="{Binding AnalysisVerdict.RiskScore, StringFormat='Risk Skoru: {0}/100'}" FontWeight="Bold" FontSize="12" Foreground="#DC2626"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding AnalysisVerdict.Recommendation}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding AnalysisVerdict.DetectionReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11.5" Foreground="#991B1B" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status Feedback -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="#059669" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,24"/>
        </StackPanel>
    </ScrollViewer>
</Page>

