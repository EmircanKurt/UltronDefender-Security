<Page x:Class="AegisPC.App.Views.NetworkProtectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1050"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Margin="28,20,28,28">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Ağ, DNS ve Web Güvenlik Kalkanı" Margin="0,0,0,4"/>
                <TextBlock Text="DNS sızıntılarını önleyin, zararlı web sitelerini engelleyin ve ağ güvenliğinizi pekiştirin." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- 2. CARD 1: DNS HARDENING & ADAPTERS -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="GlobeShield24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ağ Bağdaştırıcıları ve Güvenli DNS Yapılandırması" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Yenile" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,4"/>
                    </Grid>

                    <!-- Adapters List (Selectable ListBox with Active Gateway & Selection Highlight) -->
                    <ListBox ItemsSource="{Binding Adapters}" 
                             SelectedItem="{Binding SelectedAdapter}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,0,0,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource BrushAppBg}" 
                                                    BorderBrush="{DynamicResource BrushCardBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="14,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushCardBg}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Router24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                            <Border Style="{StaticResource BadgeBlueStyle}" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusInfoText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeGreenStyle}" Padding="6,1" Margin="6,0,0,0"
                                                    Visibility="{Binding HasInternetGateway, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="AKTİF İNTERNET" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusSafeText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProviderName}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DnsServers[0], FallbackValue='Otomatik DNS'}" Style="{StaticResource DataMonospaceStyle}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Quick DNS Change Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Seçili Bağdaştırıcıya Güvenli DNS Uygula:" Style="{StaticResource SectionHeadingStyle}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedAdapter.Name, StringFormat=' ({0})', FallbackValue=' (Bağdaştırıcı seçilmedi)'}" Style="{StaticResource SectionHeadingStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="Quad9 Zararlı Engelleyici (9.9.9.9)" Command="{Binding SetDnsQuad9Command}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                        <Button Content="Cloudflare Hızlı DNS (1.1.1.1)" Command="{Binding SetDnsCloudflareCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                        <Button Content="Varsayılana Sıfırla (DHCP)" Command="{Binding SetDnsDhcpCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="12,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. CARD 2: HOSTS SINKHOLE & INTEGRITY -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldLock24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Hosts Bütünlüğü &amp; Zararlı Domain Sinkhole" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding HostsStatusText}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Zararlı Domain Kalkanını Uygula (Sinkhole)" Command="{Binding ApplySinkholeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="16,8"/>
                        <Button Content="Kaldır" Command="{Binding RemoveSinkholeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. CARD 3: INTERACTIVE URL / PHISHING ANALYZER -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Gerçek Zamanlı Web &amp; Phishing URL Analizcisi" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding TestUrlInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Analiz edilecek bağlantıyı girin (ör: https://example.com)" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Güvenlik Analizi Yap" Command="{Binding AnalyzeUrlCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"/>
                    </Grid>

                    <!-- Result Panel -->
                    <Border Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,4,0,0"
                            Visibility="{Binding HasAnalysisResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Alan Adı: " Style="{StaticResource SectionHeadingStyle}" FontSize="13"/>
                                    <TextBlock Text="{Binding AnalysisVerdict.Host}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Style="{StaticResource BadgeDangerStyle}" Padding="8,2">
                                    <TextBlock Text="{Binding AnalysisVerdict.RiskScore, StringFormat='Risk Skoru: {0}/100'}" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusDangerText}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding AnalysisVerdict.Recommendation}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding AnalysisVerdict.DetectionReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusDangerText}" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Status Feedback -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusSafeDark}" FontWeight="SemiBold" Margin="0,4,0,24"/>
        </StackPanel>
    </ScrollViewer>
</Page>
