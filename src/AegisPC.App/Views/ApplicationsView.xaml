<Page x:Class="AegisPC.App.Views.ApplicationsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Yüklü Uygulamalar ve Programlar" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="Uygulama adı veya yayımcı ile filtrele..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding LoadApplicationsCommand}" Margin="0,0,8,0" Padding="14,6"/>
                <Button Content="Uygulamayı Kaldır" Style="{StaticResource DangerButtonStyle}" 
                        Command="{Binding UninstallApplicationCommand}"
                        IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}" Padding="14,6"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <ui:DataGrid Grid.Column="0" ItemsSource="{Binding Applications}" 
                         SelectedItem="{Binding SelectedApp}"
                         AutoGenerateColumns="False" IsReadOnly="True"
                         SelectionMode="Single" Margin="0,0,16,0">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding DisplayName}" Width="240"/>
                    <DataGridTextColumn Header="Yayımcı" Binding="{Binding Publisher}" Width="160"/>
                    <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" Width="90"/>
                    <DataGridTextColumn Header="Boyut (KB)" Binding="{Binding EstimatedSizeKB, StringFormat='\{0:N0\} KB'}" Width="100"/>
                    <DataGridTextColumn Header="Yükleme Tarihi" Binding="{Binding InstallDate, StringFormat='\{0:yyyy-MM-dd\}'}" Width="110"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Uygulama Detayı" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedApp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedApp.DisplayName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Text="Yayımcı:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedApp.Publisher, TargetNullValue='Bilinmiyor'}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Sürüm:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedApp.Version, TargetNullValue='Bilinmiyor'}" Margin="0,0,0,8"/>

                            <TextBlock Text="Kurulum Konumu:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedApp.InstallLocation, TargetNullValue='N/A'}" TextWrapping="Wrap" Margin="0,0,0,8" FontFamily="Consolas"/>

                            <TextBlock Text="Kayıt Kaynağı:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedApp.RegistrySource}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>

                            <Button Content="Windows ile Kaldır" Margin="0,16,0,0" 
                                   Style="{StaticResource DangerButtonStyle}"
                                   Command="{Binding UninstallApplicationCommand}" HorizontalAlignment="Stretch" Padding="12,8"/>
                        </StackPanel>

                        <TextBlock Text="Detayları görüntülemek ve kaldırmak için soldaki listeden bir program seçin."
                                   Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedApp, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"/>
    </Grid>
</Page>

