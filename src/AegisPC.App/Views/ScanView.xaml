<Page x:Class="AegisPC.App.Views.ScanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActiveTabHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" 
                  Margin="28,20,28,28" 
                  Focusable="False" 
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,20">

            <!-- ══════════════════════════════════════════════════════
                 1. TOP TAB NAVIGATION BAR (Tarayıcı | Zamanlayıcı | Raporlar)
            ══════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Target24" Foreground="#0284C7" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tarayıcı" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,28,0" VerticalAlignment="Center"/>

                        <!-- Tabs -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Tarayıcı" Style="{StaticResource ActiveTabHeaderStyle}"/>
                                <Rectangle Height="2.5" Fill="#0284C7" Margin="0,4,0,0" RadiusX="1" RadiusY="1"/>
                            </StackPanel>
                            <TextBlock Text="Zamanlayıcı" Style="{StaticResource TabHeaderStyle}"/>
                            <TextBlock Text="Raporlar" Style="{StaticResource TabHeaderStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 2. SCAN MODE SELECTION CARDS
            ══════════════════════════════════════════════════════ -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- Quick Scan -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="#0284C7" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Hızlı Tarama" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="İndirilenler, Temp, Masaüstü ve başlangıç noktaları gibi en yaygın tehdit konumlarını hızlıca analiz eder." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" LineHeight="17" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Hızlı Taramayı Başlat" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding StartQuickScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Full Scan -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#0284C7" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Tam Sistem Taraması" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Tüm sabit disklerdeki bütün dosyaları, IFEO kaçırmalarını, Hosts dosyası ve bellek enjeksiyonlarını derinlemesine tarar." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" LineHeight="17" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Tam Taramayı Başlat" Style="{StaticResource PrimaryButtonStyle}" Background="#0284C7"
                                Command="{Binding StartFullScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Custom Scan -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="#D97706" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Özel Dizin Taraması" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Seçeceğiniz belirli bir klasörü, crackli oyun dizinini veya USB depolama birimini analiz eder." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" LineHeight="17" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Klasör Seç ve Tara" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding StartCustomScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════
                 3. SCAN STATUS & ACTIVE SCAN WINDOW LAUNCHER
            ══════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#F0F9FF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Shield24" Foreground="#0284C7" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tarama Durumu" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding ScanStatusText}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Tarayıcı Penceresini Aç" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenActiveScanWindowCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
