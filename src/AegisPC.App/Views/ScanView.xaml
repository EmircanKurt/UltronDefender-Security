<Page x:Class="AegisPC.App.Views.ScanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" 
                  Margin="28,20,28,24" 
                  Focusable="False" 
                  CanContentScroll="False"
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,20">

            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Virüs ve Zararlı Yazılım Taraması" Margin="0,0,0,4"/>
                <TextBlock Text="Sisteminizi hızlı, tam veya özel klasör seçenekleriyle derinlemesine analiz edin." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════
                 2. SCAN MODE SELECTION CARDS
            ══════════════════════════════════════════════════════ -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- Quick Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Hızlı Tarama" Style="{StaticResource SectionHeadingStyle}" FontSize="15"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="İndirilenler, Temp, Masaüstü ve başlangıç noktaları gibi en yaygın tehdit konumlarını hızlıca analiz eder." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Hızlı Taramayı Başlat" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding StartQuickScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Full Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Tam Sistem Taraması" Style="{StaticResource SectionHeadingStyle}" FontSize="15"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Tüm sabit disklerdeki bütün dosyaları, IFEO kaçırmalarını, Hosts dosyası ve bellek enjeksiyonlarını derinlemesine tarar." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Tam Taramayı Başlat" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding StartFullScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- Custom Scan -->
                <Border Style="{StaticResource MetricCardStyle}" Margin="0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Özel Dizin Taraması" Style="{StaticResource SectionHeadingStyle}" FontSize="15"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Seçeceğiniz belirli bir klasörü, crackli oyun dizinini veya USB depolama birimini analiz eder." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14"/>
                        <Button Grid.Row="2" Content="Klasör Seç ve Tara" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding StartCustomScanCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════
                 3. SCAN STATUS & ACTIVE SCAN WINDOW LAUNCHER
            ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Background="{DynamicResource BrushStatusInfoBg}" BorderBrush="{DynamicResource BrushStatusInfoBorder}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tarama Durumu" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="{Binding ScanStatusText}" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Tarayıcı Penceresini Aç" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenActiveScanWindowCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
