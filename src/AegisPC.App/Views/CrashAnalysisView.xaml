<Page x:Class="AegisPC.App.Views.CrashAnalysisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeadingStyle}" Text="Windows Çökme ve Donma Teşhis Merkezi" Margin="0,0,0,4"/>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Son 7 gün içindeki uygulama çökmeleri, donmalar ve beklenmeyen sistem kapanmaları:" 
                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Content="Yenile" Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding LoadCrashesCommand}" Padding="14,6"/>
        </Grid>

        <!-- 3. Content (List + Incident Report) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Crash Events List (Strict DataTableStyle: Pure Sans-Serif) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                    <ui:DataGrid ItemsSource="{Binding Crashes}" 
                                 SelectedItem="{Binding SelectedCrash}"
                                 AutoGenerateColumns="False" 
                                 IsReadOnly="True"
                                 SelectionMode="Single"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowHeaderWidth="0"
                                 GridLinesVisibility="Horizontal"
                                 HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}">
                        <ui:DataGrid.Columns>
                            <DataGridTemplateColumn Header="Zaman" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OccurredAt, StringFormat='\{0:MM-dd HH:mm\}'}" Style="{StaticResource DataTableStyle}" Padding="6,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Olay Türü" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EventType}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushStatusDangerText}" Padding="6,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Uygulama" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ApplicationName}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Padding="6,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Border>

                <!-- Empty State Overlay -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding HasNoCrashes, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="44" Foreground="{DynamicResource BrushStatusSafe}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Uygulama çökmesi tespit edilmedi" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Son 7 günde herhangi bir uygulama çökmesi kaydedilmedi." 
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Diagnostic Report & Timeline -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">
                        <TextBlock Text="Olay Teşhis Raporu" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedCrashReport, Converter={StaticResource BoolToVis}}">
                            <!-- Incident Summary Header -->
                            <Border Background="{DynamicResource BrushBrandMinimal}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCrashReport.Summary}" Style="{StaticResource SectionHeadingStyle}" FontSize="14" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Teşhis Güvenilirlik Seviyesi: " Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="{Binding SelectedCrashReport.ConfidenceLevel}" Style="{StaticResource DataTableStyle}" FontWeight="Bold" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Incident Timeline -->
                            <TextBlock Text="Olay Zaman Çizelgesi (Timeline)" Style="{StaticResource SectionHeadingStyle}" FontSize="13" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.TimelineEntries}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='\{0:HH:mm:ss\}'}" Style="{StaticResource DataMonospaceStyle}" VerticalAlignment="Center"/>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource BrushStatusDanger}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushAppBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Contributing Factors -->
                            <TextBlock Text="Potansiyel Katkıda Bulunan Faktörler" Style="{StaticResource SectionHeadingStyle}" FontSize="13" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.ContributingFactors}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="• " Foreground="{DynamicResource BrushStatusWarning}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recommended Actions -->
                            <TextBlock Text="Önerilen Eylemler" Style="{StaticResource SectionHeadingStyle}" FontSize="13" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.RecommendedActions}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource BrushStatusSafe}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Selection Placeholder -->
                        <TextBlock Text="Teşhis raporunu incelemek için sol listeden bir çökme olayı seçin." 
                                   HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCrashReport}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </Grid>
</Page>
