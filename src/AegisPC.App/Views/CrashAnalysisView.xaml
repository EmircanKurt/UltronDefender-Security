<Page x:Class="AegisPC.App.Views.CrashAnalysisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Background="#EEF2F6"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Text="Windows Çökme ve Donma Teşhis Merkezi" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Son 7 gün içindeki uygulama çökmeleri, donmalar ve beklenmeyen sistem kapanmaları:" Foreground="#64748B" VerticalAlignment="Center"/>
            <ui:Button HorizontalAlignment="Right" Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" 
                       Command="{Binding LoadCrashesCommand}"/>
        </Grid>

        <!-- Content (List + Incident Report) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Crash Events List -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <ui:DataGrid ItemsSource="{Binding Crashes}" 
                             SelectedItem="{Binding SelectedCrash}"
                             AutoGenerateColumns="False" IsReadOnly="True"
                             SelectionMode="Single">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="Zaman" Binding="{Binding OccurredAt, StringFormat='\{0:MM-dd HH:mm\}'}" Width="110"/>
                        <DataGridTextColumn Header="Olay Türü" Binding="{Binding EventType}" Width="110"/>
                        <DataGridTextColumn Header="Uygulama" Binding="{Binding ApplicationName}" Width="*"/>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Empty State Overlay -->
                <Border Background="#EEF2F6" Visibility="{Binding HasNoCrashes, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Uygulama çökmesi tespit edilmedi" FontSize="18" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Foreground="#0F172A"/>
                        <TextBlock Text="Son 7 günde herhangi bir uygulama çökmesi kaydedilmedi." 
                                   FontSize="13" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Diagnostic Report & Timeline -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Olay Teşhis Raporu" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedCrashReport, Converter={StaticResource BoolToVis}}">
                            <!-- Incident Summary Header -->
                            <Border Background="#EBF7F6" BorderBrush="#E0EBEA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCrashReport.Summary}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Teşhis Güvenilirlik Seviyesi: " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedCrashReport.ConfidenceLevel}" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Incident Timeline -->
                            <TextBlock Text="Olay Zaman Çizelgesi (Timeline)" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.TimelineEntries}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='\{0:HH:mm:ss\}'}" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#DC2626" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#EEF2F6" BorderBrush="#E0EBEA" BorderThickness="1" CornerRadius="4" Padding="8" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#475569" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Contributing Factors -->
                            <TextBlock Text="Potansiyel Katkıda Bulunan Faktörler" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.ContributingFactors}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="• " Foreground="#D97706" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#475569"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recommended Actions -->
                            <TextBlock Text="Önerilen Eylemler" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedCrashReport.RecommendedActions}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="#10B981" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#475569"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Teşhis raporunu incelemek için sol listeden bir çökme olayı seçin." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCrashReport}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</Page>
