<Page x:Class="AegisPC.App.Views.UltronProtectionCentreView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:AegisPC.App.Helpers"
      Title="Ultron AI Koruma Merkezi" Background="{DynamicResource BrushAppBg}">
    <ScrollViewer helpers:WheelScrollHelper.EnableRootRedirect="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="28" MaxWidth="940" HorizontalAlignment="Left">
            <TextBlock Text="Korumalar" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="Ultron AI ve arka plan izleme bileşenlerinin durumu." Margin="0,8,0,24" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="Durumu yenile" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8"/>
                <Button Content="Koruma ayarlarını aç" Command="{Binding OpenProtectionSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="Gerçek zamanlı koruma" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding ProtectionStatus}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding CoverageStatus}" TextWrapping="Wrap" Margin="0,0,0,24" Foreground="{DynamicResource BrushTextSecondary}"/>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Uzak erişim · AFK gözlemi" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding RemoteLayerStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Wi-Fi · Bluetooth" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding WirelessLayerStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Ultron Filter" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding FilterLayerStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Kanıt ve karar" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding EvidenceStatus}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Margin="0,0,0,24" Foreground="{DynamicResource BrushTextSecondary}"/>
            <TextBlock Text="Bağımsız Guardian" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding GuardianStatus}" TextWrapping="Wrap" Margin="0,8,0,24" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="Yüksek CPU, uzak bağlantı veya çökme tek başına malware değildir. Tema rengi tehlike göstergesi değildir. Müdahale hatası engelleme başarısı diye raporlanmaz." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
