<Page x:Class="AegisPC.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="OnPagePreviewMouseWheel">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" 
                  Margin="28,20,28,28"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="True">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Uygulama ve Güvenlik Ayarları" Margin="0,0,0,4"/>
                <TextBlock Text="Koruma kalkanları, bildirimler ve tarama zamanlamasını yapılandırın." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- 2. Protection Warning Alert Card (Strict Crimson Red) -->
            <Border Background="{DynamicResource BrushStatusDangerBg}" BorderBrush="{DynamicResource BrushStatusDangerBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20"
                    Visibility="{Binding IsProtectionWarningVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BrushStatusDanger}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProtectionWarningText}" Foreground="{DynamicResource BrushStatusDangerText}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Core Protection Layer -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Temel Güvenlik Kalkanları" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: File Protection -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Gerçek Zamanlı Dosya Koruması" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="İndirilen ve oluşturulan dosyaları anlık olarak tarar ve tehditleri engeller." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsFileProtectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 2: Ransomware Shield -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Fidye Yazılımı Kalkanı (Ransomware Shield)" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Kritik kullanıcı belgelerini izler, canary tuzak dosyalarıyla şifreleme girişimlerini durdurur." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsRansomwareShieldEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 3: Process Monitoring -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Süreç ve Bellek İzleme" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Çalışan arka plan süreçlerini analiz eder ve şüpheli davranışları raporlar." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsProcessMonitoringEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 4: Game & Crack Sandbox Watchdog -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮 Oyun &amp; Crack Koruma Kalkanı (Sandbox Watchdog)" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeSafeStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="AKILLI" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusSafeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Korsan/Crack oyunların Belgelerim/Save kayıtlarına izin verir; gizli dropper ve şifre çalma hareketlerini anında engeller." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsGameCrackWatchdogEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 5: Network Protection -->
                    <Grid Margin="0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ağ, DNS ve Web Kalkanı" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeProgressStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="DNS/WEB" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushBrandPrimary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Zararlı web siteleri, phishing alan adları ve DNS tabanlı tehdit filtreleme kalkanı." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsNetworkProtectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Notifications & Telemetry -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="AlertBadge24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bildirimler ve Telemetri" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Kritik Tehdit Bildirimleri" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Tehdit tespit edildiğinde veya engellendiğinde bildirim gösterir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Gerçek Zamanlı Donanım İzleme" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="CPU, RAM, Disk ve Ağ kullanım oranlarını anlık hesaplar." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsRealTimeMonitoringEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Scheduled Scanning -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Calendar24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Zamanlanmış Güvenlik Taraması" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Otomatik Rutin Tarama" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Belirlenen zaman aralıklarında otomatik hızlı tarama gerçekleştirir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding ScanScheduleEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,160,0">
                            <TextBlock Text="Tarama Saati (Günlük Başlangıç)" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Günlük tam taramanın veya ilk döngünün başlayacağı saat dilimi." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ScanHours}" 
                                  SelectedItem="{Binding SelectedScanHourString}" 
                                  Width="150" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{DynamicResource DefaultComboBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                            <TextBlock Text="Tarama Tekrar Periyodu" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Arka planda rutin güvenlik taramasının hangi sıklıkla yürütüleceği." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ScanPeriods}" 
                                  SelectedItem="{Binding SelectedScanPeriod}" 
                                  Width="240" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{DynamicResource DefaultComboBoxStyle}"/>
                    </Grid>

                    <!-- 30-Minute Frequent Scan Warning Alert Banner -->
                    <Border Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0"
                            Visibility="{Binding IsFrequentScanWarningVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="⚠️ Dikkat: 30 dakikada bir tarama periyodu güvenlik düzeyini en üst seviyeye çıkarır ancak eski veya düşük donanımlı sistemlerde disk ve CPU işlemlerini sıklaştırabilir." 
                                       Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusWarningText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 6. Appearance & Updates -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,24" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource BrushTextMuted}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Genel ve Güncelleme" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Otomatik İmza ve Kural Güncellemesi" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Yeni zararlı yazılım imzalarını arka planda otomatik indirir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsAutoUpdateEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding LastUpdateCheck}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 7. Save Action Button & Status Feedback -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" 
                        Content="Ayarları Kaydet" 
                        Padding="24,10"
                        Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusSafeDark}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
