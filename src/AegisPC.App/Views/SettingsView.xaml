<Page x:Class="AegisPC.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      xmlns:helpers="clr-namespace:AegisPC.App.Helpers"
      xmlns:controls="clr-namespace:AegisPC.App.Controls"
      Title="{Binding PageTitle}"
      Background="{DynamicResource BrushAppBg}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" 
                  helpers:WheelScrollHelper.EnableRootRedirect="True"
                  Margin="28,20,28,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="True">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <!-- 1. Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="Uygulama ve Güvenlik Ayarları" Margin="0,0,0,4"/>
                <TextBlock Text="Koruma kalkanları, bildirimler ve tarama zamanlamasını yapılandırın." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Connection information is not a malware or activation alert. -->
            <Border BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20"
                    Visibility="{Binding IsProtectionWarningVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProtectionWarningSeverity}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource BrushStatusWarningBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusWarningBorder}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource BrushTextSecondary}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProtectionWarningTitle}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProtectionWarningText}" Foreground="{DynamicResource BrushTextSecondary}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Durumu Yenile" Command="{Binding RefreshProtectionStatusCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Core Protection Layer -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrushStatusSafe}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Gerçek Zamanlı Güvenlik Kalkanları" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: File Protection -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Gerçek Zamanlı Dosya Koruması" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="İzlenen köklerde dosya değişiminden sonra içerik inceler; ön-erişim engelleme değildir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsFileProtectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 2: Ransomware Shield -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Fidye Yazılımı Kalkanı (Ransomware Shield)" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Kapsam dahilindeki belge değişimlerini ve canary olaylarını gözler; aktör doğrulanmadan otomatik süreç sonlandırmaz." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsRansomwareShieldEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Optional AI review is service-owned; the one-way switch cannot bypass its two approvals. -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Ultron AI — Ek Yerel İnceleme" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Dosya içeriğini ek kurallarla değerlendirir. Kapatma iki onay ister; diğer kalkanları kapatmaz."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding UltronAiStatusText}" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:ObservedProtectionSwitch IsChecked="{Binding IsUltronAiEnabled, Mode=OneWay}" Command="{Binding ToggleUltronAiCommand}"
                                  Style="{StaticResource BrandToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="Ultron AI ek yerel inceleme"
                                  ToolTip="Ayar yalnız hizmetin güncel yanıtıyla doğrulanır. Kapatmak için iki onay gerekir."/>
                    </Grid>

                    <!-- Row 3: Auto-Quarantine -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Otomatik Karantina Politika Motoru" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeSafeStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="ÖNERİLEN" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusSafeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Karantina politikası doğrulanmış zararlı kanıtı gerektirir; risk puanı tek başına engelleme yetkisi değildir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Eşik:" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                            <TextBox Width="50" Margin="0,0,12,0"
                                     Text="{Binding AutoQuarantineThreshold, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding EnableAutoQuarantine}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 4: Process Monitoring -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Süreç ve Bellek İzleme" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Süreç gözlemi dosya kalkanına bağlıdır. Bu ayrı anahtar henüz motora bağlı olmadığı için kullanılamaz." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="False" IsEnabled="False" ToolTip="Bağımsız süreç kalkanı anahtarı henüz bağlı değil."
                                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 4: Game & Crack Sandbox Watchdog -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Oyun / Mod İçeriği İncelemesi" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeSafeStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="AYRI MOTOR BAĞLI DEĞİL" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusSafeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Mod ve arşivler ortak dosya motoruyla incelenir. Ayrı sandbox/watchdog koruması bağlı değil; oyun adı güven kanıtı değildir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="False" IsEnabled="False" ToolTip="Bağımsız sandbox/watchdog motoru henüz bağlı değil."
                                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 5: Network Protection -->
                    <Grid Margin="0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ağ, DNS ve Web Kalkanı" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeBlueStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="DNS/WEB" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusInfoText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hizmetin DNS/ağ yardımcı katmanını yönetir; tüm ağ trafiğinin incelendiği anlamına gelmez." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsNetworkProtectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 6: Cloud Threat Reputation -->
                    <Grid Margin="0,14,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bulut Tehdit İstihbaratı ve Hash Doğrulama" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                                <Border Style="{StaticResource BadgeBlueStyle}" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="Bulut / Cloud" Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource BrushStatusInfoText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Bilinmeyen dosyaların SHA-256 özetini Abuse.ch MalwareBazaar küresel bulut istihbaratında anlık doğrular." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsCloudLookupEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Notifications & Telemetry -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="AlertBadge24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bildirimler ve Telemetri" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Kritik Tehdit ve Güvenlik Bildirimleri" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Açık olduğunda sistem tepsisi ve masaüstü uyarıları gösterilir. Kapatıldığında tüm bildirimler sessize alınır." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Gerçek Zamanlı Donanım İzleme" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="CPU, RAM, Disk ve Ağ kullanım oranlarını anlık hesaplar." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsRealTimeMonitoringEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Scheduled Scanning -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Calendar24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Zamanlanmış Güvenlik Taraması" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Otomatik Rutin Tarama" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Arka plan hizmeti bağlı ve ayar uygulanmışsa otomatik hızlı tarama yapar. Hizmet kullanıcının masaüstünü gözleyemediğinde düşük kaynak profili seçilir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding ScanScheduleEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,160,0">
                            <TextBlock Text="Tarama Saati (Günlük Başlangıç)" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Günlük hızlı taramanın saati. Saat kaçırılırsa aynı gün sonraki uygun kontrolde çalışır; saatlik tekrarlar son tamamlanmaya göre hesaplanır." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ScanHours}" 
                                  SelectedItem="{Binding SelectedScanHourString}" 
                                  IsEnabled="{Binding ScanScheduleEnabled}"
                                  Width="150" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{DynamicResource DefaultComboBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                            <TextBlock Text="Tarama Tekrar Periyodu" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Arka planda rutin güvenlik taramasının hangi sıklıkla yürütüleceği." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ScanPeriods}" 
                                  SelectedItem="{Binding SelectedScanPeriod}" 
                                  IsEnabled="{Binding ScanScheduleEnabled}"
                                  Width="240" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{DynamicResource DefaultComboBoxStyle}"/>
                    </Grid>

                    <!-- 30-Minute Frequent Scan Warning Alert Banner -->
                    <Border Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0"
                            Visibility="{Binding IsFrequentScanWarningVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="30 dakikada bir tarama, disk ve CPU yükünü sıklaştırabilir. Daha sık tarama daha yüksek tespit başarısını garanti etmez; günlük tarama çoğu kullanımda daha uygundur."
                                       Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusWarningText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5b. Adaptif Kaynak ve Performans Yönetimi (Adaptive Resource Management) -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Boşta (AFK) Güvenlik Taraması" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,12"/>
                    <CheckBox Content="Bilgisayar boşta olduğunda hızlı tarama yap" IsChecked="{Binding IdleScanEnabled}" Margin="0,0,0,10"/>
                    <CheckBox Content="Pil kullanırken boşta taramayı ertele" IsChecked="{Binding SkipIdleScanOnBattery}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Boşta bekleme (1–240 dakika):" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding IdleScanThresholdMinutes, UpdateSourceTrigger=LostFocus}" Width="70"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tekrarlama (1–168 saat):" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding IdleScanIntervalHours, UpdateSourceTrigger=LostFocus}" Width="70"/>
                    </StackPanel>
                    <TextBlock Text="Arka plan servisi gerektirir. Kullanıma geri dönüldüğünde yalnız boşta tarama iptal edilir; elle başlatılan taramaya dokunulmaz. Yoğun disk ve bellek yükünde ertelenir."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Pulse24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sistem Gereksinimleri" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                            <TextBlock Text="Tarama Kaynak Modu" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Otomatik mod sistem müsaitken hızlanır, yükte yavaşlar. 16 GB ve üzeri sistemlerde en fazla 2 GiB yararlı bellek bütçesi ve yaklaşık %40 CPU hedefi kullanılır; zorunlu tüketim değildir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ResourceModes}" 
                                  SelectedItem="{Binding SelectedResourceModeItem}" 
                                  DisplayMemberPath="Title"
                                  Width="260" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{DynamicResource DefaultComboBoxStyle}"/>
                    </Grid>

                    <!-- Selected Mode Description -->
                    <TextBlock Text="{Binding SelectedResourceModeItem.Description}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>

                    <!-- Resource Throttling Warning Banner (VeryLow / Low) -->
                    <Border Background="{DynamicResource BrushStatusWarningBg}" BorderBrush="{DynamicResource BrushStatusWarningBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0"
                            Visibility="{Binding IsResourceThrottlingWarningVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BrushStatusWarning}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="⚠️ Kaynak kullanımı kısıldı. Tarama işlemi daha uzun sürebilir." 
                                       Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushStatusWarningText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5c. Tarama Önbelleği Yönetimi (Scan Cache Management) -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Storage24" Foreground="{DynamicResource BrushStatusInfo}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tarama Önbelleği Yönetimi" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,160,0">
                            <TextBlock Text="Tarama ve İmza Doğrulama Önbelleği" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Daha önce taranmış değişmeyen dosyaların ve güvenilir dijital imzaların RAM önbelleğini sıfırlar. Bir sonraki tarama tüm dosyaları sıfırdan inceler." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="Tarama Önbelleğini Temizle" 
                                Command="{Binding ClearScanCacheCommand}" 
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="16,8"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5d. İstisnalar (Dışlanan Öğeler) Yönetimi -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ShieldDismiss24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="İstisnalar (Dışlanan Öğeler)" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="İstisna bir dosyanın güvenli olduğunu kanıtlamaz. Dosya ekleme yalnız seçilen içeriğin SHA-256 kimliğine bağlıdır; klasör istisnası gelecekteki dosyaları da kapsar. Servise yenileme isteği yönetici yetkisi gerektirir."
                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- Aksiyon Butonları -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Klasör Ekle" 
                                Command="{Binding AddFolderExclusionCommand}" 
                                Padding="14,7" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Dosya Ekle" 
                                Command="{Binding AddFileExclusionCommand}" 
                                Padding="14,7"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>

                    <!-- Boş Durum Bildirimi -->
                    <Border Background="{DynamicResource BrushCardBgAlt}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="16,12"
                            Visibility="{Binding HasNoExclusions, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                        <TextBlock Text="Henüz tanımlanmış bir istisna bulunmuyor." Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- İstisnalar Listesi -->
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="8,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BrushBrandMinimal}" BorderBrush="{DynamicResource BrushBrandSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushBrandPrimary}" FontWeight="Bold" FontSize="10.5"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource DataTableStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding AddedUtc, StringFormat='\{0:dd.MM.yyyy HH:mm\}'}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                        <Button Grid.Column="3" 
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="İstisnayı Sil"
                                                Width="30" Height="28" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                            <ui:SymbolIcon Symbol="Delete20" Foreground="{DynamicResource BrushStatusDanger}" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 6. Görünüm ve Tema Seçimi -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="DarkTheme24" Foreground="{DynamicResource BrushBrandPrimary}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Görünüm ve Tema Tercihi" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Ultron Defender arayüz temasını kullanım tercihinize veya ortam ışığına göre yapılandırın:" 
                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,16"/>

                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <!-- Option 1: Light Theme -->
                        <RadioButton GroupName="ThemeGroup" 
                                     IsChecked="{Binding IsLightThemeSelected}" 
                                     Command="{Binding SetLightThemeCommand}"
                                     Cursor="Hand" Margin="0,0,8,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ThemeBorder" 
                                            Background="{DynamicResource BrushAppBg}" 
                                            BorderBrush="{DynamicResource BrushCardBorder}" 
                                            BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="24" Foreground="{DynamicResource BrushStatusWarning}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Açık Tema" Style="{StaticResource DataTableStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Gündüz için aydınlık" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushBrandPrimary}"/>
                                            <Setter TargetName="ThemeBorder" Property="Background" Value="{DynamicResource BrushBrandMinimal}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Option 2: Dark Theme -->
                        <RadioButton GroupName="ThemeGroup" 
                                     IsChecked="{Binding IsDarkThemeSelected}" 
                                     Command="{Binding SetDarkThemeCommand}"
                                     Cursor="Hand" Margin="4,0,4,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ThemeBorder" 
                                            Background="{DynamicResource BrushAppBg}" 
                                            BorderBrush="{DynamicResource BrushCardBorder}" 
                                            BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="24" Foreground="{DynamicResource BrushBrandPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Koyu Tema" Style="{StaticResource DataTableStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Göz yormayan obsidyen" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushBrandPrimary}"/>
                                            <Setter TargetName="ThemeBorder" Property="Background" Value="{DynamicResource BrushBrandMinimal}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Option 3: System Theme -->
                        <RadioButton GroupName="ThemeGroup" 
                                     IsChecked="{Binding IsSystemThemeSelected}" 
                                     Command="{Binding SetSystemThemeCommand}"
                                     Cursor="Hand" Margin="8,0,0,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ThemeBorder" 
                                            Background="{DynamicResource BrushAppBg}" 
                                            BorderBrush="{DynamicResource BrushCardBorder}" 
                                            BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="24" Foreground="{DynamicResource BrushStatusInfo}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Sistemi Takip Et" Style="{StaticResource DataTableStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Windows ayarıyla uyumlu" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushBrandPrimary}"/>
                                            <Setter TargetName="ThemeBorder" Property="Background" Value="{DynamicResource BrushBrandMinimal}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThemeBorder" Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 7. Updates & General -->
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,24" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource BrushTextMuted}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Genel ve Güncelleme" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
                            <TextBlock Text="Otomatik İmza ve Kural Güncellemesi" Style="{StaticResource DataTableStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Yeni zararlı yazılım imzalarını arka planda otomatik indirir." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsAutoUpdateEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding LastUpdateCheck}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 7. Save Action Button & Status Feedback -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" 
                        Content="Ayarları Kaydet" 
                        Padding="24,10"
                        Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
