<Page x:Class="AegisPC.App.Views.RealTimeMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AegisPC.App.Converters"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <conv:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <conv:PercentToColorConverter x:Key="PercentColorConverter"/>
    </Page.Resources>

    <ScrollViewer Margin="24">
        <StackPanel>
            <!-- Header -->
            <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Canlı Sistem Monitörü" />

            <!-- Live Gauges / Cards Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- CPU -->
                <Border Style="{StaticResource MetricCardStyle}" Height="140" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="İşlemci (CPU)" Foreground="{DynamicResource BrushTextMuted}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentCpu, StringFormat='\{0:F1\} %'}" 
                                   FontSize="32" FontWeight="Bold" 
                                   Foreground="{Binding CurrentCpu, Converter={StaticResource PercentColorConverter}}"/>
                        <ProgressBar Value="{Binding CurrentCpu}" Height="6" Margin="0,12,0,0" 
                                     Foreground="{Binding CurrentCpu, Converter={StaticResource PercentColorConverter}}" Background="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource MetricCardStyle}" Height="140" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bellek (RAM)" Foreground="{DynamicResource BrushTextMuted}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentRamPercent, StringFormat='\{0:F1\} %'}" 
                                   FontSize="32" FontWeight="Bold" 
                                   Foreground="{Binding CurrentRamPercent, Converter={StaticResource PercentColorConverter}}"/>
                        <TextBlock Text="{Binding CurrentRamUsedBytes, Converter={StaticResource BytesConverter}, StringFormat='Kullanılan: \{0\}'}" 
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        <ProgressBar Value="{Binding CurrentRamPercent}" Height="6" Margin="0,6,0,0" 
                                     Foreground="{Binding CurrentRamPercent, Converter={StaticResource PercentColorConverter}}" Background="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource MetricCardStyle}" Height="140" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Disk Doluluğu" Foreground="{DynamicResource BrushTextMuted}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentDiskUsage, StringFormat='\{0:F1\} %'}" 
                                   FontSize="32" FontWeight="Bold" 
                                   Foreground="{Binding CurrentDiskUsage, Converter={StaticResource PercentColorConverter}}"/>
                        <ProgressBar Value="{Binding CurrentDiskUsage}" Height="6" Margin="0,18,0,0" 
                                     Foreground="{Binding CurrentDiskUsage, Converter={StaticResource PercentColorConverter}}" Background="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource MetricCardStyle}" Height="140">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ağ Trafiği" Foreground="Gray" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ui:SymbolIcon Symbol="ArrowDown24" Foreground="#2ecc71" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentNetworkDownMBps, StringFormat='\{0:F2\} MB/s'}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ui:SymbolIcon Symbol="ArrowUp24" Foreground="#3498db" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentNetworkUpMBps, StringFormat='\{0:F2\} MB/s'}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Telemetry History Table -->
            <TextBlock Text="Son Telemetri Örnekleri (2 Saniyelik Aralıklarla)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ui:DataGrid ItemsSource="{Binding RecentSamples}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Zaman" Binding="{Binding SampledAt, StringFormat='\{0:HH:mm:ss\}'}" Width="100"/>
                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat='\{0:F1\} %'}" Width="100"/>
                    <DataGridTextColumn Header="RAM Kullanılan" Binding="{Binding MemoryUsedBytes, Converter={StaticResource BytesConverter}}" Width="140"/>
                    <DataGridTextColumn Header="Disk %" Binding="{Binding DiskUsagePercent, StringFormat='\{0:F1\} %'}" Width="100"/>
                    <DataGridTextColumn Header="İndirme Hızı" Binding="{Binding NetworkDownBps, Converter={StaticResource BytesConverter}, StringFormat='\{0\}/s'}" Width="140"/>
                    <DataGridTextColumn Header="Yükleme Hızı" Binding="{Binding NetworkUpBps, Converter={StaticResource BytesConverter}, StringFormat='\{0\}/s'}" Width="140"/>
                    <DataGridTextColumn Header="Aktif Süreç Sayısı" Binding="{Binding ActiveProcesses}" Width="*"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </StackPanel>
    </ScrollViewer>
</Page>

