<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — REUSABLE COMPONENT DESIGN SYSTEM
         Includes:
         1. Buttons (Primary Orange, Secondary Outline, Danger Crimson Red)
         2. Cards (Rounded 10-12px Shield Geometry, Elevation & Shadows)
         3. Toggle Switches (Orange Active, Gray Inactive, Muted Disabled)
         4. Status Badges (Pill-Shaped: Safe Green, Danger Red, Progress Orange, Muted Gray)
         5. Shield Icon Visual Language (Safe, Danger, Scanning with Radar Animations)
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════
         1. BUTTON STYLES & CONTROL TEMPLATES
         ═══════════════════════════════════════════════════════════ -->

    <!-- Primary Button: Brand Orange Fill + White SemiBold Text -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBrandPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBrandDisabled}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Action Button Alias -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <!-- Secondary Button: Brand Orange Outline + Orange Text + Hover Tint -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushBrandPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBrandMinimal}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushBrandHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushBrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBrandSubtle}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushBrandPressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushBrandPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button Alias -->
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <!-- Danger Button: Crimson Red Fill (Strictly separate from orange) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource BrushStatusDanger}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushStatusDangerDark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Action Button Alias -->
    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════
         2. CARD STYLES (MATCHING LOGO ROUNDED CORNER RADIUS 10-12px)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Standard Metric Card: 10px Rounded Corners + Soft Drop Shadow -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.04" Direction="270" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.08" Direction="270" ShadowDepth="3"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Hero Card Style: 12px Rounded Corners for Main Top Banners -->
    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Feature / Sub-Card Style: 10px Rounded Corners for Grouped Panels -->
    <Style x:Key="FeatureCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         3. TOGGLE SWITCH STYLES
         ═══════════════════════════════════════════════════════════ -->

    <!-- Custom Fluent Toggle Switch Template (Brand Orange Active, Neutral Gray Inactive) -->
    <Style x:Key="BrandToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Track Background -->
                        <Border x:Name="Track" Grid.Column="0" 
                                Width="44" Height="24" 
                                CornerRadius="12" 
                                Background="{DynamicResource BrushCardBorderHover}" 
                                BorderThickness="0" 
                                VerticalAlignment="Center"/>

                        <!-- Thumb Circle -->
                        <Border x:Name="Thumb" Grid.Column="0" 
                                Width="18" Height="18" 
                                CornerRadius="9" 
                                Background="#FFFFFF" 
                                HorizontalAlignment="Left" 
                                Margin="3,0,0,0" 
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#000000" Opacity="0.2" ShadowDepth="1"/>
                            </Border.Effect>
                        </Border>

                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Checked / Active: Brand Orange -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushBrandPrimary}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <!-- Disabled / Muted: Half Opacity -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         4. STATUS BADGES (PILL-SHAPED 12-14px CORNER RADIUS)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Safe / Clean Badge (Emerald Green) -->
    <Style x:Key="BadgeSafeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushStatusSafeBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusSafeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Danger / Threat Detected Badge (Strictly Crimson Red, NEVER Orange) -->
    <Style x:Key="BadgeDangerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushStatusDangerBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusDangerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Progress / Active Scanning Badge (Brand Orange) -->
    <Style x:Key="BadgeProgressStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBrandMinimal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Muted / Disabled Badge (Neutral Gray) -->
    <Style x:Key="BadgeMutedStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Legacy Compatibility Badge Aliases -->
    <Style x:Key="BadgeGreenStyle" TargetType="Border" BasedOn="{StaticResource BadgeSafeStyle}"/>
    <Style x:Key="BadgeRedStyle" TargetType="Border" BasedOn="{StaticResource BadgeDangerStyle}"/>
    <Style x:Key="BadgeAmberStyle" TargetType="Border" BasedOn="{StaticResource BadgeProgressStyle}"/>
    <Style x:Key="BadgeBlueStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushStatusInfoBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusInfoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         5. SHIELD (KALKAN) VISUAL LANGUAGE & ICONS
         ═══════════════════════════════════════════════════════════ -->

    <!-- Geometry for the Rounded Brand Shield (Matching Logo) -->
    <PathGeometry x:Key="BrandShieldGeometry" Figures="M 50,5 C 80,5 95,15 95,35 C 95,75 50,95 50,95 C 50,95 5,75 5,35 C 5,15 20,5 50,5 Z"/>

    <!-- Hero Safe Shield (Green with Checkmark) -->
    <Style x:Key="ShieldHeroSafeStyle" TargetType="Grid">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
    </Style>

    <!-- Pulsing Radar Animation for Live Monitoring Shield -->
    <Storyboard x:Key="ShieldRadarPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:1.2"/>
    </Storyboard>

</ResourceDictionary>
