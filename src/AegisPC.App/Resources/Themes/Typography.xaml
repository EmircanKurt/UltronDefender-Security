<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:AegisPC.App.Helpers">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — BITDEFENDER-INSPIRED ENTERPRISE TYPOGRAPHY SYSTEM
         Hierarchy:
         • FontHeading: Segoe UI Variable Display / Inter Bold / Semibold for crisp authority
         • FontSans: Segoe UI Variable Text / Inter Regular for readable, airy interface text
         • FontMono: Cascadia Code / Consolas for tabular hashes, PIDs, paths, and technical data
         • All handwriting/script/italic styles strictly eliminated across the entire design system.
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. FONT FAMILY DEFINITIONS (CODEX GÖRÜNÜMÜ: Segoe UI Variable önde, Inter fallback) ── -->
    <FontFamily x:Key="FontBrand">Segoe UI Variable Display, Segoe UI, pack://application:,,,/UltronDefender;component/Resources/Fonts/#Inter Display Medium, pack://application:,,,/UltronDefender;component/Resources/Fonts/#Inter, sans-serif</FontFamily>
    <FontFamily x:Key="FontHeading">Segoe UI Variable Display, Segoe UI, pack://application:,,,/UltronDefender;component/Resources/Fonts/#Inter, Aptos, sans-serif</FontFamily>

    <!-- UI Standard Sans-Serif Body & Interface Font -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Text, Segoe UI, pack://application:,,,/UltronDefender;component/Resources/Fonts/#Inter, Aptos, sans-serif</FontFamily>

    <!-- Monospace & Tabular Data Font Stack (Hashes, PIDs, Paths, Hex) -->
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Segoe UI Mono, Courier New, monospace</FontFamily>

    <!-- ── 2. TYPOGRAPHY STYLES ── -->

    <!-- [0.1] Codex-Inspired Hero Headline: 24px Clean, Elegant Medium Heading -->
    <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- [0.2] Hero Subtitle: 13.5px Neutral Sans-Serif with Airy Line Height -->
    <Style x:Key="HeroSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="560"/>
    </Style>

    <!-- [0.3] Action Card Title: 13.5px Medium for Modern Quick Cards -->
    <Style x:Key="ActionCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [0.4] Action Card Description: 12px Regular for 2-Line Explanations -->
    <Style x:Key="ActionCardDescStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [1] Brand Logo Title: 23px ExtraBold Modern Display for ULTRON -->
    <Style x:Key="BrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}"/>
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushBrandPrimary}"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [1.1] Brand Tagline / Subtitle ("TOTAL SECURITY") -->
    <Style x:Key="BrandTaglineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [2] Page Heading: 22px Clean SemiBold Sans-Serif for Page Titles -->
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [3] Status Headline: 24px Medium Sans-Serif for Hero Status -->
    <Style x:Key="StatusHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [4] Section / Card Heading: 15px Medium for Card & Group Headers -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [4.1] Card Heading Style Alias -->
    <Style x:Key="CardHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingStyle}"/>

    <!-- [5] Body Text: 12.5px Regular Clean Sans-Serif with Airy Line Height (19px) -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [6] Caption / Helper Text: 11px Sans-Serif for Timestamps and Secondary Metadata -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [7] Small Label: 11px Medium for Metric Headings -->
    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [7.1] Uppercase Label Alias -->
    <Style x:Key="UppercaseLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StatLabelStyle}"/>

    <!-- [8] Stat Number / Metric Value: 22px Bold Sans-Serif with Tabular Numerals (Non-Jittering) -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [8.1] Stat Number Style Alias -->
    <Style x:Key="StatNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}"/>

    <!-- [9] Data Table Style: 12.5px Clean Sans-Serif with Tabular Numerals -->
    <Style x:Key="DataTableStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [10] Data Monospace Style: 11.5px for Hashes (SHA-256), PIDs, Registry Paths, Network IPs -->
    <Style x:Key="DataMonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [10.1] Data Monospace TextBox Style: Selectable, read-only paths and hashes (TargetType=TextBox) -->
    <Style x:Key="DataMonospaceTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="helpers:MouseWheelScrollHelper.BubbleScroll" Value="True"/>
    </Style>

    <!-- [11] Button Text Style: 12.5px Semi-Bold Sans-Serif for Buttons & Interactive Controls -->
    <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [12] Badge Text Style: 10.5px Compact Bold Sans-Serif for Status Badges & Feature Chips -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

</ResourceDictionary>
