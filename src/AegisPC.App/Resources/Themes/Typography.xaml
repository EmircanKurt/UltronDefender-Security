<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — TYPOGRAPHY DESIGN SYSTEM
         Strict Hierarchy:
         • Casual/Handwritten Brand Font: ONLY for App Title, Hero Status Headlines & Slogans
         • Ultra-Legible Modern Sans-Serif: MANDATORY for Tables, Buttons, Forms & Metrics
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. FONT FAMILY DEFINITIONS ── -->
    <!-- Brand / Hero Handwritten Font Stack (matches logo branding) -->
    <FontFamily x:Key="FontBrand">Caveat, Kalam, Segoe Print, Ink Free, MV Boli, Segoe UI</FontFamily>

    <!-- UI Standard Clean Sans-Serif Font Stack (high legibility ClearType) -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Inter, Aptos, Arial</FontFamily>

    <!-- Monospace & Tabular Data Font Stack (for Hashes, PIDs, Paths, Hex) -->
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Segoe UI Mono, Courier New, monospace</FontFamily>

    <!-- ── 2. TYPOGRAPHY STYLES ── -->

    <!-- [1] Brand Title: Large Casual/Handwritten for Logo & App Header -->
    <Style x:Key="BrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [1.1] Brand Tagline / Slogan ("Kesintisiz koruma disiplini") -->
    <Style x:Key="BrandTaglineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [2] Page Heading: Bold Modern Sans-Serif for Page Titles (e.g. "Karantina Kasası", "Ayarlar") -->
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [2.1] Section Subheading: Semi-Bold Sans-Serif for Card & Group Headers -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [3] Status Headline: Expressive Brand Font for Hero Messages ("TEHDİT TESPİT EDİLDİ", "SİSTEM GÜVENDE") -->
    <Style x:Key="StatusHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [4] Body Text: Regular Clean Sans-Serif for Descriptions & Explanations -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- [4.1] Caption / Muted Text: Smaller Sans-Serif for Timestamps and Secondary Metadata -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [5] Data Table Style: Clean Sans-Serif with Tabular Numerals for Process Manager, Quarantine, Logs -->
    <Style x:Key="DataTableStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [5.1] Data Monospace Style: For Hashes (SHA-256), PIDs, Registry Paths, Network IPs -->
    <Style x:Key="DataMonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [6] Button Text Style: Semi-Bold Sans-Serif for Buttons & Interactive Controls -->
    <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [7] Metric Value Style: Large Bold Sans-Serif for Stats & Resource Gauges (% RAM, CPU, Count) -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [8] Badge Text Style: Compact Bold Sans-Serif for Status Badges & Feature Tags -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

</ResourceDictionary>
