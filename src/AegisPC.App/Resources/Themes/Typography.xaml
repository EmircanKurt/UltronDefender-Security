<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — CLAUDE-INSPIRED ENTERPRISE TYPOGRAPHY SYSTEM
         Hierarchy:
         • FontBrand: Casual Script font STRICTLY FOR LOGO ("ULTRON") ONLY
         • FontHeading: Segoe UI Variable Display / Inter Semibold for authoritative titles
         • FontSans: Segoe UI Variable Text / Inter Regular for readable, airy body text
         • FontMono: Cascadia Code / Consolas for hashes, PIDs, and tabular technical metrics
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. FONT FAMILY DEFINITIONS ── -->
    <!-- Brand Authoritative Font (Modern High-Tech Display Sans) -->
    <FontFamily x:Key="FontBrand">Segoe UI Variable Display, Inter, Segoe UI, Aptos, Arial, sans-serif</FontFamily>

    <!-- Headings & Prominent Titles (Crisp Semibold Authority) -->
    <FontFamily x:Key="FontHeading">Segoe UI Variable Display, Inter, Segoe UI, Aptos, -apple-system, sans-serif</FontFamily>

    <!-- UI Standard Clean Sans-Serif Body & Interface Font -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Text, Inter, Segoe UI, Aptos, -apple-system, sans-serif</FontFamily>

    <!-- Monospace & Tabular Data Font Stack (for Hashes, PIDs, Paths, Hex) -->
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Segoe UI Mono, Courier New, monospace</FontFamily>

    <!-- ── 2. TYPOGRAPHY STYLES ── -->

    <!-- [1] Brand Title: Authoritative Bold Display for ULTRON Logo -->
    <Style x:Key="BrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}"/>
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushBrandPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [1.1] Brand Tagline ("Kesintisiz koruma disiplini") -->
    <Style x:Key="BrandTaglineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [2] Page Heading: 25px Clean Semibold Sans-Serif for Page Titles -->
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [2.1] Section / Card Heading: 16px Semibold for Card & Group Headers -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [2.2] Card Heading Style Alias -->
    <Style x:Key="CardHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingStyle}"/>

    <!-- [3] Status Headline: 24px Semibold Sans-Serif for Hero Status Messages ("GÜVENDESİNİZ", "SİSTEM TARANIYOR") -->
    <Style x:Key="StatusHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="LineHeight" Value="30"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- [4] Body Text: 13.5px Regular Clean Sans-Serif with Generous Line Height (20px) -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [4.1] Caption / Helper Text: 11.5px Sans-Serif for Timestamps and Secondary Metadata -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [5] Data Table Style: 13px Clean Sans-Serif with Tabular Numerals for Process Manager, Quarantine, Logs -->
    <Style x:Key="DataTableStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [5.1] Data Monospace Style: 12px for Hashes (SHA-256), PIDs, Registry Paths, Network IPs -->
    <Style x:Key="DataMonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [5.2] Data Monospace TextBox Style: Selectable, read-only paths and hashes (TargetType=TextBox) -->
    <Style x:Key="DataMonospaceTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [6] Button Text Style: 13px Semi-Bold Sans-Serif for Buttons & Interactive Controls -->
    <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [7] Metric Value Style: 26px Semibold Sans-Serif with Tabular Numerals for Stats & Resource Gauges -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- [8] Badge Text Style: 11px Compact SemiBold Sans-Serif for Status Badges & Feature Chips -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

</ResourceDictionary>
