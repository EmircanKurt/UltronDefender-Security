<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — DESIGN SYSTEM TOKENS (DARK THEME)
         Bitdefender-Inspired Dark Palette: Koyu Lacivert/Antrasit (#1B2532) + Kırmızı (#C41E1E) + Yeşil (#4CAF50)
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. BACKGROUND & SURFACE TOKENS ── -->
    <Color x:Key="ColorAppBg">#1B2532</Color>
    <Color x:Key="ColorCardBg">#232E3D</Color>
    <Color x:Key="ColorCardBgAlt">#2B384A</Color>
    <Color x:Key="ColorCardBorder">#324155</Color>
    <Color x:Key="ColorCardBorderHover">#445770</Color>

    <Color x:Key="ColorSidebarBg">#17202B</Color>
    <Color x:Key="ColorSidebarHeader">#141C26</Color>
    <Color x:Key="ColorSidebarBorder">#232E3D</Color>
    <Color x:Key="ColorSidebarHover">#202B3A</Color>
    <Color x:Key="ColorSidebarActive">#C41E1E</Color>

    <!-- ── 2. PRIMARY BRAND ACCENT TOKENS (BITDEFENDER BRAND RED #C41E1E) ── -->
    <Color x:Key="ColorBrandPrimary">#C41E1E</Color>
    <Color x:Key="ColorBrandHover">#D92B2B</Color>
    <Color x:Key="ColorBrandPressed">#A81717</Color>
    <Color x:Key="ColorBrandDisabled">#4A1515</Color>
    
    <!-- Opacity Variations for subtle backgrounds and badges -->
    <Color x:Key="ColorBrandAlpha80">#CCC41E1E</Color>
    <Color x:Key="ColorBrandSubtle">#33C41E1E</Color>       <!-- ~20% Opacity Red on Dark Navy -->
    <Color x:Key="ColorBrandMinimal">#1FC41E1E</Color>      <!-- ~12% Opacity Red on Dark Navy -->
    <Color x:Key="ColorBrandFocusRing">#80C41E1E</Color>

    <!-- Legacy / Compatibility Alias -->
    <Color x:Key="ColorAccent">#C41E1E</Color>
    <Color x:Key="ColorAccentHover">#D92B2B</Color>
    <Color x:Key="ColorAccentLight">#1FC41E1E</Color>

    <!-- ── 3. TYPOGRAPHY TOKENS (CALM HIGH-CONTRAST NEUTRALS) ── -->
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#8B95A3</Color>
    <Color x:Key="ColorTextMuted">#5E6978</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorTextOnDark">#FFFFFF</Color>

    <!-- ── 4. SEMANTIC STATUS TOKENS (BITDEFENDER ENTERPRISE PALETTE) ── -->
    <!-- Safe / Clean (Bitdefender Emerald Green) -->
    <Color x:Key="ColorStatusSafe">#4CAF50</Color>
    <Color x:Key="ColorStatusSafeDark">#388E3C</Color>
    <Color x:Key="ColorStatusSafeBg">#122A1C</Color>
    <Color x:Key="ColorStatusSafeBorder">#1E4D2B</Color>
    <Color x:Key="ColorStatusSafeText">#4CAF50</Color>

    <!-- Warning / Suspicious (Technical Amber #F5A623 - SADECE kritik olmayan dikkat durumları için) -->
    <Color x:Key="ColorStatusWarning">#F5A623</Color>
    <Color x:Key="ColorStatusWarningDark">#D98206</Color>
    <Color x:Key="ColorStatusWarningBg">#2D200E</Color>
    <Color x:Key="ColorStatusWarningBorder">#664410</Color>
    <Color x:Key="ColorStatusWarningText">#F5A623</Color>

    <!-- Danger / Critical (Marka Kırmızıyla Bütünleşik Tehdit Tonu #C41E1E) -->
    <Color x:Key="ColorStatusDanger">#C41E1E</Color>
    <Color x:Key="ColorStatusDangerDark">#A81717</Color>
    <Color x:Key="ColorStatusDangerBg">#2A1215</Color>
    <Color x:Key="ColorStatusDangerBorder">#6B1B1F</Color>
    <Color x:Key="ColorStatusDangerText">#FF5252</Color>

    <!-- Info (Cobalt Blue) -->
    <Color x:Key="ColorStatusInfo">#2196F3</Color>
    <Color x:Key="ColorStatusInfoDark">#1976D2</Color>
    <Color x:Key="ColorStatusInfoBg">#112338</Color>
    <Color x:Key="ColorStatusInfoBorder">#194B7A</Color>
    <Color x:Key="ColorStatusInfoText">#42A5F5</Color>

    <!-- Purple (Quarantine / Vault) -->
    <Color x:Key="ColorStatusPurple">#8B5CF6</Color>
    <Color x:Key="ColorStatusPurpleDark">#7C3AED</Color>
    <Color x:Key="ColorStatusPurpleBg">#1C1030</Color>
    <Color x:Key="ColorStatusPurpleBorder">#4C1D95</Color>
    <Color x:Key="ColorStatusPurpleText">#A78BFA</Color>

    <!-- Compatibility Status Aliases -->
    <Color x:Key="ColorStatusGreen">#4CAF50</Color>
    <Color x:Key="ColorStatusGreenBg">#122A1C</Color>
    <Color x:Key="ColorStatusAmber">#F5A623</Color>
    <Color x:Key="ColorStatusAmberBg">#2D200E</Color>
    <Color x:Key="ColorStatusRed">#C41E1E</Color>
    <Color x:Key="ColorStatusRedBg">#2A1215</Color>
    <Color x:Key="ColorStatusBlue">#2196F3</Color>
    <Color x:Key="ColorStatusBlueBg">#112338</Color>

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES (FOR DynamicResource BINDING)
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- Background & Surface Brushes -->
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushCardBgAlt" Color="{StaticResource ColorCardBgAlt}"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="BrushCardBorderHover" Color="{StaticResource ColorCardBorderHover}"/>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="BrushSidebarHeader" Color="{StaticResource ColorSidebarHeader}"/>
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="{StaticResource ColorSidebarBorder}"/>

    <!-- Brand Accent Brushes -->
    <SolidColorBrush x:Key="BrushBrandPrimary" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="BrushBrandHover" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="BrushBrandPressed" Color="{StaticResource ColorBrandPressed}"/>
    <SolidColorBrush x:Key="BrushBrandDisabled" Color="{StaticResource ColorBrandDisabled}"/>
    <SolidColorBrush x:Key="BrushBrandAlpha80" Color="{StaticResource ColorBrandAlpha80}"/>
    <SolidColorBrush x:Key="BrushBrandSubtle" Color="{StaticResource ColorBrandSubtle}"/>
    <SolidColorBrush x:Key="BrushBrandMinimal" Color="{StaticResource ColorBrandMinimal}"/>
    <SolidColorBrush x:Key="BrushBrandFocusRing" Color="{StaticResource ColorBrandFocusRing}"/>

    <!-- Accent Compatibility Brushes -->
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource ColorBrandMinimal}"/>

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="{StaticResource ColorTextOnAccent}"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="{StaticResource ColorTextOnDark}"/>

    <!-- Semantic Status Brushes -->
    <SolidColorBrush x:Key="BrushStatusSafe" Color="{StaticResource ColorStatusSafe}"/>
    <SolidColorBrush x:Key="BrushStatusSafeDark" Color="{StaticResource ColorStatusSafeDark}"/>
    <SolidColorBrush x:Key="BrushStatusSafeBg" Color="{StaticResource ColorStatusSafeBg}"/>
    <SolidColorBrush x:Key="BrushStatusSafeBorder" Color="{StaticResource ColorStatusSafeBorder}"/>
    <SolidColorBrush x:Key="BrushStatusSafeText" Color="{StaticResource ColorStatusSafeText}"/>

    <SolidColorBrush x:Key="BrushStatusWarning" Color="{StaticResource ColorStatusWarning}"/>
    <SolidColorBrush x:Key="BrushStatusWarningDark" Color="{StaticResource ColorStatusWarningDark}"/>
    <SolidColorBrush x:Key="BrushStatusWarningBg" Color="{StaticResource ColorStatusWarningBg}"/>
    <SolidColorBrush x:Key="BrushStatusWarningBorder" Color="{StaticResource ColorStatusWarningBorder}"/>
    <SolidColorBrush x:Key="BrushStatusWarningText" Color="{StaticResource ColorStatusWarningText}"/>

    <SolidColorBrush x:Key="BrushStatusDanger" Color="{StaticResource ColorStatusDanger}"/>
    <SolidColorBrush x:Key="BrushStatusDangerDark" Color="{StaticResource ColorStatusDangerDark}"/>
    <SolidColorBrush x:Key="BrushStatusDangerBg" Color="{StaticResource ColorStatusDangerBg}"/>
    <SolidColorBrush x:Key="BrushStatusDangerBorder" Color="{StaticResource ColorStatusDangerBorder}"/>
    <SolidColorBrush x:Key="BrushStatusDangerText" Color="{StaticResource ColorStatusDangerText}"/>

    <SolidColorBrush x:Key="BrushStatusInfo" Color="{StaticResource ColorStatusInfo}"/>
    <SolidColorBrush x:Key="BrushStatusInfoDark" Color="{StaticResource ColorStatusInfoDark}"/>
    <SolidColorBrush x:Key="BrushStatusInfoBg" Color="{StaticResource ColorStatusInfoBg}"/>
    <SolidColorBrush x:Key="BrushStatusInfoBorder" Color="{StaticResource ColorStatusInfoBorder}"/>
    <SolidColorBrush x:Key="BrushStatusInfoText" Color="{StaticResource ColorStatusInfoText}"/>

    <SolidColorBrush x:Key="BrushStatusPurple" Color="{StaticResource ColorStatusPurple}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleDark" Color="{StaticResource ColorStatusPurpleDark}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleBg" Color="{StaticResource ColorStatusPurpleBg}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleBorder" Color="{StaticResource ColorStatusPurpleBorder}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleText" Color="{StaticResource ColorStatusPurpleText}"/>

    <!-- Compatibility Status Brushes -->
    <SolidColorBrush x:Key="BrushStatusGreen" Color="{StaticResource ColorStatusSafe}"/>
    <SolidColorBrush x:Key="BrushStatusAmber" Color="{StaticResource ColorStatusWarning}"/>
    <SolidColorBrush x:Key="BrushStatusRed" Color="{StaticResource ColorStatusDanger}"/>
    <SolidColorBrush x:Key="BrushStatusBlue" Color="{StaticResource ColorStatusInfo}"/>

    <!-- ── 5. TITLEBAR HIGH CONTRAST BRUSHES (DARK) ── -->
    <SolidColorBrush x:Key="TitleBarButtonForeground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverBackground" Color="#232E3D"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="#324155"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverBackground" Color="#C41E1E"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedBackground" Color="#A81717"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedForeground" Color="#FFFFFF"/>

    <!-- ── 6. WPF-UI NATIVE CONTROL TOKEN BRIDGE (DARK) ── -->
    <SolidColorBrush x:Key="CardBackgroundSolidColorBrush" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="CardBorderSolidColorBrush" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource ColorBrandPressed}"/>

    <!-- NavigationView Control Brushes (Bitdefender %15-20 Red Selected State) -->
    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#8B95A3"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#5E6978"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#202B3A"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2B384A"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource ColorBrandSubtle}"/>
    <SolidColorBrush x:Key="NavigationViewItemSelectedBackground" Color="{StaticResource ColorBrandSubtle}"/>

</ResourceDictionary>
