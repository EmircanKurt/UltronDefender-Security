<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — SNOW #F5FEFD DESIGN SYSTEM (v6.0)
         Soothing Snow White (#F5FEFD) Canvas + Crisp White Cards + Obsidian Sidebar
         Ultra-High Contrast ClearType Rendering
    ═══════════════════════════════════════════════════════════ -->

    <!-- Core Color Tokens -->
    <Color x:Key="ColorAppBg">#EEF2F6</Color>
    <Color x:Key="ColorCardBg">#FFFFFF</Color>
    <Color x:Key="ColorCardBgAlt">#F8FAFC</Color>
    <Color x:Key="ColorCardBorder">#E2E8F0</Color>
    <Color x:Key="ColorCardBorderHover">#CBD5E1</Color>

    <Color x:Key="ColorSidebarBg">#0A0F1D</Color>
    <Color x:Key="ColorSidebarHeader">#0F172A</Color>
    <Color x:Key="ColorSidebarBorder">#1E293B</Color>
    <Color x:Key="ColorSidebarHover">#1E293B</Color>
    <Color x:Key="ColorSidebarActive">#2563EB</Color>

    <Color x:Key="ColorAccent">#2563EB</Color>
    <Color x:Key="ColorAccentHover">#1D4ED8</Color>
    <Color x:Key="ColorAccentLight">#EFF6FF</Color>

    <Color x:Key="ColorStatusGreen">#10B981</Color>
    <Color x:Key="ColorStatusGreenDark">#059669</Color>
    <Color x:Key="ColorStatusGreenBg">#ECFDF5</Color>

    <Color x:Key="ColorStatusBlue">#2563EB</Color>
    <Color x:Key="ColorStatusBlueBg">#EFF6FF</Color>

    <Color x:Key="ColorStatusAmber">#F59E0B</Color>
    <Color x:Key="ColorStatusAmberDark">#D97706</Color>
    <Color x:Key="ColorStatusAmberBg">#FFFBEB</Color>

    <Color x:Key="ColorStatusRed">#EF4444</Color>
    <Color x:Key="ColorStatusRedDark">#DC2626</Color>
    <Color x:Key="ColorStatusRedBg">#FEF2F2</Color>

    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextOnDark">#FFFFFF</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="{StaticResource ColorSidebarBorder}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushStatusGreen" Color="{StaticResource ColorStatusGreen}"/>
    <SolidColorBrush x:Key="BrushStatusRed" Color="{StaticResource ColorStatusRed}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="{StaticResource ColorTextOnDark}"/>

    <!-- TitleBar High Contrast Button Brushes (Deep Charcoal Icons on Light Theme) -->
    <SolidColorBrush x:Key="TitleBarButtonForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverBackground" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverBackground" Color="#DC2626"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedBackground" Color="#B91C1C"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedForeground" Color="#FFFFFF"/>

    <!-- Global WPF-UI Fallbacks to Guarantee 100% High Contrast on Light Background -->
    <SolidColorBrush x:Key="CardBackgroundSolidColorBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderSolidColorBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#2563EB"/>

    <!-- Global NavigationView Overrides for Executive Obsidian Sidebar -->
    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="#0A0F1D"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0A0F1D"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0A0F1D"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5FEFD"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="#F5FEFD"/>
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#94A3B8"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1E293B"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#334155"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="NavigationViewItemSelectedBackground" Color="#2563EB"/>

    <!-- ═══ CARD STYLES (DYNAMIC RESOURCE FOR DARK & LIGHT THEMES) ═══ -->

    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FeatureCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorderHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModalActionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ TYPOGRAPHY (HIGH CONTRAST & CLEAR READABILITY) ═══ -->

    <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="CardBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ═══ STATUS BADGES ═══ -->

    <Style x:Key="BadgeGreenStyle" TargetType="Border">
        <Setter Property="Background" Value="#ECFDF5"/>
        <Setter Property="BorderBrush" Value="#A7F3D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="BadgeRedStyle" TargetType="Border">
        <Setter Property="Background" Value="#FEF2F2"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="BadgeBlueStyle" TargetType="Border">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- ═══ BUTTON STYLES ═══ -->

    <!-- Primary Action — Royal Cobalt Sapphire -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.80"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Blue CTA Alias -->
    <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <!-- Secondary Action Button — Dynamic Theme with Slate Border -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="4" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushCardBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushCardBorderHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button — Crimson Red -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#DC2626" Offset="0"/>
                                <GradientStop Color="#B91C1C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.90"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin Progress Bar Style -->
    <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ═══ MODERN FLUENT SLIM SCROLLBAR STYLE ═══ -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="#94A3B8"
                            CornerRadius="4"
                            Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#475569"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
