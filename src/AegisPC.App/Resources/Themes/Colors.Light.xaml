<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         ULTRON DEFENDER TOTAL SECURITY — DESIGN SYSTEM TOKENS (LIGHT THEME)
         Ultron Light Palette: Temiz Açık Antrasit (#F4F6F8) + Kırmızı (#C41E1E) + Güvenli Yeşil (#2E7D32)
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. BACKGROUND & SURFACE TOKENS (NEUTRAL SURFACES) ── -->
    <Visibility x:Key="ClassicRowsVisibility">Collapsed</Visibility>
    <Visibility x:Key="ClassicSelectionVisibility">Visible</Visibility>
    <Color x:Key="ColorAppBg">#F6F7F8</Color>
    <Color x:Key="ColorCardBg">#FFFFFF</Color>
    <Color x:Key="ColorCardBgAlt">#F3F4F5</Color>
    <Color x:Key="ColorCardBorder">#CCD0D5</Color>
    <Color x:Key="ColorCardBorderHover">#C8CED8</Color>

    <Color x:Key="ColorSidebarBg">#25282C</Color>
    <Color x:Key="ColorSidebarHeader">#25282C</Color>
    <Color x:Key="ColorSidebarBorder">#BCC2C8</Color>
    <Color x:Key="ColorSidebarHover">#D3D7DC</Color>
    <Color x:Key="ColorSidebarActive">#E8D8DA</Color>

    <!-- ── 2. PRIMARY BRAND ACCENT TOKENS (ULTRON BRAND RED) ── -->
    <Color x:Key="ColorBrandPrimary">#C62D35</Color>
    <Color x:Key="ColorBrandHover">#AD242D</Color>
    <Color x:Key="ColorBrandPressed">#941D25</Color>
    <Color x:Key="ColorBrandDisabled">#9C5860</Color>
    
    <!-- Opacity Variations for subtle backgrounds and badges -->
    <Color x:Key="ColorBrandAlpha80">#CCC41E1E</Color>
    <Color x:Key="ColorBrandSubtle">#FDE8E8</Color>       <!-- ~15% Opacity Red on White -->
    <Color x:Key="ColorBrandMinimal">#FFF2F2</Color>      <!-- ~8% Opacity Red on White -->
    <Color x:Key="ColorBrandFocusRing">#80C41E1E</Color>

    <!-- Action Card Pastel Tokens (Legacy compatibility tokens) -->
    <Color x:Key="ColorPastelBlueBg">#EFF6FF</Color>
    <Color x:Key="ColorPastelBlueBorder">#DBEAFE</Color>
    <Color x:Key="ColorPastelBlueIcon">#3B82F6</Color>

    <Color x:Key="ColorPastelPurpleBg">#F5F3FF</Color>
    <Color x:Key="ColorPastelPurpleBorder">#EDE9FE</Color>
    <Color x:Key="ColorPastelPurpleIcon">#8B5CF6</Color>

    <Color x:Key="ColorPastelGreenBg">#ECFDF5</Color>
    <Color x:Key="ColorPastelGreenBorder">#D1FAE5</Color>
    <Color x:Key="ColorPastelGreenIcon">#10B981</Color>

    <Color x:Key="ColorPastelOrangeBg">#FFF7ED</Color>
    <Color x:Key="ColorPastelOrangeBorder">#FFEDD5</Color>
    <Color x:Key="ColorPastelOrangeIcon">#F97316</Color>

    <!-- Legacy / Compatibility Alias -->
    <Color x:Key="ColorAccent">#C62D35</Color>
    <Color x:Key="ColorAccentHover">#AD242D</Color>
    <Color x:Key="ColorAccentLight">#FFF2F2</Color>

    <!-- ── 3. TYPOGRAPHY TOKENS (CALM HIGH-CONTRAST NEUTRALS) ── -->
    <Color x:Key="ColorTextPrimary">#202124</Color>
    <Color x:Key="ColorTextSecondary">#4D5156</Color>
    <Color x:Key="ColorTextMuted">#60646B</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorTextOnDark">#FFFFFF</Color>

    <!-- ── 4. SEMANTIC STATUS TOKENS (SEMANTIC PALETTE) ── -->
    <!-- Safe / Clean (Observed status green) -->
    <Color x:Key="ColorStatusSafe">#10B981</Color>
    <Color x:Key="ColorStatusSafeDark">#059669</Color>
    <Color x:Key="ColorStatusSafeBg">#ECFDF5</Color>
    <Color x:Key="ColorStatusSafeBorder">#A7F3D0</Color>
    <Color x:Key="ColorStatusSafeText">#047857</Color>

    <!-- Warning / Suspicious (Technical Amber #F5A623 - SADECE kritik olmayan dikkat durumları için) -->
    <Color x:Key="ColorStatusWarning">#F59E0B</Color>
    <Color x:Key="ColorStatusWarningDark">#D97706</Color>
    <Color x:Key="ColorStatusWarningBg">#FFFBEB</Color>
    <Color x:Key="ColorStatusWarningBorder">#FDE68A</Color>
    <Color x:Key="ColorStatusWarningText">#B45309</Color>

    <!-- Danger / Critical (Marka Kırmızıyla Bütünleşik Tehdit Tonu #C41E1E) -->
    <Color x:Key="ColorStatusDanger">#EF4444</Color>
    <Color x:Key="ColorStatusDangerDark">#DC2626</Color>
    <Color x:Key="ColorStatusDangerBg">#FEF2F2</Color>
    <Color x:Key="ColorStatusDangerBorder">#FECACA</Color>
    <Color x:Key="ColorStatusDangerText">#B91C1C</Color>

    <!-- Info (Corporate Cobalt Blue) -->
    <Color x:Key="ColorStatusInfo">#3B82F6</Color>
    <Color x:Key="ColorStatusInfoDark">#1D4ED8</Color>
    <Color x:Key="ColorStatusInfoBg">#EFF6FF</Color>
    <Color x:Key="ColorStatusInfoBorder">#BFDBFE</Color>
    <Color x:Key="ColorStatusInfoText">#1D4ED8</Color>

    <!-- Purple (Quarantine / Vault) -->
    <Color x:Key="ColorStatusPurple">#8B5CF6</Color>
    <Color x:Key="ColorStatusPurpleDark">#7C3AED</Color>
    <Color x:Key="ColorStatusPurpleBg">#F5F3FF</Color>
    <Color x:Key="ColorStatusPurpleBorder">#DDD6FE</Color>
    <Color x:Key="ColorStatusPurpleText">#6D28D9</Color>

    <!-- Compatibility Status Aliases -->
    <Color x:Key="ColorStatusGreen">#10B981</Color>
    <Color x:Key="ColorStatusGreenBg">#ECFDF5</Color>
    <Color x:Key="ColorStatusAmber">#F59E0B</Color>
    <Color x:Key="ColorStatusAmberBg">#FFFBEB</Color>
    <Color x:Key="ColorStatusRed">#EF4444</Color>
    <Color x:Key="ColorStatusRedBg">#FEF2F2</Color>
    <Color x:Key="ColorStatusBlue">#3B82F6</Color>
    <Color x:Key="ColorStatusBlueBg">#EFF6FF</Color>

    <!-- ══════════════════════════════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES (FOR DynamicResource BINDING)
         ══════════════════════════════════════════════════════════════════════════════════ -->

    <!-- Background & Surface Brushes -->
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushCardBgAlt" Color="{StaticResource ColorCardBgAlt}"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="BrushCardBorderHover" Color="{StaticResource ColorCardBorderHover}"/>
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="BrushSidebarTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSidebarTextSecondary" Color="#DDE0E4"/>
    <SolidColorBrush x:Key="BrushShellSidebarActive" Color="#3B3F45"/>
    <SolidColorBrush x:Key="BrushShellSidebarHover" Color="#34383D"/>
    <SolidColorBrush x:Key="BrushSidebarHeader" Color="{StaticResource ColorSidebarHeader}"/>
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="{StaticResource ColorSidebarBorder}"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}"/>
    <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource ColorSidebarActive}"/>

    <!-- Action Card Pastel Brushes -->
    <SolidColorBrush x:Key="BrushPastelBlueBg" Color="{StaticResource ColorPastelBlueBg}"/>
    <SolidColorBrush x:Key="BrushPastelBlueBorder" Color="{StaticResource ColorPastelBlueBorder}"/>
    <SolidColorBrush x:Key="BrushPastelBlueIcon" Color="{StaticResource ColorPastelBlueIcon}"/>

    <SolidColorBrush x:Key="BrushPastelPurpleBg" Color="{StaticResource ColorPastelPurpleBg}"/>
    <SolidColorBrush x:Key="BrushPastelPurpleBorder" Color="{StaticResource ColorPastelPurpleBorder}"/>
    <SolidColorBrush x:Key="BrushPastelPurpleIcon" Color="{StaticResource ColorPastelPurpleIcon}"/>

    <SolidColorBrush x:Key="BrushPastelGreenBg" Color="{StaticResource ColorPastelGreenBg}"/>
    <SolidColorBrush x:Key="BrushPastelGreenBorder" Color="{StaticResource ColorPastelGreenBorder}"/>
    <SolidColorBrush x:Key="BrushPastelGreenIcon" Color="{StaticResource ColorPastelGreenIcon}"/>

    <SolidColorBrush x:Key="BrushPastelOrangeBg" Color="{StaticResource ColorPastelOrangeBg}"/>
    <SolidColorBrush x:Key="BrushPastelOrangeBorder" Color="{StaticResource ColorPastelOrangeBorder}"/>
    <SolidColorBrush x:Key="BrushPastelOrangeIcon" Color="{StaticResource ColorPastelOrangeIcon}"/>

    <!-- Brand Accent Brushes -->
    <SolidColorBrush x:Key="BrushBrandPrimary" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="BrushBrandHover" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="BrushBrandPressed" Color="{StaticResource ColorBrandPressed}"/>
    <SolidColorBrush x:Key="BrushBrandDisabled" Color="{StaticResource ColorBrandDisabled}"/>
    <SolidColorBrush x:Key="BrushBrandAlpha80" Color="{StaticResource ColorBrandAlpha80}"/>
    <SolidColorBrush x:Key="BrushBrandSubtle" Color="{StaticResource ColorBrandSubtle}"/>
    <SolidColorBrush x:Key="BrushBrandMinimal" Color="{StaticResource ColorBrandMinimal}"/>
    <SolidColorBrush x:Key="BrushBrandFocusRing" Color="{StaticResource ColorBrandFocusRing}"/>

    <!-- Accent Compatibility Brushes -->
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource ColorBrandMinimal}"/>

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="{StaticResource ColorTextOnAccent}"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="{StaticResource ColorTextOnDark}"/>

    <!-- Semantic Status Brushes -->
    <SolidColorBrush x:Key="BrushStatusSafe" Color="{StaticResource ColorStatusSafe}"/>
    <SolidColorBrush x:Key="BrushStatusSafeDark" Color="{StaticResource ColorStatusSafeDark}"/>
    <SolidColorBrush x:Key="BrushStatusSafeBg" Color="{StaticResource ColorStatusSafeBg}"/>
    <SolidColorBrush x:Key="BrushStatusSafeBorder" Color="{StaticResource ColorStatusSafeBorder}"/>
    <SolidColorBrush x:Key="BrushStatusSafeText" Color="{StaticResource ColorStatusSafeText}"/>

    <SolidColorBrush x:Key="BrushStatusWarning" Color="{StaticResource ColorStatusWarning}"/>
    <SolidColorBrush x:Key="BrushStatusWarningDark" Color="{StaticResource ColorStatusWarningDark}"/>
    <SolidColorBrush x:Key="BrushStatusWarningBg" Color="{StaticResource ColorStatusWarningBg}"/>
    <SolidColorBrush x:Key="BrushStatusWarningBorder" Color="{StaticResource ColorStatusWarningBorder}"/>
    <SolidColorBrush x:Key="BrushStatusWarningText" Color="{StaticResource ColorStatusWarningText}"/>

    <SolidColorBrush x:Key="BrushStatusDanger" Color="{StaticResource ColorStatusDanger}"/>
    <SolidColorBrush x:Key="BrushStatusDangerDark" Color="{StaticResource ColorStatusDangerDark}"/>
    <SolidColorBrush x:Key="BrushStatusDangerBg" Color="{StaticResource ColorStatusDangerBg}"/>
    <SolidColorBrush x:Key="BrushStatusDangerBorder" Color="{StaticResource ColorStatusDangerBorder}"/>
    <SolidColorBrush x:Key="BrushStatusDangerText" Color="{StaticResource ColorStatusDangerText}"/>

    <SolidColorBrush x:Key="BrushStatusInfo" Color="{StaticResource ColorStatusInfo}"/>
    <SolidColorBrush x:Key="BrushStatusInfoDark" Color="{StaticResource ColorStatusInfoDark}"/>
    <SolidColorBrush x:Key="BrushStatusInfoBg" Color="{StaticResource ColorStatusInfoBg}"/>
    <SolidColorBrush x:Key="BrushStatusInfoBorder" Color="{StaticResource ColorStatusInfoBorder}"/>
    <SolidColorBrush x:Key="BrushStatusInfoText" Color="{StaticResource ColorStatusInfoText}"/>

    <SolidColorBrush x:Key="BrushStatusPurple" Color="{StaticResource ColorStatusPurple}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleDark" Color="{StaticResource ColorStatusPurpleDark}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleBg" Color="{StaticResource ColorStatusPurpleBg}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleBorder" Color="{StaticResource ColorStatusPurpleBorder}"/>
    <SolidColorBrush x:Key="BrushStatusPurpleText" Color="{StaticResource ColorStatusPurpleText}"/>

    <!-- Compatibility Status Brushes -->
    <SolidColorBrush x:Key="BrushStatusGreen" Color="{StaticResource ColorStatusSafe}"/>
    <SolidColorBrush x:Key="BrushStatusAmber" Color="{StaticResource ColorStatusWarning}"/>
    <SolidColorBrush x:Key="BrushStatusRed" Color="{StaticResource ColorStatusDanger}"/>
    <SolidColorBrush x:Key="BrushStatusBlue" Color="{StaticResource ColorStatusInfo}"/>

    <!-- ── 5. TITLEBAR HIGH CONTRAST BRUSHES (LIGHT) ── -->
    <SolidColorBrush x:Key="TitleBarButtonForeground" Color="#1B2532"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverForeground" Color="#1B2532"/>
    <SolidColorBrush x:Key="TitleBarButtonPointerOverBackground" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="#1B2532"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverBackground" Color="#C41E1E"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPointerOverForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedBackground" Color="#B31818"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedForeground" Color="#FFFFFF"/>

    <!-- ── 6. WPF-UI NATIVE CONTROL TOKEN BRIDGE (LIGHT) ── -->
    <SolidColorBrush x:Key="CardBackgroundSolidColorBrush" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="CardBorderSolidColorBrush" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource ColorBrandPressed}"/>

    <!-- NavigationView Control Brushes (Light Mode Bitdefender Selection) -->
    <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource ColorSidebarBg}"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ColorAppBg}"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="{StaticResource ColorAppBg}"/>
    <!-- The shell keeps a dark sidebar in both themes. Native selected/hover
         states must use that palette too, not pale main-content selection colors. -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#DDE0E4"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#DDE0E4"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#34383D"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#3B3F45"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#3B3F45"/>
    <SolidColorBrush x:Key="NavigationViewItemSelectedBackground" Color="#3B3F45"/>

    <!-- ── 7. CODEX CLOUD TERMINAL LOGO TOKENS (LIGHT - SIMSİYAH) ── -->
    <BitmapImage x:Key="ImageCloudLogoBase" UriSource="pack://application:,,,/UltronDefender;component/Resources/Images/codex_cloud_base_black.png"/>
    <BitmapImage x:Key="ImageCloudCursorLine" UriSource="pack://application:,,,/UltronDefender;component/Resources/Images/codex_cursor_line_black.png"/>
    <Color x:Key="ColorCloudGlow">#00000000</Color>
    <Color x:Key="ColorCloudCursorGlow">#00000000</Color>
    <SolidColorBrush x:Key="BrushCloudAura" Color="Transparent"/>
    <SolidColorBrush x:Key="BrushCloudLogo" Color="#000000"/>
    <SolidColorBrush x:Key="BrushCloudCursor" Color="#000000"/>

    <!-- Bright red robot accent for the light canvas. -->
    <SolidColorBrush x:Key="BrushRobotBody" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrushRobotFace" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushRobotDetail" Color="#FECACA"/>
    <SolidColorBrush x:Key="BrushRobotHover" Color="#19EF4444"/>

    <!-- ── 8. SCROLLBAR TOKENS (LIGHT) ── -->
    <Color x:Key="ColorScrollThumb">#CBD5E1</Color>
    <Color x:Key="ColorScrollThumbHover">#94A3B8</Color>
    <Color x:Key="ColorScrollThumbActive">#64748B</Color>
    <SolidColorBrush x:Key="BrushScrollThumb" Color="{StaticResource ColorScrollThumb}"/>
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="{StaticResource ColorScrollThumbHover}"/>
    <SolidColorBrush x:Key="BrushScrollThumbActive" Color="{StaticResource ColorScrollThumbActive}"/>

    <!-- Keep native navigation accents aligned with the Ultron brand. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource ColorBrandHover}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource ColorBrandPressed}"/>
</ResourceDictionary>
