<UserControl x:Class="AegisPC.App.Controls.ClassicScanSurface" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:AegisPC.App.Helpers" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <UserControl.Resources>
  <Style x:Key="Detail" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource BrushCardBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Icon" TargetType="Path"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource BrushTextPrimary}"/><Setter Property="StrokeThickness" Value="1.6"/><Setter Property="Margin" Value="0,2,14,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style x:Key="Choice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Ellipse x:Name="Ring" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.6"/>
     <Ellipse x:Name="Dot" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Fill="{DynamicResource BrushBrandPrimary}" Visibility="Collapsed"/>
     <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushBrandPrimary}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="StrokeThickness" Value="3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/><Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushTextPrimary}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="Normal"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,16"><WrapPanel>
    <Button Content="Tarayıcı" Command="{Binding OpenActiveScanWindowCommand}" Style="{StaticResource Tab}" FontWeight="SemiBold" BorderBrush="{DynamicResource BrushBrandPrimary}"/>
    <Button Content="Zamanlayıcı" Command="{Binding OpenSchedulerCommand}" Style="{StaticResource Tab}"/>
    <Button Content="Raporlar" Command="{Binding OpenReportsCommand}" Style="{StaticResource Tab}"/>
   </WrapPanel></Border>
   <TextBlock Text="Tarayıcı" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
   <TextBlock Text="Tarama türünü seçin." Style="{StaticResource Detail}" FontSize="16" Margin="0,0,0,16"/>
  </StackPanel>
  <ScrollViewer x:Name="ContentScroll" Grid.Row="1" helpers:WheelScrollHelper.EnableRootRedirect="True" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,4,0">
    <Grid x:Name="ChoiceGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChoiceColumn" Width="1.35*"/><ColumnDefinition x:Name="ScopeColumn" Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="SelectionPanel" Style="{StaticResource Card}" Margin="0,0,8,0" IsEnabled="{Binding IsNotScanning}"><StackPanel>
      <RadioButton x:Name="QuickChoice" Tag="Quick" IsChecked="True" Checked="OnChoiceChecked" Style="{StaticResource Choice}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="M14,0 L3,14 L11,14 L7,26 L23,9 L14,9 Z"/><TextBlock Text="Hızlı tarama" Style="{StaticResource Heading}"/></StackPanel></RadioButton>
      <TextBlock Text="İndirilenler ve başlangıç konumları" Style="{StaticResource Detail}" Margin="72,4,0,24"/>
      <RadioButton x:Name="FullChoice" Tag="Full" Checked="OnChoiceChecked" Style="{StaticResource Choice}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="M5,0 L24,0 L29,20 L0,20 Z M0,20 L0,28 L29,28 L29,20 M5,24 L7,24 M22,24 L24,24"/><TextBlock Text="Tam tarama" Style="{StaticResource Heading}"/></StackPanel></RadioButton>
      <TextBlock Text="Yerel diskler ve desteklenen arşivler" Style="{StaticResource Detail}" Margin="72,4,0,24"/>
      <RadioButton x:Name="CustomChoice" Tag="Custom" Checked="OnChoiceChecked" Style="{StaticResource Choice}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="M0,5 L0,0 L10,0 L14,5 L28,5 L28,24 L0,24 Z"/><TextBlock Text="Özel tarama" Style="{StaticResource Heading}"/></StackPanel></RadioButton>
      <TextBlock Text="Seçilen dosya veya klasör" Style="{StaticResource Detail}" Margin="72,4,0,22"/>
      <Grid x:Name="ActionGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Button x:Name="StartSelectedButton" Content="Taramayı başlat" Style="{StaticResource Action}" Background="{DynamicResource BrushBrandPrimary}" Foreground="{DynamicResource BrushTextOnAccent}" BorderThickness="0" Margin="0,0,10,0"/>
       <Button x:Name="FolderPickerButton" Grid.Column="1" Content="Klasör seç" Click="OnFolderPickerClicked" Command="{Binding SelectCustomFolderCommand}" Style="{StaticResource Action}"/>
      </Grid>
      <TextBlock Text="{Binding SelectedCustomFolder}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCustomFolder}" MaxHeight="20" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <Border x:Name="ScopePanel" Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Kapsam" Style="{StaticResource Heading}" FontSize="20"/><Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,14,0,16"/>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Style="{StaticResource Icon}" Data="M12,0 L12,16 M5,9 L12,16 L19,9 M0,18 L0,25 L24,25 L24,18"/><StackPanel Grid.Column="1"><TextBlock x:Name="ScopeTitle" Text="İndirilenler" Style="{StaticResource Heading}" FontSize="16"/><TextBlock x:Name="ScopeDescription" Text="Son 7 günde eklenen veya değişen indirme, masaüstü ve geçici dosyalar incelenir." Style="{StaticResource Detail}" Margin="0,4,0,0"/></StackPanel></Grid>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Style="{StaticResource Icon}" Data="M12,0 L15,6 L21,7 L24,12 L21,17 L15,18 L12,24 L9,18 L3,17 L0,12 L3,7 L9,6 Z M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12"/><StackPanel Grid.Column="1"><TextBlock x:Name="SecondaryScopeTitle" Text="Başlangıç konumları" Style="{StaticResource Heading}" FontSize="16"/><TextBlock x:Name="SecondaryScopeDescription" Text="Aktif program/modül dosyaları ve başlangıç hedefleri incelenir; süreç belleği taranmaz." Style="{StaticResource Detail}" Margin="0,4,0,0"/></StackPanel></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Style="{StaticResource Icon}" Data="M0,5 C0,-2 24,-2 24,5 C24,12 0,12 0,5 L0,21 C0,28 24,28 24,21 L24,5 M0,13 C0,20 24,20 24,13"/><StackPanel Grid.Column="1"><TextBlock Text="Arşiv incelemesi" Style="{StaticResource Heading}" FontSize="16"/><TextBlock Text="Desteklenen içerik incelenir. Şifreli veya çözülemeyen öğeler raporda belirtilir." Style="{StaticResource Detail}" Margin="0,4,0,0"/></StackPanel></Grid>
     </StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"><StackPanel>
     <TextBlock Text="Tarama geçmişi" Style="{StaticResource Heading}" FontSize="19"/>
     <TextBlock Text="{Binding ReportHistoryStatus}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportHistoryStatus}" Margin="0,6,0,10"/>
     <Grid>
      <DataGrid x:Name="HistoryTable" ItemsSource="{Binding ReportHistory}" SelectedItem="{Binding SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" MinColumnWidth="20" Height="112" FontSize="12" Background="{DynamicResource BrushCardBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushCardBorder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource BrushCardBgAlt}"/><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/><Setter Property="Padding" Value="8,10"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource BrushCardBg}"/><Setter Property="ToolTip" Value="{Binding Summary}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrushBrandSubtle}"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="HistoryText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="8,9"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
       </DataGrid.Resources>
       <DataGrid.Columns>
        <DataGridTextColumn Header="Tarih ve saat" Binding="{Binding DateText}" Width="1.4*" ElementStyle="{StaticResource HistoryText}"/>
        <DataGridTextColumn Header="Tarama türü" Binding="{Binding ScanTypeText}" Width="*" ElementStyle="{StaticResource HistoryText}"/>
        <DataGridTextColumn x:Name="TargetColumn" Header="Hedef" Binding="{Binding TargetText}" Width="1.2*" ElementStyle="{StaticResource HistoryText}"/>
        <DataGridTextColumn Header="Sonuç" Binding="{Binding StatusText}" Width="*" ElementStyle="{StaticResource HistoryText}"/>
        <DataGridTextColumn Header="Süre" Binding="{Binding DurationText}" Width="0.8*" ElementStyle="{StaticResource HistoryText}"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Henüz tarama kaydı yok." FontSize="14" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,25,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReportHistoryEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <WrapPanel Margin="0,8,0,0"><Button Content="Geçmişi yenile" Command="{Binding RefreshReportsCommand}" Style="{StaticResource Tab}" FontSize="12" Padding="4,3"/><Button Content="Raporları aç" Command="{Binding OpenReportsCommand}" Style="{StaticResource Tab}" FontSize="12" Padding="12,3"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
