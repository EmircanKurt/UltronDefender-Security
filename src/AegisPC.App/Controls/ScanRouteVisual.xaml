                        <Canvas.RenderTransform><TranslateTransform x:Name="CarTranslation"/></Canvas.RenderTransform>
                        <Path Stroke="{DynamicResource BrushTextPrimary}" Fill="{DynamicResource BrushAppBg}" StrokeThickness="1.3" Data="M 0,0 L 13,0 L 22,10 L 22,30 L 0,30 Z M 13,0 L 13,10 L 22,10 M 5,16 L 17,16 M 5,22 L 17,22"/>
                    </Canvas>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="MotionLabel" Text="Dosya rotası" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
