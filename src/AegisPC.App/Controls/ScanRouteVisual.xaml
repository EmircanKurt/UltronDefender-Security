                    <TextBlock Text="İçerik" Canvas.Left="154" Canvas.Top="24" FontSize="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="Sonuç" Canvas.Left="275" Canvas.Top="24" FontSize="16" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <Path Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.6" Data="M 38,58 L 57,58 L 68,70 L 68,98 L 38,98 Z M 57,58 L 57,70 L 68,70 M 43,77 L 62,77 M 43,84 L 62,84 M 43,91 L 58,91 M 163,58 L 182,58 L 193,70 L 193,98 L 163,98 Z M 182,58 L 182,70 L 193,70 M 168,77 L 187,77 M 168,84 L 187,84 M 168,91 L 183,91 M 288,58 L 307,58 L 318,70 L 318,98 L 288,98 Z M 307,58 L 307,70 L 318,70 M 293,77 L 312,77 M 293,84 L 312,84 M 293,91 L 308,91"/>
