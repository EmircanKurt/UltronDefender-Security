                    <Ellipse Canvas.Left="47" Canvas.Top="114" Width="12" Height="12" Fill="{DynamicResource BrushAppBg}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5"/>
                    <Ellipse Canvas.Left="172" Canvas.Top="114" Width="12" Height="12" Fill="{DynamicResource BrushAppBg}" Stroke="{DynamicResource BrushBrandPrimary}" StrokeThickness="1.5"/>
                    <Ellipse Canvas.Left="297" Canvas.Top="114" Width="12" Height="12" Fill="{DynamicResource BrushAppBg}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5"/>
                    <Rectangle Canvas.Left="163" Canvas.Top="69" Width="30" Height="128" Fill="{DynamicResource BrushBrandPrimary}" Opacity="0.10"/>
                    <Path Stroke="{DynamicResource BrushBrandPrimary}" StrokeThickness="2.4" Data="M 152,67 L 152,54 L 164,54 M 193,54 L 205,54 L 205,67 M 152,91 L 152,104 L 164,104 M 193,104 L 205,104 L 205,91"/>
                    <!-- Compact top-view car; no external brand or fabricated result tick. -->
                    <Path Fill="#EEEEF0" Stroke="#BFC3C8" StrokeThickness="1.3" Data="M 178,148 C 161,148 164,160 163,172 L 163,213 C 163,225 170,230 178,230 C 186,230 193,225 193,213 L 193,172 C 192,160 195,148 178,148 Z"/>
                    <Path Fill="#262B30" Stroke="#BFC3C8" StrokeThickness="1" Data="M 168,166 Q 178,158 188,166 L 185,178 L 171,178 Z M 171,200 L 185,200 L 188,214 Q 178,219 168,214 Z M 164,175 L 169,180 L 169,199 L 164,207 Z M 192,175 L 187,180 L 187,199 L 192,207 Z"/>
                    <Path Stroke="#AEB4BB" StrokeThickness="1" Data="M 170,181 L 186,181 L 186,198 L 170,198 Z M 162,171 L 158,174 M 194,171 L 198,174"/>
                    <Path Stroke="{DynamicResource BrushBrandPrimary}" StrokeThickness="1.5" Data="M 166,222 L 173,224 M 183,224 L 190,222"/>
                    <Path Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.3" Data="M 22,171 L 32,171 L 38,178 L 38,193 L 22,193 Z M 32,171 L 32,178 L 38,178 M 50,171 L 60,171 L 66,178 L 66,193 L 50,193 Z M 60,171 L 60,178 L 66,178 M 78,171 L 88,171 L 94,178 L 94,193 L 78,193 Z M 88,171 L 88,178 L 94,178"/>
