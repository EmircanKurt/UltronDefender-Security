<Window x:Class="AegisPC.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ultron Defender Kaldırma Sihirbazı" 
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A0F1D" CornerRadius="10" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="#1E293B" Margin="0,0,14,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldDismiss24" Foreground="#EF4444" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ultron Defender Total Security" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Program Kaldırma ve Sistem Temizleme Sihirbazı" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Step 1: Confirmation -->
            <StackPanel x:Name="StepConfirmation" Visibility="Visible">
                <TextBlock Text="Ultron Defender'ı Kaldırmak İstediğinize Emin Misiniz?" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock Text="Kaldırma işlemi başlatıldığında gerçek zamanlı koruma ve arka plan kalkanları sonlandırılacaktır." FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="ChkCleanShortcuts" Content="Masaüstü ve Başlat Menüsü kısayollarını kaldır" IsChecked="True" FontSize="12.5" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkCleanQuarantine" Content="Karantina Kasası ve ayar kalıntılarını tamamen temizle" IsChecked="True" FontSize="12.5" FontWeight="SemiBold" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2: Progress -->
            <StackPanel x:Name="StepProgress" Visibility="Collapsed" VerticalAlignment="Center" Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="Kaldırma işlemi hazırlanıyor..." FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar x:Name="PrgBar" Height="10" IsIndeterminate="True" Margin="0,0,0,16"/>
                <TextBlock Text="Lütfen birkaç saniye bekleyin..." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Step 3: Warm Farewell Message (Veda Ekranı) -->
            <Border x:Name="StepFarewell" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Heart24" Foreground="#10B981" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ultron Defender Başarıyla Kaldırıldı" FontSize="16" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Sisteminizi koruma görevini bize emanet ettiğiniz için teşekkür ederiz. Umarız memnun kalmışsınızdır." FontSize="12.5" Foreground="#15803D" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Bilgisayarınızın her zaman güvende kalması dileğiyle... İstediğiniz zaman tekrar aramıza katılabilirsiniz. Hoşça kalın! 🛡️💙" FontSize="12" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel x:Name="PnlButtonsStep1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Visible">
                <Button Content="Vazgeç" Width="100" Height="34" Margin="0,0,12,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Click="OnCancelClick" Cursor="Hand"/>
                <Button Content="Kaldır (Uninstall)" Width="130" Height="34" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnUninstallClick" Cursor="Hand"/>
            </StackPanel>

            <StackPanel x:Name="PnlButtonsStep3" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Content="Kapat" Width="100" Height="34" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="OnCloseClick" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>