<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IncludeGuiTests Condition="'$(IncludeGuiTests)' == ''">true</IncludeGuiTests>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <ProjectReference Include="../../tools/Ultron.PortableInspection/Ultron.PortableInspection.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeGuiTests)' == 'true'">
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <ProjectReference Include="../../tools/Ultron.Linux.App/Ultron.Linux.App.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeGuiTests)' != 'true'">
    <Compile Remove="GraphicalShellTests.cs" />
    <Compile Remove="ManagedRuleSnapshotTests.cs" />
  </ItemGroup>
</Project>
